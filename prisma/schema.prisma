generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Technical integration state per external entity.
/// Tracks whether the locally stored version is up to date with the remote one.
model IntegrationEntityState {
  id                         String    @id @default(cuid())
  source                     String
  entityType                 String
  externalId                 String
  remoteModifiedAt           DateTime
  lastSyncedRemoteModifiedAt DateTime?
  needsSync                  Boolean   @default(true)
  lastSeenAt                 DateTime
  lastDetailFetchedAt        DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@unique([source, entityType, externalId])
  @@index([source, entityType, needsSync])
  @@index([source, entityType, needsSync, remoteModifiedAt])
}

/// Immutable RAW payload snapshot of an external entity version.
model IntegrationSnapshot {
  id                     String    @id @default(cuid())
  source                 String
  entityType             String
  externalId             String
  remoteModifiedAt       DateTime
  payload                Json
  fetchedAt              DateTime
  normalizedAt           DateTime?
  normalizationVersion   Int       @default(0)
  normalizationErrorCode String?
  createdAt              DateTime  @default(now())

  @@unique([source, entityType, externalId, remoteModifiedAt])
  @@index([source, entityType, externalId])
  @@index([source, entityType, normalizationVersion])
}

/// Technical metadata about a single synchronization execution.
/// Never stores payloads, tokens or personal information.
model IntegrationSyncRun {
  id             String    @id @default(cuid())
  source         String
  entityType     String
  mode           String
  status         String
  startedAt      DateTime
  completedAt    DateTime?
  pagesScanned   Int       @default(0)
  recordsSeen    Int       @default(0)
  recordsPending Int       @default(0)
  detailsFetched Int       @default(0)
  detailsFailed  Int       @default(0)
  apiCalls       Int       @default(0)
  errorCode      String?
  createdAt      DateTime  @default(now())

  @@index([source, entityType, startedAt])
}

/// Configurable runtime parameters for one integration source.
/// Stored as JSON so each integration can extend its own settings without
/// migrating the schema. Updated from the admin UI; read by the scheduler
/// and sync workers on every tick so changes apply immediately.
model IntegrationConfig {
  id          String   @id @default(cuid())
  source      String   @unique
  displayName String
  isEnabled   Boolean  @default(true)
  /// Free-form JSON bag: intervals, timeouts, maxDetailFetches, quotas, etc.
  settings    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// One row per outbound API call made to any integration.
/// Captures method, path, status, duration, error and a truncated preview
/// of the response payload for observability. Never stores auth tokens.
model IntegrationApiCall {
  id              String   @id @default(cuid())
  source          String
  method          String
  path            String
  httpStatus      Int?
  durationMs      Int
  success         Boolean
  errorCode       String?
  /// Truncated preview of the response body (max ~4KB) for debugging.
  responsePreview String?
  createdAt       DateTime @default(now())

  @@index([source, createdAt])
  @@index([source, success, createdAt])
}

/// Business-normalized view of a Zoho sales order.
model SalesOrder {
  id                     String           @id @default(cuid())
  zohoSalesOrderId       String           @unique
  salesOrderNumber       String?
  referenceNumber        String?
  orderDate              DateTime?        @db.Date
  createdTime            DateTime?
  status                 String?
  subStatus              String?
  paidStatus             String?
  invoicedStatus         String?
  shippedStatus          String?
  zohoCustomerId         String?
  customerName           String?
  customerEmail          String?
  customerPhone          String?
  zohoSalespersonId      String?
  salespersonName        String?
  paymentMethod          String?
  deliveryMethod         String?
  deliveryMethodId       String?
  locationId             String?
  locationName           String?
  branchId               String?
  branchName             String?
  shippingAttention      String?
  shippingAddressLine1   String?
  shippingAddressLine2   String?
  shippingCity           String?
  shippingState          String?
  shippingPostalCode     String?
  shippingCountry        String?
  shippingPhone          String?
  currencyCode           String?
  subtotal               Decimal?         @db.Decimal(18, 4)
  discountTotal          Decimal?         @db.Decimal(18, 4)
  taxTotal               Decimal?         @db.Decimal(18, 4)
  shippingCharge         Decimal?         @db.Decimal(18, 4)
  adjustment             Decimal?         @db.Decimal(18, 4)
  total                  Decimal?         @db.Decimal(18, 4)
  balance                Decimal?         @db.Decimal(18, 4)
  notes                  String?
  saleMadeInWarehouse    Boolean?
  sourceRemoteModifiedAt DateTime
  sourceSnapshotId       String
  normalizedAt           DateTime         @default(now())
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  items                  SalesOrderItem[]

  @@index([salesOrderNumber])
  @@index([status])
  @@index([customerName])
  @@index([paymentMethod])
  @@index([deliveryMethod])
  @@index([salespersonName])
  @@index([orderDate])
  @@index([locationName])
  @@index([sourceSnapshotId])
}

/// Application user account. Users are never hard-deleted from the UI;
/// they are activated/deactivated to preserve history and relations.
model User {
  id                   String                               @id @default(cuid())
  username             String                               @unique
  email                String?                              @unique
  name                 String
  passwordHash         String
  isActive             Boolean                              @default(true)
  mustChangePassword   Boolean                              @default(true)
  failedLoginAttempts  Int                                  @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  passwordChangedAt    DateTime?
  /// Usuario-bot de la capa de agentes (no puede iniciar sesión)
  isBot                Boolean                              @default(false)
  /// area | admin (sólo si isBot)
  botKind              String?
  createdAt            DateTime                             @default(now())
  updatedAt            DateTime                             @updatedAt
  roles                UserRole[]
  sessions             AuthSession[]
  tablePreferences     UserTablePreference[]
  tableViews           TableView[]
  entityWatches        EntityWatch[]
  notifications        Notification[]
  pushSubscriptions    PushSubscription[]
  notificationSettings UserNotificationSettings?
  aiConversations      AiConversation[]
  chatMemberships      InternalChatMember[]
  chatMessages         InternalChatMessage[]
  chatReactions        InternalChatReaction[]
  chatReadReceipts     InternalChatReadReceipt[]
  chatPresence         InternalChatPresence?
  chatMentions         InternalChatMention[]
  chatPollVotes        InternalChatPollVote[]
  chatEventRsvps       InternalChatEventRsvp[]
  chatPins             InternalChatPinnedMessage[]
  chatBookmarks        InternalChatBookmark[]
  chatSnippets         InternalChatSnippet[]
  chatScheduledMsgs    InternalChatScheduledMessage[]
  chatNotifPrefs       InternalChatNotificationPreference[]
  chatCallParticipants InternalChatCallParticipant[]
  chatCallsInitiated   InternalChatCall[]

  @@index([isActive])
}

/// Authorization role. `key` is generated at creation time and is immutable.
model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(false)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]
}

/// Join table between User and Role.
model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

/// Permission assigned to a role. permissionKey references the code-first
/// permission registry (src/modules/auth/permissions.ts); it is validated
/// against that registry before being persisted.
model RolePermission {
  roleId        String
  permissionKey String
  createdAt     DateTime @default(now())
  role          Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
}

/// Server-side authentication session. Only the SHA-256 hash of the session
/// token is stored; the raw token lives exclusively in the HttpOnly cookie.
model AuthSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

/// Generic audit log for administrative and security events.
/// Never stores passwords, hashes, session tokens or cookies.
model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  targetType  String
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([createdAt])
  @@index([action])
}

/// Business-normalized line items of a Zoho sales order.
model SalesOrderItem {
  id             String     @id @default(cuid())
  salesOrderId   String
  zohoLineItemId String?
  zohoItemId     String?
  sku            String?
  name           String?
  description    String?
  quantity       Decimal?   @db.Decimal(18, 4)
  unit           String?
  rate           Decimal?   @db.Decimal(18, 4)
  discountAmount Decimal?   @db.Decimal(18, 4)
  taxName        String?
  taxPercentage  Decimal?   @db.Decimal(18, 4)
  taxAmount      Decimal?   @db.Decimal(18, 4)
  lineTotal      Decimal?   @db.Decimal(18, 4)
  locationId     String?
  locationName   String?
  sortOrder      Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  salesOrder     SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([salesOrderId])
}

/// Business-normalized view of a Zoho contact (customer or vendor).
/// A single Zoho /contacts resource with contact_type=customer|vendor.
/// One Prisma model, one sync pipeline, two UI modules that filter by contactType.
model Contact {
  id                        String   @id @default(cuid())
  zohoContactId             String   @unique
  contactType               String?
  contactName               String?
  companyName               String?
  currencyCode              String?
  paymentTerms              Int?
  paymentTermsLabel         String?
  status                    String?
  outstandingReceivable     Decimal? @db.Decimal(18, 4)
  outstandingPayable        Decimal? @db.Decimal(18, 4)
  unusedCreditsReceivable   Decimal? @db.Decimal(18, 4)
  unusedCreditsPayable      Decimal? @db.Decimal(18, 4)
  primaryEmail              String?
  primaryPhone              String?
  website                   String?
  languageCode              String?
  // Mexico fiscal fields (normalized when present in payload)
  taxRegNo                  String?
  taxTreatment              String?
  taxRegime                 String?
  legalName                 String?
  isTdsRegistered           Boolean?
  // Address fields (from Zoho LIST payload)
  billingAddress            String?
  billingCity               String?
  billingState              String?
  billingZip                String?
  billingCountry            String?
  billingFax                String?
  shippingAddress           String?
  shippingCity              String?
  shippingState             String?
  shippingZip               String?
  shippingCountry           String?
  shippingFax               String?
  // Contact person fields
  firstName                 String?
  lastName                  String?
  mobile                    String?
  designation               String?
  department                String?
  // Additional Zoho fields
  customerSubType           String?
  portalStatus              String?
  ownerName                 String?
  source                    String?
  photoUrl                  String?
  primaryContactId          String?
  creditLimitExceededAmount Decimal? @db.Decimal(18, 4)
  notes                     String?
  // Sync tracking
  sourceRemoteModifiedAt    DateTime
  sourceSnapshotId          String
  normalizedAt              DateTime @default(now())
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([contactType])
  @@index([contactName])
  @@index([companyName])
  @@index([status])
  @@index([sourceSnapshotId])
}

/// Business-normalized view of a Zoho Inventory item (product).
/// Hydrated via bulk /itemdetails for efficiency.
model Product {
  id                       String    @id @default(cuid())
  zohoItemId               String    @unique
  name                     String?
  sku                      String?
  status                   String?
  productType              String?
  description              String?
  rate                     Decimal?  @db.Decimal(18, 4)
  unit                     String?
  currencyCode             String?
  taxName                  String?
  taxPercentage            Decimal?  @db.Decimal(18, 4)
  isTaxable                Boolean?
  stockOnHand              Decimal?  @db.Decimal(18, 4)
  availableStock           Decimal?  @db.Decimal(18, 4)
  reorderLevel             Decimal?  @db.Decimal(18, 4)
  purchaseRate             Decimal?  @db.Decimal(18, 4)
  categoryName             String?
  categoryId               String?
  manufacturer             String?
  brand                    String?
  zohoVendorId             String?
  vendorName               String?
  // Mexico fiscal / SAT fields (normalized when present in payload)
  satProductCode           String?
  satUnitCode              String?
  // Additional Zoho fields (already in snapshot via passthrough)
  itemType                 String?
  source                   String?
  taxPreference            String?
  purchaseTaxName          String?
  purchaseAccountName      String?
  salesAccountName         String?
  inventoryAccountName     String?
  inventoryValuationMethod String?
  zohoCreatedTime          DateTime?
  zohoLastModifiedTime     DateTime?
  // Sync tracking
  sourceRemoteModifiedAt   DateTime
  sourceSnapshotId         String
  normalizedAt             DateTime  @default(now())
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([name])
  @@index([sku])
  @@index([status])
  @@index([categoryName])
  @@index([sourceSnapshotId])
}

/// Business-normalized view of a Zoho Inventory package (shipment).
/// Preserves source traceability through raw snapshots.
model Package {
  id                     String        @id @default(cuid())
  zohoPackageId          String        @unique
  packageNumber          String?
  status                 String?
  date                   DateTime?
  shipmentType           String?
  carrier                String?
  trackingNumber         String?
  deliveryMethod         String?
  shippingCharge         Decimal?      @db.Decimal(18, 4)
  zohoSalesOrderId       String?
  zohoCustomerId         String?
  customerName           String?
  // Shipping address (from DETAIL fetch - lazy)
  shippingAttention      String?
  shippingAddress        String?
  shippingCity           String?
  shippingState          String?
  shippingZip            String?
  shippingCountry        String?
  shippingPhone          String?
  // Additional fields
  shipmentDate           DateTime?
  shipmentStatus         String?
  isCarrierShipment      Boolean?
  isTrackingEnabled      Boolean?
  labelFormat            String?
  salesChannel           String?
  salesorderNumber       String?
  quantity               Decimal?      @db.Decimal(18, 4)
  // Shipment order (Zoho "orden de envío", e.g. NE-28815) — carrier lives here once shipped
  zohoShipmentId         String?
  shipmentNumber         String?
  deliveryDate           DateTime?
  trackingUrl            String?
  notes                  String?
  // Detail fetch tracking
  lastDetailFetchedAt    DateTime?
  // Sync tracking
  sourceRemoteModifiedAt DateTime
  sourceSnapshotId       String
  normalizedAt           DateTime      @default(now())
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  items                  PackageItem[]

  @@index([status])
  @@index([zohoSalesOrderId])
  @@index([zohoCustomerId])
  @@index([sourceSnapshotId])
}

/// Business-normalized line items of a Zoho package.
model PackageItem {
  id          String   @id @default(cuid())
  packageId   String
  zohoItemId  String?
  name        String?
  sku         String?
  description String?
  quantity    Decimal? @db.Decimal(18, 4)
  unit        String?
  sortOrder   Int      @default(0)
  package     Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@index([zohoItemId])
}

/// Business-normalized view of a Zoho Inventory invoice.
/// Includes Mexican CFDI fields. Does NOT use sort_column=last_modified_time.
/// Invoice payments are invoice-scoped and lazy (not stored in V1).
model Invoice {
  id                     String        @id @default(cuid())
  zohoInvoiceId          String        @unique
  invoiceNumber          String?
  status                 String?
  date                   DateTime?
  dueDate                DateTime?
  zohoCustomerId         String?
  customerName           String?
  currencyCode           String?
  subTotal               Decimal?      @db.Decimal(18, 4)
  taxTotal               Decimal?      @db.Decimal(18, 4)
  discountTotal          Decimal?      @db.Decimal(18, 4)
  shippingCharge         Decimal?      @db.Decimal(18, 4)
  total                  Decimal?      @db.Decimal(18, 4)
  balance                Decimal?      @db.Decimal(18, 4)
  salespersonName        String?
  // Mexico CFDI fields (normalized when present in payload)
  cfdiUuid               String?
  cfdiVersion            String?
  usoCfdi                String?
  metodoPago             String?
  formaPago              String?
  regimenFiscal          String?
  cfdiExportacion        String?
  // Address fields (from LIST payload)
  billingAddress         String?
  billingCity            String?
  billingState           String?
  billingZip             String?
  billingCountry         String?
  shippingAddress        String?
  shippingCity           String?
  shippingState          String?
  shippingZip            String?
  shippingCountry        String?
  // Additional fields
  notes                  String?
  terms                  String?
  referenceNumber        String?
  exchangeRate           Decimal?      @db.Decimal(18, 6)
  discount               Decimal?      @db.Decimal(18, 4)
  discountType           String?
  isDiscountBeforeTax    Boolean?
  zohoCreatedTime        DateTime?
  zohoLastModifiedTime   DateTime?
  // Sync tracking
  sourceRemoteModifiedAt DateTime
  sourceSnapshotId       String
  normalizedAt           DateTime      @default(now())
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  items                  InvoiceItem[]

  @@index([status])
  @@index([zohoCustomerId])
  @@index([date])
  @@index([sourceSnapshotId])
}

/// Business-normalized line items of a Zoho invoice.
/// Links to Sales Orders via salesorder_item_id / salesorder_id.
model InvoiceItem {
  id                   String   @id @default(cuid())
  invoiceId            String
  zohoItemId           String?
  name                 String?
  description          String?
  quantity             Decimal? @db.Decimal(18, 4)
  rate                 Decimal? @db.Decimal(18, 4)
  unit                 String?
  lineTotal            Decimal? @db.Decimal(18, 4)
  taxName              String?
  taxPercentage        Decimal? @db.Decimal(18, 4)
  taxAmount            Decimal? @db.Decimal(18, 4)
  discountAmount       Decimal? @db.Decimal(18, 4)
  zohoSalesOrderId     String?
  zohoSalesOrderItemId String?
  sortOrder            Int      @default(0)
  invoice              Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([zohoItemId])
  @@index([zohoSalesOrderId])
}

/// Daily work digest per user: what they did with UNIK (AI, inbox, chat, sales),
/// KPIs and a narrative the assistant can recall ("¿cómo voy hoy?").
model AiUserDigest {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  narrative String
  metrics   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([date])
}

/// Business-normalized view of a Zoho Books estimate (cotización).
/// Synced via /books/v3/estimates (LIST has no line items → HYDRATE per record).
/// Quotes can also be CREATED/EDITED from UNIK: the write service calls Zoho
/// first, stores the Zoho response as an IntegrationSnapshot and runs the same
/// normalizer, so Zoho is always the source of truth (folios, totals, taxes).
model Quote {
  id                     String      @id @default(cuid())
  zohoEstimateId         String      @unique
  estimateNumber         String?
  referenceNumber        String?
  status                 String?
  date                   DateTime?
  expiryDate             DateTime?
  zohoCustomerId         String?
  customerName           String?
  currencyId             String?
  currencyCode           String?
  exchangeRate           Decimal?    @db.Decimal(18, 6)
  subTotal               Decimal?    @db.Decimal(18, 4)
  taxTotal               Decimal?    @db.Decimal(18, 4)
  discountTotal          Decimal?    @db.Decimal(18, 4)
  discount               Decimal?    @db.Decimal(18, 4)
  discountType           String?
  isDiscountBeforeTax    Boolean?
  isInclusiveTax         Boolean?
  shippingCharge         Decimal?    @db.Decimal(18, 4)
  adjustment             Decimal?    @db.Decimal(18, 4)
  adjustmentDescription  String?
  total                  Decimal?    @db.Decimal(18, 4)
  salespersonId          String?
  salespersonName        String?
  templateId             String?
  templateName           String?
  // Address fields
  billingAddress         String?
  billingStreet2         String?
  billingCity            String?
  billingState           String?
  billingZip             String?
  billingCountry         String?
  shippingAddress        String?
  shippingStreet2        String?
  shippingCity           String?
  shippingState          String?
  shippingZip            String?
  shippingCountry        String?
  // Additional fields
  notes                  String?
  terms                  String?
  customFields           Json?
  isViewedByClient       Boolean?
  acceptedDate           DateTime?
  declinedDate           DateTime?
  zohoCreatedTime        DateTime?
  zohoLastModifiedTime   DateTime?
  // UNIK authorship (null when the quote was created directly in Zoho)
  createdInUnik          Boolean     @default(false)
  createdByUserId        String?
  lastEditedByUserId     String?
  lastEditedInUnikAt     DateTime?
  // Sync tracking
  sourceRemoteModifiedAt DateTime
  sourceSnapshotId       String
  normalizedAt           DateTime    @default(now())
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  items                  QuoteItem[]

  @@index([status])
  @@index([zohoCustomerId])
  @@index([date])
  @@index([expiryDate])
  @@index([estimateNumber])
  @@index([sourceSnapshotId])
}

/// Business-normalized line items of a Zoho Books estimate.
model QuoteItem {
  id             String   @id @default(cuid())
  quoteId        String
  zohoLineItemId String?
  zohoItemId     String?
  sku            String?
  name           String?
  description    String?
  quantity       Decimal? @db.Decimal(18, 4)
  rate           Decimal? @db.Decimal(18, 4)
  unit           String?
  discount       String?
  discountAmount Decimal? @db.Decimal(18, 4)
  taxId          String?
  taxName        String?
  taxPercentage  Decimal? @db.Decimal(18, 4)
  taxAmount      Decimal? @db.Decimal(18, 4)
  lineTotal      Decimal? @db.Decimal(18, 4)
  sortOrder      Int      @default(0)
  quote          Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@index([zohoItemId])
}

/// Idempotency ledger for quote writes that reach Zoho Books.
/// The client generates `requestKey` once per form submission. A retry (double
/// click, network timeout, page refresh) reuses the same key, so the write
/// service can return the already-created quote instead of creating a second
/// estimate in Zoho. Unique constraint = atomic guard against concurrent sends.
model QuoteWriteRequest {
  id             String    @id @default(cuid())
  requestKey     String    @unique
  operation      String
  userId         String
  quoteId        String?
  zohoEstimateId String?
  status         String    @default("pending")
  errorMessage   String?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// Business-normalized view of a Zoho customer payment.
/// Synced via /customerpayments with useListAsSnapshot.
model CustomerPayment {
  id                     String    @id @default(cuid())
  zohoPaymentId          String    @unique
  paymentNumber          String?
  paymentMode            String?
  status                 String?
  date                   DateTime?
  amount                 Decimal?  @db.Decimal(18, 4)
  balance                Decimal?  @db.Decimal(18, 4)
  zohoCustomerId         String?
  customerName           String?
  currencyCode           String?
  referenceNumber        String?
  description            String?
  exchangeRate           Decimal?  @db.Decimal(18, 6)
  bankCharges            Decimal?  @db.Decimal(18, 4)
  // Sync tracking
  sourceRemoteModifiedAt DateTime
  sourceSnapshotId       String
  normalizedAt           DateTime  @default(now())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([zohoCustomerId])
  @@index([date])
  @@index([status])
  @@index([sourceSnapshotId])
}

/// Business-normalized view of a Zoho purchase order.
model PurchaseOrder {
  id                     String              @id @default(cuid())
  zohoPurchaseOrderId    String              @unique
  purchaseOrderNumber    String?
  status                 String?
  date                   DateTime?
  dueDate                DateTime?
  deliveryDate           DateTime?
  zohoVendorId           String?
  vendorName             String?
  currencyCode           String?
  subTotal               Decimal?            @db.Decimal(18, 4)
  taxTotal               Decimal?            @db.Decimal(18, 4)
  discountTotal          Decimal?            @db.Decimal(18, 4)
  shippingCharge         Decimal?            @db.Decimal(18, 4)
  total                  Decimal?            @db.Decimal(18, 4)
  balance                Decimal?            @db.Decimal(18, 4)
  salespersonName        String?
  notes                  String?
  referenceNumber        String?
  // Sync tracking
  sourceRemoteModifiedAt DateTime
  sourceSnapshotId       String
  normalizedAt           DateTime            @default(now())
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  items                  PurchaseOrderItem[]

  @@index([status])
  @@index([zohoVendorId])
  @@index([date])
  @@index([sourceSnapshotId])
}

/// Business-normalized line items of a Zoho purchase order.
model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  zohoItemId      String?
  name            String?
  description     String?
  quantity        Decimal?      @db.Decimal(18, 4)
  rate            Decimal?      @db.Decimal(18, 4)
  unit            String?
  lineTotal       Decimal?      @db.Decimal(18, 4)
  taxName         String?
  taxPercentage   Decimal?      @db.Decimal(18, 4)
  taxAmount       Decimal?      @db.Decimal(18, 4)
  sortOrder       Int           @default(0)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@index([zohoItemId])
}

/// Business-normalized view of a Zoho bill (vendor invoice).
model Bill {
  id                     String    @id @default(cuid())
  zohoBillId             String    @unique
  billNumber             String?
  status                 String?
  date                   DateTime?
  dueDate                DateTime?
  zohoVendorId           String?
  vendorName             String?
  zohoPurchaseOrderId    String?
  currencyCode           String?
  subTotal               Decimal?  @db.Decimal(18, 4)
  taxTotal               Decimal?  @db.Decimal(18, 4)
  total                  Decimal?  @db.Decimal(18, 4)
  balance                Decimal?  @db.Decimal(18, 4)
  vendorCreditsApplied   Decimal?  @db.Decimal(18, 4)
  notes                  String?
  // Sync tracking
  sourceRemoteModifiedAt DateTime
  sourceSnapshotId       String
  normalizedAt           DateTime  @default(now())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([status])
  @@index([zohoVendorId])
  @@index([zohoPurchaseOrderId])
  @@index([date])
  @@index([sourceSnapshotId])
}

/// Business-normalized view of a Zoho vendor credit.
model VendorCredit {
  id                     String    @id @default(cuid())
  zohoVendorCreditId     String    @unique
  vendorCreditNumber     String?
  status                 String?
  date                   DateTime?
  zohoVendorId           String?
  vendorName             String?
  currencyCode           String?
  total                  Decimal?  @db.Decimal(18, 4)
  balance                Decimal?  @db.Decimal(18, 4)
  notes                  String?
  // Sync tracking
  sourceRemoteModifiedAt DateTime
  sourceSnapshotId       String
  normalizedAt           DateTime  @default(now())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([status])
  @@index([zohoVendorId])
  @@index([date])
  @@index([sourceSnapshotId])
}

/// Generic per-user table layout preferences (column order, visibility, widths,
/// pinning, density, page size). Reusable across modules via `tableKey`.
/// Source of persistence is PostgreSQL; localStorage may be used as UX cache.
model UserTablePreference {
  id        String   @id @default(cuid())
  userId    String
  tableKey  String
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tableKey])
  @@index([userId])
}

/// Generic saved table view. Combines query state (search, filters, sort) and
/// presentation state (columns, density, page size). `visibility` is either
/// "private" (owner only) or "shared" (any user with the module's view perm).
model TableView {
  id          String   @id @default(cuid())
  ownerUserId String
  tableKey    String
  name        String
  visibility  String   @default("private")
  config      Json
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId])
  @@index([tableKey, visibility])
}

/// Generic entity watch. Allows a user to follow an entity (e.g. a SalesOrder)
/// and receive notifications when it changes. `entityType` is a string key
/// (e.g. "sales_order"); `entityId` is the internal UNIK id.
model EntityWatch {
  id         String   @id @default(cuid())
  userId     String
  entityType String
  entityId   String
  config     Json?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([entityType, entityId, isActive])
}

/// Generic change event for a watched entity. Stores only the diff (before/after
/// per field). `sourceSnapshotId` is unique when present to guarantee
/// idempotency: one snapshot → at most one ChangeEvent.
model EntityChangeEvent {
  id                     String    @id @default(cuid())
  entityType             String
  entityId               String
  sourceSnapshotId       String?   @unique
  sourceRemoteModifiedAt DateTime?
  changes                Json
  createdAt              DateTime  @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([entityType, entityId])
}

/// Generic in-app notification. Created when an EntityChangeEvent matches an
/// active EntityWatch. `changeEventId` + `userId` form a logical uniqueness
/// constraint for idempotency (enforced in service layer).
model Notification {
  id            String    @id @default(cuid())
  userId        String
  type          String
  /// Preference bucket (see NOTIFICATION_CATEGORIES in src/modules/notifications/catalog.ts).
  category      String    @default("system")
  title         String
  body          String?
  /// In-app path opened when the notification (or its push) is tapped.
  url           String?
  entityType    String?
  entityId      String?
  changeEventId String?
  /// Optional idempotency key (e.g. "chat_message:{messageId}:{userId}").
  dedupeKey     String?   @unique
  metadata      Json?
  /// Push delivery state: pending | sent | skipped | failed. Rows created inside a
  /// transaction stay pending until the dispatcher picks them up after commit.
  pushStatus    String    @default("pending")
  pushedAt      DateTime?
  readAt        DateTime?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([userId, changeEventId])
  @@index([pushStatus, createdAt])
}

/// Web Push subscription of one browser/device (VAPID). A user has one row per
/// device; the endpoint is unique across users (a device re-login moves it).
model PushSubscription {
  id           String    @id @default(cuid())
  userId       String
  endpoint     String    @unique
  p256dh       String
  auth         String
  userAgent    String?
  /// ios | android | desktop | unknown (best effort, for the settings screen).
  platform     String    @default("unknown")
  failureCount Int       @default(0)
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Per-user notification configuration. `preferences` is a map
/// { [category]: { inApp: boolean, push: boolean } }; categories missing from the
/// map use the catalog defaults.
model UserNotificationSettings {
  userId          String    @id
  pushEnabled     Boolean   @default(true)
  /// Do-not-disturb window (local hour 0-23, in `timezone`). null = disabled.
  quietHoursStart Int?
  quietHoursEnd   Int?
  timezone        String    @default("America/Mexico_City")
  /// Temporary mute of every push (in-app rows are still created).
  mutedUntil      DateTime?
  preferences     Json      @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// =====================================================
// AI Assistant models (additive migration)
// =====================================================

/// Una conversación entre un usuario y el asistente IA.
model AiConversation {
  id                  String       @id @default(cuid())
  userId              String
  title               String       @default("Nueva conversación")
  context             Json?
  isStarred           Boolean      @default(false)
  /// Rolling summary of the thread (shared context across assistant + copilots).
  summary             String?
  summaryUpdatedAt    DateTime?
  summaryMessageCount Int          @default(0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages            AiMessage[]
  artifacts           AiArtifact[]

  @@index([userId, updatedAt])
  @@index([isStarred])
}

/// Un mensaje dentro de una conversación (user, assistant, o tool).
model AiMessage {
  id              String             @id @default(cuid())
  conversationId  String
  role            String
  content         String?
  toolCalls       Json?
  toolCallId      String?
  tokensIn        Int                @default(0)
  tokensOut       Int                @default(0)
  latencyMs       Int                @default(0)
  createdAt       DateTime           @default(now())
  conversation    AiConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  toolCallRecords AiToolCall[]
  attachments     AiAttachment[]
  artifacts       AiArtifact[]
  feedback        AiMessageFeedback?
  /// Turn metadata: model routing decision, confidence label, judge score, cache hits.
  meta            Json?

  @@index([conversationId, createdAt])
}

/// Explicit quality feedback (👍/👎) left by the conversation owner on an assistant message.
model AiMessageFeedback {
  id        String    @id @default(cuid())
  messageId String    @unique
  userId    String
  /// 1 = útil, -1 = no útil
  rating    Int
  comment   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  message   AiMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

/// Registro detallado de cada tool call ejecutado (para auditoría del admin).
model AiToolCall {
  id         String    @id @default(cuid())
  messageId  String
  toolName   String
  args       Json
  result     Json?
  durationMs Int       @default(0)
  success    Boolean   @default(true)
  errorCode  String?
  createdAt  DateTime  @default(now())
  message    AiMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([toolName])
  @@index([createdAt])
}

/// Llamada a Azure OpenAI registrada (para monitoreo de consumo del admin).
model AiApiCall {
  id               String   @id @default(cuid())
  userId           String?
  conversationId   String?
  deployment       String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  durationMs       Int      @default(0)
  success          Boolean  @default(true)
  errorCode        String?
  finishReason     String?
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([deployment])
}

/// Archivo adjunto por el usuario (documento o imagen).
model AiAttachment {
  id              String         @id @default(cuid())
  messageId       String?
  conversationId  String
  fileName        String
  mimeType        String
  sizeBytes       Int
  /// Legacy disk path. Null for objects stored through StorageObject.
  storagePath     String?
  /// Reference to the central object registry (R2 or migrated legacy file).
  storageObjectId String?
  uploadedBy      String
  createdAt       DateTime       @default(now())
  message         AiMessage?     @relation(fields: [messageId], references: [id], onDelete: SetNull)
  storageObject   StorageObject? @relation(fields: [storageObjectId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([messageId])
  @@index([storageObjectId])
}

/// Artifact generado por la IA (PDF, CSV, XLSX, imagen, tabla, markdown).
model AiArtifact {
  id              String         @id @default(cuid())
  conversationId  String
  messageId       String?
  type            String
  /// Legacy disk path. Null for objects stored through StorageObject.
  storagePath     String?
  /// Reference to the central object registry (R2 or migrated legacy file).
  storageObjectId String?
  inlineData      Json?
  meta            Json?
  createdAt       DateTime       @default(now())
  conversation    AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message         AiMessage?     @relation(fields: [messageId], references: [id], onDelete: SetNull)
  storageObject   StorageObject? @relation(fields: [storageObjectId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([messageId])
  @@index([type])
  @@index([storageObjectId])
}

/// Configuración persistida del asistente (editable desde el panel de admin).
model AiConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  isEnabled Boolean  @default(true)
  settings  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================================================
// Internal Chat models (additive migration)
// =====================================================

/// Canal de chat: mensaje directo (type='dm') o grupo (type='group').
model InternalChatChannel {
  id            String                   @id @default(cuid())
  type          String
  name          String?
  avatarPath    String?
  createdBy     String
  lastMessageAt DateTime                 @default(now())
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  members       InternalChatMember[]
  messages      InternalChatMessage[]
  events        InternalChatEvent[]
  tags          InternalChatChannelTag[]
  calls         InternalChatCall[]
  threads       InternalChatThread[]

  @@index([type])
  @@index([lastMessageAt])
  @@map("internal_chat_channel")
}

/// Membresía de un usuario en un canal de chat.
model InternalChatMember {
  id         String              @id @default(cuid())
  channelId  String
  userId     String
  role       String              @default("member")
  joinedAt   DateTime            @default(now())
  lastReadAt DateTime            @default(now())
  mutedUntil DateTime?
  leftAt     DateTime?
  channel    InternalChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
  @@index([channelId, leftAt])
  @@map("internal_chat_member")
}

/// Mensaje dentro de un canal de chat.
model InternalChatMessage {
  id              String                      @id @default(cuid())
  channelId       String
  senderId        String
  content         String?
  replyToId       String?
  forwardedFromId String?
  forwardedBy     String?
  editedAt        DateTime?
  deletedAt       DateTime?
  priority        String                      @default("normal") // "normal" | "urgent"
  threadId        String?
  /// Metadatos estructurados (p. ej. {kind:'agent_request', requestId, caseId, quickActions})
  meta            Json?
  createdAt       DateTime                    @default(now())
  channel         InternalChatChannel         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender          User                        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo         InternalChatMessage?        @relation("InternalChatMessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  forwardedFrom   InternalChatMessage?        @relation("InternalChatMessageForward", fields: [forwardedFromId], references: [id], onDelete: SetNull)
  replies         InternalChatMessage[]       @relation("InternalChatMessageReply")
  forwards        InternalChatMessage[]       @relation("InternalChatMessageForward")
  thread          InternalChatThread?         @relation("InternalChatThreadMessages", fields: [threadId], references: [id], onDelete: SetNull)
  threadRoot      InternalChatThread?         @relation("InternalChatThreadRoot")
  attachments     InternalChatAttachment[]
  reactions       InternalChatReaction[]
  readReceipts    InternalChatReadReceipt[]
  mentions        InternalChatMention[]
  location        InternalChatLocation?
  poll            InternalChatPoll?
  event           InternalChatEvent?
  pins            InternalChatPinnedMessage[]
  bookmarks       InternalChatBookmark[]

  @@index([channelId, createdAt])
  @@index([senderId])
  @@index([replyToId])
  @@index([threadId])
  @@index([priority, createdAt])
  @@map("internal_chat_message")
}

/// Archivo adjunto a un mensaje (foto, video, audio, documento).
model InternalChatAttachment {
  id              String               @id @default(cuid())
  /// Null while the file is uploaded but not yet sent as part of a message.
  messageId       String?
  /// Channel the upload was authorized for. Set on new uploads; null on legacy rows.
  channelId       String?
  /// User who uploaded the file. Set on new uploads; null on legacy rows.
  uploadedBy      String?
  fileName        String
  mimeType        String
  sizeBytes       Int
  /// Legacy disk path. Null for objects stored through StorageObject.
  storagePath     String?
  /// Reference to the central object registry (R2 or migrated legacy file).
  storageObjectId String?
  width           Int?
  height          Int?
  durationMs      Int?
  thumbnailPath   String?
  createdAt       DateTime             @default(now())
  message         InternalChatMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  storageObject   StorageObject?       @relation(fields: [storageObjectId], references: [id], onDelete: SetNull)

  @@index([messageId])
  @@index([channelId, uploadedBy])
  @@index([storageObjectId])
  @@map("internal_chat_attachment")
}

/// Reacción emoji a un mensaje.
model InternalChatReaction {
  id        String              @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime            @default(now())
  message   InternalChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("internal_chat_reaction")
}

/// Confirmación de lectura de un mensaje por un usuario.
model InternalChatReadReceipt {
  id        String              @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime            @default(now())
  message   InternalChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@map("internal_chat_read_receipt")
}

/// Presencia de un usuario en el chat (1 fila por usuario).
model InternalChatPresence {
  userId     String   @id
  status     String   @default("offline")
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("internal_chat_presence")
}

/// Mención de un usuario en un mensaje de chat.
model InternalChatMention {
  id        String              @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime?
  message   InternalChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, readAt])
  @@map("internal_chat_mention")
}

/// Ubicación geográfica adjunta a un mensaje.
model InternalChatLocation {
  id        String              @id @default(cuid())
  messageId String              @unique
  latitude  Float
  longitude Float
  label     String?
  message   InternalChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("internal_chat_location")
}

/// Encuesta adjunta a un mensaje.
model InternalChatPoll {
  id          String                   @id @default(cuid())
  messageId   String                   @unique
  question    String
  isMulti     Boolean                  @default(false)
  isAnonymous Boolean                  @default(true)
  closesAt    DateTime?
  message     InternalChatMessage      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  options     InternalChatPollOption[]

  @@map("internal_chat_poll")
}

/// Opción de una encuesta de chat.
model InternalChatPollOption {
  id     String                 @id @default(cuid())
  pollId String
  text   String
  poll   InternalChatPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes  InternalChatPollVote[]

  @@index([pollId])
  @@map("internal_chat_poll_option")
}

/// Voto de un usuario en una opción de encuesta.
model InternalChatPollVote {
  id       String                 @id @default(cuid())
  optionId String
  userId   String
  option   InternalChatPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([optionId, userId])
  @@index([optionId])
  @@map("internal_chat_poll_vote")
}

/// Evento de calendario creado desde el chat.
model InternalChatEvent {
  id          String                  @id @default(cuid())
  messageId   String                  @unique
  channelId   String
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  location    String?
  createdBy   String
  createdAt   DateTime                @default(now())
  message     InternalChatMessage     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  channel     InternalChatChannel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  rsvps       InternalChatEventRsvp[]

  @@index([channelId, startsAt])
  @@index([startsAt])
  @@map("internal_chat_event")
}

/// Respuesta RSVP de un usuario a un evento de chat.
model InternalChatEventRsvp {
  id      String            @id @default(cuid())
  eventId String
  userId  String
  status  String // "yes" | "no" | "maybe"
  event   InternalChatEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@map("internal_chat_event_rsvp")
}

/// Alerta automática de seguridad/anti-fraude del chat.
model InternalChatAlert {
  id         String    @id @default(cuid())
  type       String // "bulk_download" | "off_hours" | "keyword" | "volume_spike" | "external_share"
  severity   String // "low" | "medium" | "high"
  userId     String?
  channelId  String?
  messageId  String?
  metadata   Json?
  resolvedAt DateTime?
  resolvedBy String?
  createdAt  DateTime  @default(now())

  @@index([type, severity, resolvedAt])
  @@index([createdAt])
  @@map("internal_chat_alert")
}

/// Configuración global del chat (key-value singleton).
model InternalChatConfig {
  id    String @id @default("singleton")
  key   String @unique
  value String

  @@map("internal_chat_config")
}

/// Mensaje fijado (pinned) en un canal.
model InternalChatPinnedMessage {
  id        String              @id @default(cuid())
  channelId String
  messageId String
  pinnedBy  String
  pinnedAt  DateTime            @default(now())
  message   InternalChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [pinnedBy], references: [id], onDelete: Cascade)

  @@unique([channelId, messageId])
  @@index([channelId])
  @@map("internal_chat_pinned_message")
}

/// Etiqueta/tag para categorizar canales de chat.
model InternalChatTag {
  id       String                   @id @default(cuid())
  name     String                   @unique
  color    String                   @default("#6b7280")
  channels InternalChatChannelTag[]

  @@map("internal_chat_tag")
}

/// Relación many-to-many entre canal y tag.
model InternalChatChannelTag {
  channelId String              @id @default(cuid())
  tagId     String
  channel   InternalChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  tag       InternalChatTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([channelId, tagId])
  @@index([tagId])
  @@map("internal_chat_channel_tag")
}

/// Preferencia de notificaciones de un usuario para un canal.
model InternalChatNotificationPreference {
  id        String @id @default(cuid())
  userId    String
  channelId String
  level     String // "all" | "mentions" | "none"
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@index([channelId])
  @@map("internal_chat_notification_preference")
}

/// Plantilla/snippet de mensaje guardado por un usuario.
model InternalChatSnippet {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("internal_chat_snippet")
}

/// Mensaje programado para enviarse después.
model InternalChatScheduledMessage {
  id        String    @id @default(cuid())
  channelId String
  senderId  String
  content   String?
  sendAt    DateTime
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  sender    User      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([sendAt, sentAt])
  @@index([channelId])
  @@map("internal_chat_scheduled_message")
}

/// Bookmark/marcador personal de un mensaje.
model InternalChatBookmark {
  id        String              @id @default(cuid())
  userId    String
  messageId String
  createdAt DateTime            @default(now())
  message   InternalChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@index([userId])
  @@map("internal_chat_bookmark")
}

/// Llamada de voz/video WebRTC dentro de un canal de chat.
model InternalChatCall {
  id           String                        @id @default(cuid())
  channelId    String
  callerId     String
  type         String // "audio" | "video"
  status       String                        @default("ringing") // "ringing" | "active" | "ended" | "missed" | "declined"
  startedAt    DateTime?
  endedAt      DateTime?
  createdAt    DateTime                      @default(now())
  channel      InternalChatChannel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  caller       User                          @relation(fields: [callerId], references: [id], onDelete: Cascade)
  participants InternalChatCallParticipant[]
  signals      InternalChatCallSignal[]

  @@index([channelId, status])
  @@index([createdAt])
  @@index([callerId])
  @@map("internal_chat_call")
}

/// Participante de una llamada de chat.
model InternalChatCallParticipant {
  id         String           @id @default(cuid())
  callId     String
  userId     String
  acceptedAt DateTime?
  declinedAt DateTime?
  call       InternalChatCall @relation(fields: [callId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([callId, userId])
  @@index([callId])
  @@map("internal_chat_call_participant")
}

/// Señal WebRTC efímera (offer/answer/ICE) para una llamada.
model InternalChatCallSignal {
  id          String           @id @default(cuid())
  callId      String
  fromUserId  String
  toUserId    String
  signalType  String // "offer" | "answer" | "ice"
  signal      String // JSON stringified SDP/ICE candidate
  createdAt   DateTime         @default(now())
  deliveredAt DateTime?
  call        InternalChatCall @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([toUserId, deliveredAt])
  @@index([callId])
  @@map("internal_chat_call_signal")
}

/// Hilo de conversación dentro de un canal de chat.
model InternalChatThread {
  id            String                @id @default(cuid())
  channelId     String
  rootMessageId String
  createdAt     DateTime              @default(now())
  channel       InternalChatChannel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  rootMessage   InternalChatMessage   @relation("InternalChatThreadRoot", fields: [rootMessageId], references: [id], onDelete: Cascade)
  messages      InternalChatMessage[] @relation("InternalChatThreadMessages")

  @@unique([rootMessageId])
  @@index([channelId])
  @@map("internal_chat_thread")
}

// =====================================================
// Object storage (Cloudflare R2 / legacy disk)
// =====================================================

/// Central registry of every binary UNIK stores. Authorization never derives
/// from this table: knowing an id grants nothing — the owning conversation,
/// channel, document or call is what gets checked.
model StorageObject {
  id               String    @id @default(cuid())
  /// 'r2' | 'disk'
  provider         String
  /// Logical bucket: files | recordings | quarantine (resolved per environment)
  bucketAlias      String
  /// Server-generated key. Never received from the client.
  objectKey        String
  /// Opaque version identifier that is part of the key (documents keep history).
  versionId        String
  /// Previous version of the same logical document, if any.
  parentObjectId   String?
  originalName     String
  declaredMimeType String
  detectedMimeType String?
  /// Real size. Serialized as string in APIs.
  sizeBytes        BigInt    @default(0)
  sha256           String?
  /// initiated | uploading | validating | ready | rejected | aborted | missing | deleted
  status           String    @default("initiated")
  rejectionReason  String?
  /// User id or service identity (e.g. "service:ai", "service:livekit").
  createdBy        String?
  /// chat | ai_attachment | ai_artifact | document | recording | transcript | plugin | knowledge | comm_media | export | evidence
  purpose          String
  /// default | protected (approved or shared documents are never removed by generic cleanup)
  retentionPolicy  String    @default("default")
  /// Optional technical metadata (width, height, durationMs, pageCount, thumbnails...)
  metadata         Json?
  /// Original disk path for files migrated from the legacy directories.
  legacyPath       String?
  expiresAt        DateTime?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  uploadSession   UploadSession?
  aiAttachments   AiAttachment[]
  aiArtifacts     AiArtifact[]
  chatAttachments InternalChatAttachment[]

  @@unique([bucketAlias, objectKey])
  @@index([status])
  @@index([purpose, status])
  @@index([createdBy, createdAt])
  @@index([expiresAt])
  @@index([sha256])
  @@index([parentObjectId])
}

/// Tracks an in-progress upload (single or multipart). Parts and the provider
/// upload id are server controlled; the browser only receives short-lived
/// per-part authorizations.
model UploadSession {
  id               String        @id @default(cuid())
  objectId         String        @unique
  userId           String
  /// ai_conversation | chat_channel | document | plugin | knowledge
  targetType       String
  targetId         String
  declaredSize     BigInt
  partSize         Int
  partCount        Int
  multipart        Boolean       @default(false)
  /// S3 multipart UploadId (R2). Null for single PUT or disk driver.
  providerUploadId String?
  /// Quarantine key the browser writes to. The final key is chosen on promotion.
  quarantineKey    String
  /// Uploaded parts: [{ partNumber, etag, sizeBytes }]
  parts            Json?
  /// initiated | uploading | completing | completed | aborted | expired
  status           String        @default("initiated")
  expiresAt        DateTime
  completedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  object           StorageObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, expiresAt])
}

/// Storage settings bag (quotas, retention, driver flags) — same pattern as AiConfig.
model StorageConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  settings  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Durable background job queue backed by PostgreSQL so work survives tab
/// closes and instance restarts. Processed by the in-process worker
/// (src/modules/jobs). A Redis/BullMQ driver can replace the executor
/// without touching producers.
model BackgroundJob {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  /// pending | running | completed | failed | cancelled
  status      String    @default("pending")
  /// Lower runs first. Human-facing work uses < 100, campaigns > 500.
  priority    Int       @default(100)
  runAt       DateTime  @default(now())
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lastError   String?
  lockedAt    DateTime?
  lockedBy    String?
  /// Optional idempotency key (unique while the job is not completed).
  dedupeKey   String?   @unique
  /// Optional group for bulk cancel (campaign id, plugin id...).
  groupKey    String?
  progress    Int       @default(0)
  result      Json?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([status, runAt, priority])
  @@index([type, status])
  @@index([groupKey])
  @@index([createdAt])
}

/// Persisted realtime events. Clients resume with a cursor (last event id),
/// so a reconnect never loses updates.
model RealtimeEvent {
  id        BigInt   @id @default(autoincrement())
  /// user:{id} | channel:{id} | upload:{objectId} | job:{id} | inbox:{teamId} | call:{id}
  channel   String
  type      String
  payload   Json
  createdAt DateTime @default(now())

  @@index([channel, id])
  @@index([createdAt])
}

// =====================================================
// Extensions: MCP servers, custom APIs, plugins, skills, connections
// =====================================================

/// An installed extension (MCP server, custom API, plugin package or skill
/// bundle). Its capabilities are exposed to the assistant only through an
/// APPROVED and ENABLED version, and only to the allowed roles.
model Extension {
  id               String                @id @default(cuid())
  /// Stable namespace, e.g. "mcp.books", "api.proveedor". Tool names are "<namespace>__<local>".
  namespace        String                @unique
  /// mcp | api | plugin | skill
  kind             String
  name             String
  description      String?
  createdBy        String
  /// draft | testing | pending_approval | approved | enabled | suspended | revoked
  status           String                @default("draft")
  currentVersionId String?
  /// Role keys allowed to use the extension. Empty = only super_admin / assistant.admin (testing).
  allowedRoleKeys  String[]              @default([])
  /// Approved egress: hosts (exact or *.suffix) and ports.
  allowedHosts     String[]              @default([])
  allowedPorts     Int[]                 @default([443])
  /// Non-secret configuration (base URL, MCP endpoint, auth type, OAuth endpoints...).
  config           Json?
  suspendedAt      DateTime?
  suspendedReason  String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  versions         ExtensionVersion[]
  capabilities     ExtensionCapability[]
  connections      ExtensionConnection[]
  executions       ExtensionExecution[]

  @@index([kind, status])
}

/// Immutable version identified by its content hash. Updates create a new
/// version; the one in use is never replaced until the new one is approved.
model ExtensionVersion {
  id             String                @id @default(cuid())
  extensionId    String
  version        String
  contentHash    String
  /// Declarative manifest: tools/operations, skills, templates, docs, fixtures. Never secrets.
  manifest       Json
  /// draft | testing | pending_approval | approved | enabled | suspended | superseded
  status         String                @default("draft")
  reviewNotes    String?
  publishedBy    String
  approvedBy     String?
  approvedAt     DateTime?
  lastTestedAt   DateTime?
  lastTestResult Json?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  extension      Extension             @relation(fields: [extensionId], references: [id], onDelete: Cascade)
  capabilities   ExtensionCapability[]

  @@unique([extensionId, version])
  @@index([extensionId, status])
}

/// One concrete capability (MCP tool, API operation, plugin tool) with UNIK's
/// OWN classification. Server annotations and model descriptions never grant trust.
model ExtensionCapability {
  id                 String           @id @default(cuid())
  extensionId        String
  versionId          String
  /// Name exposed to the model: "<namespace>__<localName>".
  name               String
  localName          String
  description        String
  inputSchema        Json
  outputSchema       Json?
  /// Fingerprint of name+description+schemas to detect remote changes.
  schemaHash         String
  /// read | draft | internal_task | external_send | business_write | destructive
  effect             String           @default("read")
  /// auto | require_approval
  approvalPolicy     String           @default("require_approval")
  /// Data categories the capability may receive (e.g. "customer_contact", "prices").
  dataScope          String[]         @default([])
  requiredPermission String?
  timeoutMs          Int              @default(15000)
  maxResultBytes     Int              @default(65536)
  /// none | team | personal — which connection identity executes it.
  connectionScope    String           @default("none")
  /// pending | approved | blocked
  reviewStatus       String           @default("pending")
  enabled            Boolean          @default(false)
  /// True when the remote catalog changed after approval; blocked until re-reviewed.
  remoteChanged      Boolean          @default(false)
  /// Operation definition for API extensions (method, path, params, response selection...).
  operation          Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  extension          Extension        @relation(fields: [extensionId], references: [id], onDelete: Cascade)
  version            ExtensionVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, localName])
  @@index([extensionId, enabled])
  @@index([name])
}

/// An authorized account for an extension. Secrets are AES-256-GCM encrypted
/// with a master key outside PostgreSQL; the browser never receives them back.
model ExtensionConnection {
  id                 String    @id @default(cuid())
  extensionId        String
  /// oauth2 | api_key | bearer | basic | service
  authType           String
  /// team | personal
  scopeType          String
  ownerUserId        String?
  name               String
  /// active | revoked | expired | error
  status             String    @default("active")
  keyId              String?
  /// Encrypted JSON { accessToken?, refreshToken?, apiKey?, username?, password? }
  secretCiphertext   String?
  expiresAt          DateTime?
  scopes             String[]  @default([])
  /// Non-secret metadata: account label, token endpoint, provider user id.
  metadata           Json?
  /// Per-connection lock to avoid concurrent token refreshes.
  refreshLockedUntil DateTime?
  lastUsedAt         DateTime?
  lastError          String?
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  extension          Extension @relation(fields: [extensionId], references: [id], onDelete: Cascade)

  @@index([extensionId, scopeType])
  @@index([ownerUserId])
}

/// OAuth authorization in flight (state + PKCE verifier), short lived.
model OAuthState {
  id           String   @id @default(cuid())
  state        String   @unique
  codeVerifier String
  userId       String
  extensionId  String
  scopeType    String
  redirectUri  String
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([expiresAt])
}

/// A pending approval for an action with side effects. Bound to the exact
/// tool, version, connection, arguments, recipient, files and context; any
/// material change invalidates it.
model AiProposal {
  id               String    @id @default(cuid())
  conversationId   String?
  messageId        String?
  userId           String
  toolName         String
  toolVersion      String?
  capabilityId     String?
  connectionId     String?
  argsHash         String
  args             Json
  summary          String
  recipient        String?
  fileIds          String[]  @default([])
  contextHash      String?
  effect           String
  /// pending | approved | rejected | executed | failed | expired | invalidated | pending_review | awaiting_second_approval
  status           String    @default("pending")
  decisionBy       String?
  decidedAt        DateTime?
  /// Alcance de aprobación en turnos de agente: {caseId, areaKey, userIds[], permission}
  approverScope    Json?
  /// Segunda firma (doble aprobación)
  secondDecisionBy String?
  secondDecidedAt  DateTime?
  executedAt       DateTime?
  result           Json?
  error            String?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, status])
  @@index([conversationId])
  @@index([status, expiresAt])
}

/// Audit of every external execution (the "Ejecuciones" tab). Never stores secrets.
model ExtensionExecution {
  id            String     @id @default(cuid())
  extensionId   String?
  capabilityId  String?
  connectionId  String?
  userId        String?
  toolName      String
  /// success | error | denied | timeout | pending_review | needs_approval
  status        String
  durationMs    Int        @default(0)
  requestBytes  Int        @default(0)
  responseBytes Int        @default(0)
  errorCode     String?
  errorMessage  String?
  proposalId    String?
  createdAt     DateTime   @default(now())
  extension     Extension? @relation(fields: [extensionId], references: [id], onDelete: SetNull)

  @@index([extensionId, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// A declarative skill (recipe): inputs, instructions, allowed tools, steps,
/// completion conditions, approval points and limits. No code, ever.
model Skill {
  id          String     @id @default(cuid())
  key         String     @unique
  name        String
  purpose     String
  ownerUserId String
  /// personal | team
  scope       String     @default("personal")
  /// draft | published | suspended
  status      String     @default("draft")
  version     Int        @default(1)
  definition  Json
  extensionId String?
  publishedBy String?
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  runs        SkillRun[]

  @@index([ownerUserId, scope])
  @@index([status, scope])
}

/// One execution of a skill; survives restarts and waits for approvals.
model SkillRun {
  id             String    @id @default(cuid())
  skillId        String
  skillVersion   Int
  userId         String
  conversationId String?
  /// running | waiting_approval | completed | failed | cancelled
  status         String    @default("running")
  inputs         Json
  state          Json
  currentStep    String?
  proposalId     String?
  error          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  completedAt    DateTime?
  skill          Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId, status])
  @@index([userId, createdAt])
  @@index([proposalId])
}

/// Consumption per dimension (extension, provider, user, team, storage, job).
model UsageMeter {
  id        String   @id @default(cuid())
  dimension String
  key       String
  /// YYYY-MM-DD
  period    String
  unit      String
  count     Int      @default(0)
  amount    Decimal  @default(0) @db.Decimal(18, 4)
  updatedAt DateTime @updatedAt

  @@unique([dimension, key, period, unit])
  @@index([dimension, period])
}

// =====================================================
// Copilot: personalization, personal memory, approved knowledge library
// =====================================================

/// Per-user assistant preferences (mode, tone, language, depth, format).
model AiUserPreference {
  userId             String   @id
  /// paused | on_request | autonomous_verified
  mode               String   @default("on_request")
  /// profesional | cercano | directo
  tone               String   @default("profesional")
  language           String   @default("es")
  /// breve | normal | detallado
  depth              String   @default("normal")
  /// markdown | texto | tablas
  format             String   @default("markdown")
  customInstructions String?
  memoryEnabled      Boolean  @default(true)
  /// Inbox copilot: active (proactive) | on_demand | paused
  inboxCopilotMode   String   @default("active")
  /// Internal chat copilot: active (proactive) | on_demand | paused
  chatCopilotMode    String   @default("active")
  /// Plan-then-execute: auto (only complex tasks) | always | never
  planMode           String   @default("auto")
  /// Modo por superficie de copiloto {area|case|mywork|control_tower: active|on_demand|paused}; inbox/chat siguen en sus columnas
  surfaceModes       Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// Personal memory: visible, editable and deletable by its owner. Corrections
/// proposed by the assistant stay `pending` until the user confirms them.
model AiMemory {
  id         String    @id @default(cuid())
  userId     String
  content    String
  /// user | assistant | correction
  source     String    @default("user")
  /// active | pending | archived
  status     String    @default("active")
  tags       String[]  @default([])
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, status, createdAt])
}

/// Approved knowledge library. Internal vs publishable information is
/// separated by `visibility`; a document received from a customer never
/// becomes shared knowledge automatically.
model KnowledgeSource {
  id               String                   @id @default(cuid())
  title            String
  description      String?
  /// document | url | website | text
  kind             String
  /// internal | publishable
  visibility       String                   @default("internal")
  /// draft | approved | archived
  status           String                   @default("draft")
  currentVersionId String?
  tags             String[]                 @default([])
  /// promociones | catalogos | precios | fichas_tecnicas | politicas | manuales | procesos | capacitacion | otro
  category         String?
  /// Hint the assistant uses to pick this document ("cuando un distribuidor pide precios").
  useWhen          String?
  /// After this moment the source is neither cited nor sent.
  expiresAt        DateTime?
  createdBy        String
  approvedBy       String?
  approvedAt       DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  versions         KnowledgeSourceVersion[]

  @@index([status, visibility])
  @@index([category])
}

model KnowledgeSourceVersion {
  id              String           @id @default(cuid())
  sourceId        String
  version         Int
  storageObjectId String?
  sourceUrl       String?
  /// processing | ready | failed
  status          String           @default("processing")
  sha256          String?
  chunkCount      Int              @default(0)
  error           String?
  fileName        String?
  mimeType        String?
  sizeBytes       Int?
  /// Pages read for url/website versions.
  pageCount       Int              @default(0)
  /// Becomes the current approved version as soon as processing succeeds.
  autoApprove     Boolean          @default(false)
  createdBy       String
  createdAt       DateTime         @default(now())
  source          KnowledgeSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  chunks          KnowledgeChunk[]

  @@unique([sourceId, version])
}

model KnowledgeChunk {
  id             String                 @id @default(cuid())
  sourceId       String
  versionId      String
  ordinal        Int
  section        String?
  content        String
  tokens         Int                    @default(0)
  /// Semantic vector (text-embedding-3-small by default). Empty until embedded.
  embedding      Float[]                @default([])
  embeddingModel String?
  createdAt      DateTime               @default(now())
  version        KnowledgeSourceVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId, ordinal])
  @@index([sourceId])
}

// =====================================================
// Omnichannel communications, campaigns, commitments
// =====================================================

/// A messaging number/bot (Twilio WhatsApp/SMS, Telegram) assigned to teams.
model CommAccount {
  id            String             @id @default(cuid())
  /// twilio_whatsapp | twilio_sms | telegram
  provider      String
  label         String
  /// Phone number (E.164) or bot username.
  identifier    String
  /// Credentials live in an ExtensionConnection (encrypted). Null = env fallback.
  connectionId  String?
  teamKeys      String[]           @default([])
  /// active | paused
  status        String             @default("active")
  /// Hashed webhook secret (Telegram secret_token / Twilio auth for signature validation is env based).
  webhookSecret String?
  config        Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  conversations CommConversation[]
  messages      CommMessage[]

  @@unique([provider, identifier])
  @@index([status])
}

model CommContact {
  id                    String             @id @default(cuid())
  displayName           String
  phone                 String?
  telegramId            String?
  email                 String?
  zohoContactId         String?
  tags                  String[]           @default([])
  /// Reviewable duplicate detection: points to the surviving contact once merged.
  duplicateOfId         String?
  duplicateReviewStatus String? // pending | confirmed | dismissed
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  conversations         CommConversation[]
  consents              ConsentRecord[]

  @@index([phone])
  @@index([telegramId])
  @@index([zohoContactId])
  @@index([duplicateReviewStatus])
}

model CommConversation {
  id               String        @id @default(cuid())
  accountId        String
  contactId        String
  /// open | pending | snoozed | resolved
  status           String        @default("open")
  assignedToUserId String?
  subject          String?
  /// normal | high | urgent
  priority         String        @default("normal")
  tags             String[]      @default([])
  unreadCount      Int           @default(0)
  lastMessageAt    DateTime      @default(now())
  lastInboundAt    DateTime?
  snoozedUntil     DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  account          CommAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact          CommContact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages         CommMessage[]
  notes            CommNote[]

  @@index([accountId, status, lastMessageAt])
  @@index([assignedToUserId, status])
  @@index([contactId])
}

/// External messages are persisted ONCE: (accountId, externalId) is unique.
model CommMessage {
  id             String           @id @default(cuid())
  accountId      String
  conversationId String
  /// inbound | outbound
  direction      String
  externalId     String?
  body           String?
  mediaObjectIds String[]         @default([])
  /// received | queued | sent | delivered | read | failed | undelivered
  status         String           @default("received")
  error          String?
  sentByUserId   String?
  proposalId     String?
  campaignId     String?
  templateKey    String?
  providerMeta   Json?
  createdAt      DateTime         @default(now())
  sentAt         DateTime?
  deliveredAt    DateTime?
  readAt         DateTime?
  account        CommAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  conversation   CommConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([accountId, externalId])
  @@index([conversationId, createdAt])
  @@index([campaignId, status])
}

model CommNote {
  id             String           @id @default(cuid())
  conversationId String
  authorUserId   String
  body           String
  createdAt      DateTime         @default(now())
  conversation   CommConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// Directory of responsible people per area (who handles what).
model Responsible {
  id           String   @id @default(cuid())
  area         String   @unique
  label        String
  userId       String
  backupUserId String?
  description  String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Commitments made to contacts (follow-up tracking).
model Commitment {
  id          String    @id @default(cuid())
  description String
  ownerUserId String
  contactId   String?
  /// comm_message | ai_conversation | call | request | manual
  sourceType  String    @default("manual")
  sourceId    String?
  dueAt       DateTime?
  /// pending | done | overdue | cancelled
  status      String    @default("pending")
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([ownerUserId, status, dueAt])
  @@index([contactId])
}

model ConsentRecord {
  id         String      @id @default(cuid())
  contactId  String
  /// whatsapp | sms | telegram
  channel    String
  /// opted_in | opted_out
  status     String
  source     String
  note       String?
  recordedAt DateTime    @default(now())
  contact    CommContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, channel, recordedAt])
}

/// Campaign with FROZEN audience and content, consent checks and budget.
model Campaign {
  id               String              @id @default(cuid())
  name             String
  /// whatsapp | sms | telegram
  channel          String
  accountId        String
  /// draft | rehearsal | pending_approval | scheduled | running | paused | completed | cancelled
  status           String              @default("draft")
  /// Frozen audience: { filter, count, frozenAt }
  audienceSnapshot Json?
  /// Frozen content: { templateKey?, body, variables }
  contentSnapshot  Json?
  budgetLimit      Decimal?            @db.Decimal(18, 4)
  budgetSpent      Decimal             @default(0) @db.Decimal(18, 4)
  costPerMessage   Decimal             @default(0) @db.Decimal(18, 6)
  batchSize        Int                 @default(500)
  ratePerMinute    Int                 @default(60)
  scheduledAt      DateTime?
  startedAt        DateTime?
  pausedAt         DateTime?
  completedAt      DateTime?
  stats            Json?
  createdBy        String
  approvedBy       String?
  approvedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  recipients       CampaignRecipient[]

  @@index([status, scheduledAt])
}

model CampaignRecipient {
  id              String    @id @default(cuid())
  campaignId      String
  contactId       String
  identifier      String
  personalization Json?
  /// pending | queued | sent | delivered | failed | skipped | opted_out
  status          String    @default("pending")
  batchNo         Int       @default(0)
  messageId       String?
  error           String?
  sentAt          DateTime?
  createdAt       DateTime  @default(now())
  campaign        Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([campaignId, status, batchNo])
}

// =====================================================
// Voice: LiveKit rooms, Twilio PSTN, transcription, recording, supervision
// =====================================================

model VoiceCall {
  id                  String                   @id @default(cuid())
  /// internal | inbound | outbound
  type                String
  provider            String                   @default("livekit")
  roomName            String                   @unique
  /// ringing | active | ended | failed | missed
  status              String                   @default("ringing")
  fromIdentity        String?
  toIdentity          String?
  externalNumber      String?
  accountId           String?
  contactId           String?
  initiatedByUserId   String?
  /// active | paused | off — "Pausar IA" stops listening, transcription, analysis and voice.
  aiState             String                   @default("off")
  aiPausedAt          DateTime?
  /// Generation counter: results produced before a pause are discarded.
  aiGeneration        Int                      @default(0)
  /// off | recording | stopped
  recordingState      String                   @default("off")
  egressId            String?
  recordingObjectId   String?
  transcriptObjectId  String?
  summary             String?
  /// Mission for AI-driven outbound calls ("call and tell them X"); read by the voice agent brief.
  aiBrief             String?
  startedAt           DateTime?
  endedAt             DateTime?
  durationSec         Int?
  /// Retention: audio 30 days, transcripts/summaries 90 days.
  recordingExpiresAt  DateTime?
  transcriptExpiresAt DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  participants        VoiceParticipant[]
  segments            VoiceTranscriptSegment[]
  supervisions        VoiceSupervision[]

  @@index([status, createdAt])
  @@index([initiatedByUserId, createdAt])
  @@index([contactId])
}

model VoiceParticipant {
  id       String    @id @default(cuid())
  callId   String
  identity String
  userId   String?
  /// caller | callee | agent | ai | supervisor
  role     String
  joinedAt DateTime  @default(now())
  leftAt   DateTime?
  muted    Boolean   @default(false)
  call     VoiceCall @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@index([userId])
}

model VoiceTranscriptSegment {
  id              String    @id @default(cuid())
  callId          String
  speakerIdentity String
  text            String
  startMs         Int
  endMs           Int
  generation      Int       @default(0)
  createdAt       DateTime  @default(now())
  call            VoiceCall @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId, startMs])
}

model VoiceSupervision {
  id               String    @id @default(cuid())
  callId           String
  supervisorUserId String
  /// listen | whisper | barge
  mode             String
  startedAt        DateTime  @default(now())
  endedAt          DateTime?
  call             VoiceCall @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@index([supervisorUserId])
}

// ===== Núcleo operativo (plan UNIK Neural Operations) =====

/// Área operativa. Sembrada de forma idempotente por ensureOperationsSeed().
model Area {
  id              String   @id @default(cuid())
  /// ventas | compras | inventario | manufactura | logistica | contabilidad | administracion
  key             String   @unique
  label           String
  /// Slug de Responsible.area (responsable y suplente del área)
  responsibleArea String
  leadUserId      String?
  /// Canal del área en el chat interno (InternalChatChannel.id)
  chatChannelId   String?  @unique
  sortOrder       Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([active, sortOrder])
  @@index([leadUserId])
}

/// Expediente operativo (EXP-{caseSeq}) que nace de una orden de venta.
model OperationalCase {
  id               String       @id @default(cuid())
  /// Consecutivo de Sequence('case') tomado en la transacción de case.start (sin autoincrement:
  /// caseNumber es obligatorio y se escribe en el mismo INSERT)
  caseSeq          Int          @unique
  /// EXP-{caseSeq}
  caseNumber       String       @unique
  /// sales_fulfillment
  kind             String
  /// sales_order
  sourceType       String
  sourceId         String
  zohoSalesOrderId String?
  salesOrderNumber String?
  customerName     String?
  zohoCustomerId   String?
  salespersonName  String?
  locationId       String?
  locationName     String?
  deliveryMethod   String?
  orderDate        DateTime?
  /// ProcessVersion.id con el que se instanciaron los pasos
  processVersionId String
  /// open | waiting | blocked | ready_to_close | closed | cancelled
  status           String       @default("open")
  /// planning | sourcing | preparing | delivering | closing
  phase            String       @default("planning")
  /// normal | high | urgent
  priority         String       @default("normal")
  ownerUserId      String
  promisedAt       DateTime?
  openedAt         DateTime     @default(now())
  closedAt         DateTime?
  cancelledAt      DateTime?
  closeReason      String?
  lastActivityAt   DateTime     @default(now())
  /// Sala del expediente en el chat interno (InternalChatChannel.id)
  chatChannelId    String?      @unique
  aiSummary        String?
  /// OperationalEvent.id más reciente incluido en aiSummary
  aiSummaryEventId BigInt?
  version          Int          @default(1)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  demands          CaseDemand[]
  steps            CaseStep[]

  @@unique([kind, sourceType, sourceId])
  @@index([status, lastActivityAt])
  @@index([zohoSalesOrderId])
  @@index([ownerUserId, status])
  @@index([phase, status])
  @@index([locationId, status])
  @@index([promisedAt])
  @@index([openedAt])
}

/// Necesidad de un expediente (una por línea de la orden).
model CaseDemand {
  id                String             @id @default(cuid())
  caseId            String
  /// zohoLineItemId o idx:n
  lineRef           String
  zohoItemId        String?
  sku               String?
  name              String
  quantity          Decimal            @db.Decimal(18, 4)
  unit              String
  baseQuantity      Decimal            @db.Decimal(18, 4)
  baseUnit          String
  variantKey        String             @default("")
  variantJson       Json?
  locationId        String?
  requestedAt       DateTime?
  /// pending | verifying | planned | allocated | fulfilled | cancelled
  status            String             @default("pending")
  fulfilledQuantity Decimal            @default(0) @db.Decimal(18, 4)
  sortOrder         Int                @default(0)
  version           Int                @default(1)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  case              OperationalCase    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  allocations       DemandAllocation[]

  @@unique([caseId, lineRef])
  @@index([zohoItemId, status])
  @@index([sku, status])
  @@index([status])
}

/// Cómo se cubre (parte de) una necesidad: stock, compra, manufactura o proveedor directo.
model DemandAllocation {
  id                 String     @id @default(cuid())
  demandId           String
  caseId             String
  /// stock | purchase | manufacture | direct_supplier
  source             String
  /// Cantidad en unidad base
  quantity           Decimal    @db.Decimal(18, 4)
  /// planned | reserved | requested | in_progress | ready | released | delivered | reopened | cancelled
  status             String     @default("planned")
  warehouseId        String?
  stockReservationId String?
  /// Objeto vinculado (solicitud de compra, orden de producción)
  linkedType         String?
  linkedId           String?
  expectedAt         DateTime?
  readyAt            DateTime?
  deliveredQuantity  Decimal    @default(0) @db.Decimal(18, 4)
  version            Int        @default(1)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  demand             CaseDemand @relation(fields: [demandId], references: [id], onDelete: Cascade)

  @@index([caseId, status])
  @@index([demandId])
  @@index([linkedType, linkedId])
  @@index([stockReservationId])
  @@index([source, status])
}

/// Definición versionada e inmutable de un proceso (blueprint), p. ej. sales_fulfillment@1.
model ProcessVersion {
  id         String   @id @default(cuid())
  processKey String
  /// Número de versión del blueprint (no es control de concurrencia)
  version    Int
  definition Json
  checksum   String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([processKey, version])
  @@index([processKey, active])
}

/// Paso instanciado de un expediente (por caso, necesidad o asignación).
model CaseStep {
  id               String          @id @default(cuid())
  caseId           String
  processVersionId String
  stepKey          String
  /// case | demand | allocation
  scope            String          @default("case")
  /// "" para scope=case; demandId o allocationId en los demás
  scopeKey         String          @default("")
  demandId         String?
  allocationId     String?
  areaKey          String
  /// action | wait | approval | verification | external_sync
  kind             String
  /// pending | ready | active | waiting | done | skipped | failed | cancelled
  status           String          @default("pending")
  dependsOn        String[]        @default([])
  /// SLA en minutos (0 = sin SLA)
  slaMinutes       Int             @default(0)
  dueAt            DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  exitEvidence     Json?
  version          Int             @default(1)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  case             OperationalCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, stepKey, scopeKey])
  @@index([areaKey, status])
  @@index([status, dueAt])
  @@index([demandId])
  @@index([allocationId])
}

/// Trabajo asignado a una persona (con dueño, suplente, vencimiento y escalamiento).
model WorkItem {
  id               String    @id @default(cuid())
  caseId           String?
  stepId           String?
  areaKey          String
  /// action | wait | approval | verification | external_sync | incident_followup
  kind             String
  title            String
  description      String?
  /// open | in_progress | waiting | escalated | done | cancelled
  status           String    @default("open")
  ownerUserId      String
  backupUserId     String?
  dueAt            DateTime
  escalationLevel  Int       @default(0)
  escalatedAt      DateTime?
  waitReason       String?
  waitUntil        DateTime?
  objectType       String?
  objectId         String?
  requiredEvidence String[]  @default([])
  result           Json?
  completedBy      String?
  completedAt      DateTime?
  version          Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, dueAt])
  @@index([areaKey, status, dueAt])
  @@index([ownerUserId, status])
  @@index([backupUserId, status])
  @@index([caseId])
  @@index([stepId])
  @@index([objectType, objectId])
}

/// Solicitud entre áreas; siempre ligada a un expediente y a un objeto operativo.
model AreaRequest {
  id             String    @id @default(cuid())
  caseId         String
  fromAreaKey    String
  toAreaKey      String
  /// availability_check | purchase_shortfall | payment_authorization | vendor_pickup | transformation | material_shortfall | finished_goods | delivery_update | create_package_in_zoho | resolve_difference | customer_notice | cancel | escalation | info
  kind           String
  objectType     String
  objectId       String
  title          String
  /// Validado con el esquema Zod del kind (request-kinds.ts)
  payload        Json
  /// Único campo no estructurado (≤800 caracteres); siempre se trata como no confiable
  freeText       String?
  /// normal | high | urgent
  priority       String    @default("normal")
  /// sent | acknowledged | accepted | blocked | resolved | rejected | cancelled | expired
  status         String    @default("sent")
  blocksDelivery Boolean   @default(false)
  dueAt          DateTime
  ownerUserId    String
  backupUserId   String?
  workItemId     String?
  /// user | ai | system
  createdByType  String
  createdById    String?
  chatMessageId  String?
  answer         Json?
  answeredAt     DateTime?
  closedAt       DateTime?
  version        Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([toAreaKey, status, dueAt])
  @@index([fromAreaKey, status])
  @@index([caseId])
  @@index([ownerUserId, status])
  @@index([status, dueAt])
  @@index([objectType, objectId])
  @@index([workItemId])
}

/// Incidencia operativa deduplicada por dedupeKey.
model Incident {
  id          String    @id @default(cuid())
  caseId      String?
  areaKey     String
  /// sla_breach | orphan_case | stock_conflict | count_dispute | zoho_conflict | zoho_failure | partial_delivery | owner_absent | order_change_conflict | cancellation_compensation | ai_failure | purchase_difference | excess_scrap | quality_failure | production_substitution | zoho_readback_mismatch | sales_order_readback_mismatch
  kind        String
  /// low | medium | high | critical
  severity    String    @default("medium")
  /// open | acknowledged | resolved | dismissed
  status      String    @default("open")
  title       String
  detail      Json      @default("{}")
  ownerUserId String?
  dedupeKey   String    @unique
  openedAt    DateTime  @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?
  resolution  String?
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, severity, openedAt])
  @@index([areaKey, status])
  @@index([caseId])
  @@index([kind, status])
  @@index([ownerUserId, status])
}

/// Bitácora inmutable de eventos del núcleo (append-only, particionable por fecha; sin FKs).
model OperationalEvent {
  id         BigInt   @default(autoincrement())
  occurredAt DateTime @default(now())
  /// now() = inicio de la transacción que inserta. id se asigna al insertar, no al confirmar:
  /// ct.projections_refresh relee una ventana por recordedAt (ver CtProjectionWatermark)
  recordedAt DateTime @default(now())
  caseId     String?
  areaKey    String?
  /// p. ej. case.started, demand.shortfall_confirmed, request.created, ai.turn
  type       String
  /// user | ai | system | zoho
  actorType  String
  actorId    String?
  commandId  String?
  objectType String?
  objectId   String?
  payload    Json     @default("{}")

  @@id([id, occurredAt])
  @@index([caseId, id])
  @@index([type, occurredAt])
  @@index([commandId])
  @@index([areaKey, occurredAt])
  @@index([objectType, objectId])
  @@index([recordedAt])
  @@index([actorId, occurredAt])
}

/// Ledger de comandos idempotentes: repetir un commandId devuelve el resultado guardado.
model OperationalCommand {
  /// = commandId (UUID generado por quien emite el comando)
  id              String    @id
  type            String
  /// user | ai | system | zoho
  actorType       String
  actorId         String
  aggregateType   String
  aggregateId     String
  expectedVersion Int?
  payloadHash     String
  deviceId        String?
  /// accepted | completed | pending_external | rejected | failed
  status          String    @default("accepted")
  result          Json?
  errorCode       String?
  receivedAt      DateTime  @default(now())
  completedAt     DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([aggregateType, aggregateId])
  @@index([deviceId, receivedAt])
  @@index([status, receivedAt])
  @@index([actorId, receivedAt])
}

/// Evidencia (foto, firma, documento, conteo, relectura de Zoho) ligada a un objeto operativo.
model EvidenceLink {
  id              String   @id @default(cuid())
  caseId          String?
  workItemId      String?
  stepId          String?
  objectType      String
  objectId        String
  /// photo | signature | document | note | count | zoho_readback
  kind            String
  storageObjectId String?
  note            String?
  createdBy       String
  createdAt       DateTime @default(now())

  @@index([objectType, objectId])
  @@index([caseId])
  @@index([workItemId])
  @@index([stepId])
}

/// Proyección reconstruible del grafo de objetos (relación vigente si validTo es null).
model ObjectRelation {
  id        String    @id @default(cuid())
  fromType  String
  fromId    String
  toType    String
  toId      String
  relation  String
  validFrom DateTime  @default(now())
  validTo   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([fromType, fromId, toType, toId, relation])
  @@index([toType, toId])
}

/// Contador de folios humanos (OC-, OP-, RC-, RFQ-, GX-, OPP-, NOM-); se incrementa dentro de la transacción del comando.
model Sequence {
  key       String   @id
  next      Int      @default(1)
  updatedAt DateTime @updatedAt
}

/// Política de aprobación de negocio por alcance y rango de monto.
model ApprovalPolicy {
  id                String   @id @default(cuid())
  /// expense | procurement | payment | payroll | production_incident | inventory_adjustment
  scope             String
  categoryId        String?
  minAmount         Decimal  @default(0) @db.Decimal(18, 4)
  maxAmount         Decimal? @db.Decimal(18, 4)
  currency          String   @default("MXN")
  requiredApprovals Int      @default(1)
  approverRoleKeys  String[] @default([])
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([scope, active, minAmount])
  @@index([categoryId])
}

/// Solicitud de aprobación de negocio (un voto por usuario; aprobadores distintos).
model ApprovalRequest {
  id                String    @id @default(cuid())
  /// expense | procurement | payment | payroll | production_incident | inventory_adjustment
  scope             String
  targetType        String
  targetId          String
  amount            Decimal   @db.Decimal(18, 4)
  currency          String    @default("MXN")
  policyId          String?
  requiredApprovals Int
  /// pending | approved | rejected | expired | cancelled
  status            String    @default("pending")
  requestedByUserId String
  /// [{userId, decision, at, note}]
  decisions         Json      @default("[]")
  expiresAt         DateTime?
  decidedAt         DateTime?
  caseId            String?
  areaKey           String?
  version           Int       @default(1)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([targetType, targetId])
  @@index([status, scope])
  @@index([status, expiresAt])
  @@index([requestedByUserId, status])
  @@index([areaKey, status])
  @@index([caseId])
  @@index([policyId])
}

// ===== Capa de agentes (plan UNIK Neural Operations) =====

/// Identidad de un agente IA (coordinadora de área o administradora) respaldada por un usuario-bot.
model AgentIdentity {
  id                    String   @id @default(cuid())
  /// 'area:<areaKey>' | 'admin'
  key                   String   @unique
  /// personal | area | admin
  kind                  String
  areaKey               String?  @unique
  /// p. ej. 'IA de Compras'
  displayName           String
  /// User.id del usuario-bot (User.isBot = true)
  botUserId             String   @unique
  /// active | on_demand | paused
  mode                  String   @default("active")
  dailyTokenBudget      Int      @default(150000)
  monthlyCostBudgetUsd  Decimal  @default(40) @db.Decimal(10, 4)
  maxTurnsPerCasePerDay Int      @default(4)
  /// Horario silencioso, p. ej. {tz, start:'20:00', end:'08:00', days[]}
  quietHours            Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([kind, mode])
}

// ===== Inventario progresivo (plan UNIK Neural Operations) =====

/// Bodega física de UNIK (opcionalmente ligada a una ubicación de Zoho).
model Warehouse {
  id             String   @id @default(cuid())
  key            String   @unique
  name           String
  /// location_id de Zoho cuando la bodega existe allá
  zohoLocationId String?  @unique
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([active])
}

/// Ubicación dentro de una bodega (GENERAL por bodega; scrap para merma).
model StorageLocation {
  id          String   @id @default(cuid())
  warehouseId String
  /// GENERAL por bodega; códigos libres para racks, bins, etc.
  code        String
  label       String?
  /// rack | bin | floor | yard | virtual
  kind        String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([warehouseId, code])
  @@index([warehouseId, active])
}

/// Perfil de inventario de un artículo de Zoho (unidad base, conversiones, confianza del conteo).
model ProductInventoryProfile {
  id                    String    @id @default(cuid())
  zohoItemId            String    @unique
  baseUnit              String
  /// [{unit, factor}] factor = unidades base por unidad
  conversions           Json      @default("[]")
  /// Tolerancia de conteo en porcentaje (0 = exacto)
  tolerancePct          Decimal   @default(0) @db.Decimal(9, 4)
  isBulk                Boolean   @default(false)
  /// none | lot | roll | sheet | container
  trackingPolicy        String    @default("none")
  /// medida | color | acabado | lote | rollo | placa
  variantAxes           String[]  @default([])
  /// stock | purchase | manufacture | direct_supplier
  defaultSource         String    @default("stock")
  /// UNCOUNTED | PROVISIONAL | CONTROLLED | DISPUTED
  confidence            String    @default("UNCOUNTED")
  consecutiveGoodCounts Int       @default(0)
  lastCountAt           DateTime?
  controlledAt          DateTime?
  /// Peso en kg por unidad base (capacidad de carga en route-rules)
  weightKgPerBaseUnit   Decimal?  @db.Decimal(18, 4)
  /// Superficie en m² por unidad base (capacidad de carga en route-rules)
  areaM2PerBaseUnit     Decimal?  @db.Decimal(18, 4)
  version               Int       @default(1)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([confidence])
  @@index([trackingPolicy])
}

/// Existencia por artículo, bodega, ubicación, variante y contenedor. Cantidades en unidad base.
/// known = baseline + receipts + returns + produced − issued − consumed + adjustments
model StockItem {
  id                      String    @id @default(cuid())
  zohoItemId              String
  warehouseId             String
  locationId              String
  /// Canónica, p. ej. "color=gris|medida=60x60"; "" sin variante
  variantKey              String    @default("")
  variantJson             Json?
  /// Etiqueta de rollo/placa/contenedor (RL-000123, PL-000045); "" sin contenedor
  containerKey            String    @default("")
  baseline                Decimal   @default(0) @db.Decimal(18, 4)
  receipts                Decimal   @default(0) @db.Decimal(18, 4)
  returns                 Decimal   @default(0) @db.Decimal(18, 4)
  produced                Decimal   @default(0) @db.Decimal(18, 4)
  issued                  Decimal   @default(0) @db.Decimal(18, 4)
  consumed                Decimal   @default(0) @db.Decimal(18, 4)
  /// Con signo
  adjustments             Decimal   @default(0) @db.Decimal(18, 4)
  reserved                Decimal   @default(0) @db.Decimal(18, 4)
  blocked                 Decimal   @default(0) @db.Decimal(18, 4)
  assignedToProduction    Decimal   @default(0) @db.Decimal(18, 4)
  knownQty                Decimal   @default(0) @db.Decimal(18, 4)
  lastCountedAt           DateTime?
  /// ProductionOrder.id que produjo esta existencia (trazabilidad a materias primas y venta)
  originProductionOrderId String?
  /// Medidas de sobrantes vendibles, p. ej. {largo, ancho, unidad}
  dimensions              Json?
  version                 Int       @default(1)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // La llave única también atiende la disponibilidad por (zohoItemId, warehouseId)
  @@unique([zohoItemId, warehouseId, locationId, variantKey, containerKey])
  @@index([warehouseId, locationId])
  @@index([originProductionOrderId])
  @@index([containerKey])
}

/// Movimiento de inventario (append-only).
model StockMovement {
  id               String   @id @default(cuid())
  stockItemId      String
  zohoItemId       String
  warehouseId      String
  /// baseline | receipt | issue | transfer_in | transfer_out | adjust | consume | produce | return | block | unblock
  kind             String
  /// En unidad base (en adjust lleva signo)
  quantity         Decimal  @db.Decimal(18, 4)
  originalQuantity Decimal  @db.Decimal(18, 4)
  originalUnit     String
  /// p. ej. stock_count, stock_reservation, delivery_order, production_order, purchase_receipt
  referenceType    String?
  referenceId      String?
  commandId        String?
  actorId          String
  note             String?
  occurredAt       DateTime @default(now())
  createdAt        DateTime @default(now())

  @@index([stockItemId, occurredAt])
  @@index([referenceType, referenceId])
  @@index([zohoItemId, warehouseId, occurredAt])
  @@index([kind, occurredAt])
  @@index([commandId])
}

/// Reserva de existencia para una necesidad de un expediente.
model StockReservation {
  id                  String    @id @default(cuid())
  stockItemId         String
  zohoItemId          String
  warehouseId         String
  caseId              String
  demandId            String
  allocationId        String?
  /// En unidad base
  quantity            Decimal   @db.Decimal(18, 4)
  /// active | released | consumed | expired
  status              String    @default("active")
  /// Confianza del perfil al reservar: UNCOUNTED | PROVISIONAL | CONTROLLED | DISPUTED
  confidenceAtReserve String
  expiresAt           DateTime?
  releasedAt          DateTime?
  version             Int       @default(1)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([stockItemId, status])
  @@index([zohoItemId, warehouseId, status])
  @@index([caseId])
  @@index([demandId])
  @@index([allocationId])
  @@index([status, createdAt])
}

/// Conteo físico (spot por demanda, cíclico o completo).
model StockCount {
  id          String           @id @default(cuid())
  warehouseId String
  /// spot | cycle | full
  scope       String           @default("spot")
  /// draft | in_progress | closed | cancelled
  status      String           @default("draft")
  startedBy   String
  closedAt    DateTime?
  version     Int              @default(1)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  lines       StockCountLine[]

  @@index([warehouseId, status])
  @@index([status, createdAt])
  @@index([startedBy])
}

/// Línea de un conteo físico por existencia.
model StockCountLine {
  id              String     @id @default(cuid())
  countId         String
  stockItemId     String
  expectedQty     Decimal    @db.Decimal(18, 4)
  countedQty      Decimal    @db.Decimal(18, 4)
  /// Unidad en que se capturó el conteo
  unit            String
  diffQty         Decimal    @db.Decimal(18, 4)
  withinTolerance Boolean
  /// pending | accepted | adjusted | disputed
  resolution      String     @default("pending")
  countedBy       String
  countedAt       DateTime   @default(now())
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  count           StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)

  @@unique([countId, stockItemId])
  @@index([stockItemId, countedAt])
  @@index([resolution])
}

/// Compromiso previo al corte (orden anterior o acuerdo verbal) que resta del disponible hasta confirmarse o liberarse.
model LegacyCommitmentClaim {
  id          String    @id @default(cuid())
  zohoItemId  String
  warehouseId String
  variantKey  String    @default("")
  quantity    Decimal   @db.Decimal(18, 4)
  unit        String
  /// pre_cutover_order | verbal | other
  source      String
  reference   String?
  caseId      String?
  /// claimed | confirmed | released | expired
  status      String    @default("claimed")
  claimedBy   String
  expiresAt   DateTime
  resolvedAt  DateTime?
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([zohoItemId, warehouseId, status])
  @@index([status, expiresAt])
  @@index([caseId])
  @@index([claimedBy, status])
}

// ===== Logística núcleo (plan UNIK Neural Operations) =====

/// Vehículo de la flotilla propia.
model Vehicle {
  id               String    @id @default(cuid())
  code             String    @unique
  plate            String
  label            String
  capacityKg       Decimal?  @db.Decimal(18, 4)
  capacityM2       Decimal?  @db.Decimal(18, 4)
  capacityPieces   Int?
  /// En mantenimiento hasta esta fecha (no asignable)
  maintenanceUntil DateTime?
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([active])
  @@index([plate])
}

/// Chofer (puede o no tener usuario del sistema).
model Driver {
  id            String   @id @default(cuid())
  userId        String?  @unique
  name          String
  phone         String?
  licenseNumber String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active])
}

/// Orden de entrega de (parte de) un expediente, ligada al paquete de Zoho.
model DeliveryOrder {
  id                    String    @id @default(cuid())
  caseId                String
  /// DemandAllocation.id cubiertos por esta entrega
  allocationIds         String[]  @default([])
  /// Package.id local
  packageId             String?
  zohoPackageId         String?
  /// own_fleet | carrier | customer_pickup | direct_supplier
  mode                  String
  /// pending | planned | assigned | pending_external | conflict | dispatched | delivered | partially_delivered | failed | cancelled
  status                String    @default("pending")
  carrier               String?
  vehicleId             String?
  driverId              String?
  tripId                String?
  plannedDate           DateTime?
  windowStart           DateTime?
  windowEnd             DateTime?
  addressLine           String?
  city                  String?
  state                 String?
  postalCode            String?
  contactName           String?
  contactPhone          String?
  lat                   Decimal?  @db.Decimal(10, 7)
  lng                   Decimal?  @db.Decimal(10, 7)
  /// Lo que se pidió escribir en Zoho: {carrier, shipmentDate, trackingNumber}
  shipmentInput         Json?
  zohoShipmentId        String?
  zohoReadback          Json?
  conflictDetail        Json?
  /// not_required | pending_write | written | readback_ok | readback_mismatch | delivered_pending_write | delivered_written | failed
  zohoSyncState         String    @default("not_required")
  zohoLastAttemptAt     DateTime?
  zohoError             String?
  /// [{allocationId, deliveredQty}]
  deliveredLines        Json?
  partialReason         String?
  /// Orden de entrega original cuando ésta cubre el remanente de una entrega parcial
  parentDeliveryOrderId String?
  deliveredAt           DateTime?
  receivedBy            String?
  version               Int       @default(1)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([caseId])
  @@index([status, plannedDate])
  @@index([tripId])
  @@index([zohoPackageId])
  @@index([packageId])
  @@index([zohoSyncState, zohoLastAttemptAt])
  @@index([parentDeliveryOrderId])
  @@index([driverId, plannedDate])
}

/// Viaje de un vehículo con su chofer en una fecha.
model Trip {
  id        String     @id @default(cuid())
  number    String     @unique
  date      DateTime   @db.Date
  vehicleId String
  driverId  String
  /// planned | en_route | done | cancelled
  status    String     @default("planned")
  startedAt DateTime?
  endedAt   DateTime?
  notes     String?
  version   Int        @default(1)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  stops     TripStop[]

  @@index([date, status])
  @@index([driverId, date])
  @@index([vehicleId, date])
  @@index([status])
}

/// Parada de un viaje (una por orden de entrega).
model TripStop {
  id              String    @id @default(cuid())
  tripId          String
  deliveryOrderId String
  sequence        Int
  /// pending | arrived | done | failed (la entrega parcial vive en DeliveryOrder: partially_delivered + orden hija)
  status          String    @default("pending")
  etaAt           DateTime?
  arrivedAt       DateTime?
  departedAt      DateTime?
  lat             Decimal?  @db.Decimal(10, 7)
  lng             Decimal?  @db.Decimal(10, 7)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  trip            Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, deliveryOrderId])
  @@index([tripId, sequence])
  @@index([deliveryOrderId])
  @@index([status])
}

/// Evidencia de entrega (foto, firma, nota o confirmación de cantidades); no se edita.
model DeliveryEvidence {
  id              String   @id @default(cuid())
  deliveryOrderId String
  /// photo | signature | note | qty_confirmation
  kind            String
  storageObjectId String?
  /// [{allocationId, deliveredQty}]
  deliveredLines  Json?
  note            String?
  lat             Decimal? @db.Decimal(10, 7)
  lng             Decimal? @db.Decimal(10, 7)
  commandId       String?
  createdBy       String
  createdAt       DateTime @default(now())

  @@index([deliveryOrderId, createdAt])
  @@index([storageObjectId])
  @@index([commandId])
}

// ===== Compras y Sourcing (plan UNIK Neural Operations) =====

/// Proveedor nativo de UNIK (PRV-), opcionalmente ligado a un contacto de Zoho.
model Supplier {
  id                  String               @id @default(cuid())
  /// Folio PRV-
  number              String               @unique
  name                String
  legalName           String?
  /// RFC
  taxRegNo            String?
  zohoContactId       String?              @unique
  /// active | blocked | archived
  status              String               @default("active")
  /// [{type: whatsapp|sms|telegram|email|phone|web, value}]
  channels            Json                 @default("[]")
  primaryPhone        String?
  primaryEmail        String?
  website             String?
  /// Contact.id del módulo de comunicaciones
  commContactId       String?
  paymentTermsDays    Int?
  /// prepaid | credit | cod
  paymentMode         String               @default("prepaid")
  currency            String               @default("MXN")
  leadTimeDaysDefault Int?
  freightTerms        String?
  /// Calificaciones 0–5 calculadas por supplier-rating.ts
  ratingOverall       Decimal?             @db.Decimal(4, 2)
  ratingOnTime        Decimal?             @db.Decimal(4, 2)
  ratingQuality       Decimal?             @db.Decimal(4, 2)
  ratingPrice         Decimal?             @db.Decimal(4, 2)
  evaluationsCount    Int                  @default(0)
  lastEvaluatedAt     DateTime?
  /// SourcingCandidate.id del que se promovió
  sourceCandidateId   String?              @unique
  tags                String[]             @default([])
  notes               String?
  createdByUserId     String
  version             Int                  @default(1)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  products            SupplierProduct[]
  evaluations         SupplierEvaluation[]

  @@index([name])
  @@index([status])
  @@index([taxRegNo])
  @@index([commContactId])
}

/// Precio y plazo de un artículo con un proveedor.
model SupplierProduct {
  id               String    @id @default(cuid())
  supplierId       String
  /// "" cuando el artículo no existe en Zoho
  zohoItemId       String    @default("")
  /// "" cuando el proveedor no maneja clave propia
  supplierSku      String    @default("")
  description      String
  unit             String
  /// Unidades base por unidad del proveedor
  unitFactorToBase Decimal   @default(1) @db.Decimal(18, 6)
  lastPrice        Decimal?  @db.Decimal(18, 4)
  currency         String    @default("MXN")
  lastQuotedAt     DateTime?
  leadTimeDays     Int?
  minOrderQty      Decimal?  @db.Decimal(18, 4)
  /// rfq | receipt | manual
  source           String    @default("manual")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  supplier         Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, zohoItemId, supplierSku])
  @@index([zohoItemId])
}

/// Solicitud de compra (SC-) de un área o de la demanda de un expediente.
model PurchaseRequest {
  id                String                @id @default(cuid())
  /// Folio SC-
  number            String                @unique
  caseId            String?
  requestedByUserId String
  areaKey           String
  /// draft | open | consolidated | sourcing | ordered | closed | cancelled
  status            String                @default("draft")
  /// normal | high | urgent
  priority          String                @default("normal")
  neededBy          DateTime?
  reason            String?
  version           Int                   @default(1)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  lines             PurchaseRequestLine[]

  @@index([status, createdAt])
  @@index([status, neededBy])
  @@index([caseId])
  @@index([requestedByUserId, status])
  @@index([areaKey, status])
}

/// Renglón de una solicitud de compra.
model PurchaseRequestLine {
  id               String          @id @default(cuid())
  requestId        String
  /// CaseDemand.id
  demandId         String?
  /// DemandAllocation.id (source purchase)
  allocationId     String?
  zohoItemId       String?
  /// zohoItemId|semana ISO (p. ej. LP-01|2026-W38) para sugerir consolidación (purchases.consolidate_suggest)
  consolidationKey String?
  description      String
  qty              Decimal         @db.Decimal(18, 4)
  unit             String
  qtyOrdered       Decimal         @default(0) @db.Decimal(18, 4)
  qtyReceived      Decimal         @default(0) @db.Decimal(18, 4)
  /// open | ordered | received | cancelled
  status           String          @default("open")
  sortOrder        Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  request          PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([demandId])
  @@index([allocationId])
  @@index([zohoItemId, status])
  @@index([consolidationKey, status])
}

/// Solicitud de cotización (RFQ-) enviada a proveedores o candidatos.
model Rfq {
  id               String          @id @default(cuid())
  /// Folio RFQ-
  number           String          @unique
  title            String
  /// draft | sent | collecting | compared | closed | cancelled
  status           String          @default("draft")
  dueAt            DateTime?
  sourcingSearchId String?
  createdByUserId  String
  version          Int             @default(1)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  lines            RfqLine[]
  invitations      RfqInvitation[]
  responses        RfqResponse[]

  @@index([status, dueAt])
  @@index([status, createdAt])
  @@index([createdByUserId, status])
  @@index([sourcingSearchId])
}

/// Renglón solicitado en una RFQ.
model RfqLine {
  id            String   @id @default(cuid())
  rfqId         String
  /// PurchaseRequestLine.id
  requestLineId String?
  zohoItemId    String?
  description   String
  qty           Decimal  @db.Decimal(18, 4)
  unit          String
  /// Especificaciones: medidas, acabado, color, norma
  specs         Json?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  rfq           Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@index([rfqId])
  @@index([requestLineId])
}

/// Invitación de una RFQ a un proveedor o candidato por un canal.
model RfqInvitation {
  id             String    @id @default(cuid())
  rfqId          String
  supplierId     String?
  candidateId    String?
  /// whatsapp | sms | telegram | email
  channel        String
  /// Cuenta de comunicaciones usada para enviar
  accountId      String?
  conversationId String?
  messageId      String?
  /// pending | sent | failed | replied | declined | expired
  status         String    @default("pending")
  sentAt         DateTime?
  repliedAt      DateTime?
  error          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  rfq            Rfq       @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@index([rfqId, status])
  @@index([supplierId])
  @@index([candidateId])
  @@index([conversationId])
  @@index([status, sentAt])
}

/// Cotización recibida (interpretada por IA o capturada) para una RFQ.
model RfqResponse {
  id               String            @id @default(cuid())
  rfqId            String
  invitationId     String?
  supplierId       String?
  candidateId      String?
  /// conversation | manual
  receivedVia      String
  sourceMessageIds String[]          @default([])
  currency         String            @default("MXN")
  exchangeRate     Decimal?          @db.Decimal(18, 6)
  taxIncluded      Boolean           @default(false)
  /// Fracción (0.16 = 16 %)
  taxRate          Decimal?          @db.Decimal(9, 4)
  freight          Decimal           @default(0) @db.Decimal(18, 4)
  otherCosts       Decimal           @default(0) @db.Decimal(18, 4)
  leadTimeDays     Int?
  validUntil       DateTime?
  paymentTerms     String?
  landedTotal      Decimal?          @db.Decimal(18, 4)
  /// Puntaje de rfq-scoring.ts
  score            Decimal?          @db.Decimal(9, 4)
  specMatch        Decimal?          @db.Decimal(9, 4)
  riskScore        Decimal?          @db.Decimal(9, 4)
  confidence       Decimal?          @db.Decimal(4, 3)
  /// Salida validada de rfqInterpretationSchema
  interpretation   Json?
  /// parsed | needs_review | confirmed | rejected | selected
  status           String            @default("parsed")
  reviewedByUserId String?
  version          Int               @default(1)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  rfq              Rfq               @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  lines            RfqResponseLine[]

  @@index([rfqId, status])
  @@index([invitationId])
  @@index([supplierId, createdAt])
  @@index([candidateId])
  @@index([status, createdAt])
}

/// Precio cotizado por renglón. landedUnitCost = (precio·factor + flete/qty + otros/qty)·(iva incluido ? 1 : 1+tasa)
model RfqResponseLine {
  id               String      @id @default(cuid())
  responseId       String
  rfqLineId        String
  unitPrice        Decimal     @db.Decimal(18, 4)
  qty              Decimal     @db.Decimal(18, 4)
  unit             String
  /// Unidades base por unidad cotizada
  unitFactorToBase Decimal     @default(1) @db.Decimal(18, 6)
  landedUnitCost   Decimal?    @db.Decimal(18, 4)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  response         RfqResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@index([responseId])
  @@index([rfqLineId])
}

/// Orden de compra nativa (OC-). zohoPurchaseOrderId es sólo referencia.
model ProcurementOrder {
  id                   String                 @id @default(cuid())
  /// Folio OC-
  number               String                 @unique
  supplierId           String
  rfqResponseId        String?
  /// draft | pending_approval | approved | pending_payment | awaiting_receipt | partially_received | received | closed | cancelled | disputed
  status               String                 @default("draft")
  currency             String                 @default("MXN")
  subtotal             Decimal                @default(0) @db.Decimal(18, 4)
  taxTotal             Decimal                @default(0) @db.Decimal(18, 4)
  freight              Decimal                @default(0) @db.Decimal(18, 4)
  total                Decimal                @default(0) @db.Decimal(18, 4)
  /// prepaid | credit | cod (se copia del proveedor)
  paymentMode          String
  /// unpaid | partial | paid
  paymentStatus        String                 @default("unpaid")
  /// Obligation.id (payable) en finanzas
  obligationId         String?
  approvalRequestId    String?
  expectedAt           DateTime?
  /// warehouse | direct_to_customer
  deliveryMode         String                 @default("warehouse")
  warehouseId          String?
  /// OperationalCase.id cuando el proveedor entrega directo al cliente
  directDeliveryCaseId String?
  sentToSupplierAt     DateTime?
  /// whatsapp | sms | telegram | email | pdf
  sentVia              String?
  conversationId       String?
  zohoPurchaseOrderId  String?
  evidenceObjectIds    String[]               @default([])
  notes                String?
  createdByUserId      String
  version              Int                    @default(1)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  lines                ProcurementOrderLine[]
  receipts             GoodsReceipt[]

  @@index([status, createdAt])
  @@index([status, expectedAt])
  @@index([supplierId, status])
  @@index([paymentStatus, status])
  @@index([createdByUserId, status])
  @@index([rfqResponseId])
  @@index([obligationId])
  @@index([approvalRequestId])
  @@index([directDeliveryCaseId])
  @@index([warehouseId, status])
  @@index([conversationId])
  @@index([zohoPurchaseOrderId])
}

/// Renglón de una orden de compra.
model ProcurementOrderLine {
  id                String                  @id @default(cuid())
  orderId           String
  /// PurchaseRequestLine.id
  requestLineId     String?
  zohoItemId        String?
  supplierProductId String?
  description       String
  qty               Decimal                 @db.Decimal(18, 4)
  unit              String
  unitPrice         Decimal                 @db.Decimal(18, 4)
  /// Fracción (0.16 = 16 %)
  taxRate           Decimal?                @db.Decimal(9, 4)
  lineTotal         Decimal                 @db.Decimal(18, 4)
  qtyReceived       Decimal                 @default(0) @db.Decimal(18, 4)
  qtyAccepted       Decimal                 @default(0) @db.Decimal(18, 4)
  qtyRejected       Decimal                 @default(0) @db.Decimal(18, 4)
  /// open | partial | received | closed | cancelled
  status            String                  @default("open")
  sortOrder         Int                     @default(0)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  order             ProcurementOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  allocations       ProcurementAllocation[]

  @@index([orderId])
  @@index([requestLineId])
  @@index([zohoItemId, status])
  @@index([supplierProductId])
}

/// Reparto exacto de un renglón de compra entre demandas de expedientes.
model ProcurementAllocation {
  id                 String               @id @default(cuid())
  orderLineId        String
  /// CaseDemand.id
  demandId           String
  requestLineId      String?
  /// DemandAllocation.id (source purchase)
  demandAllocationId String?
  qty                Decimal              @db.Decimal(18, 4)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  orderLine          ProcurementOrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)

  @@unique([orderLineId, demandId])
  @@index([demandId])
  @@index([demandAllocationId])
  @@index([requestLineId])
}

/// Recepción de mercancía (RC-) en bodega o confirmación de entrega directa.
model GoodsReceipt {
  id                      String             @id @default(cuid())
  /// Folio RC-
  number                  String             @unique
  orderId                 String
  receivedByUserId        String
  receivedAt              DateTime           @default(now())
  /// warehouse | direct_delivery
  mode                    String             @default("warehouse")
  warehouseId             String?
  locationId              String?
  directConfirmedByUserId String?
  evidenceObjectIds       String[]           @default([])
  /// draft | posted | disputed
  status                  String             @default("draft")
  notes                   String?
  version                 Int                @default(1)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  /// Restrict: una recepción contabilizada no se borra con la orden
  order                   ProcurementOrder   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  lines                   GoodsReceiptLine[]

  @@index([orderId])
  @@index([status, receivedAt])
  @@index([receivedByUserId, receivedAt])
  @@index([warehouseId, receivedAt])
}

/// Renglón recibido; diferencias generan incidencia.
model GoodsReceiptLine {
  id              String       @id @default(cuid())
  receiptId       String
  /// ProcurementOrderLine.id
  orderLineId     String
  qtyReceived     Decimal      @db.Decimal(18, 4)
  qtyAccepted     Decimal      @db.Decimal(18, 4)
  qtyRejected     Decimal      @default(0) @db.Decimal(18, 4)
  unit            String
  lotCode         String?
  stockMovementId String?
  /// none | short | over | damaged | wrong_item
  differenceKind  String       @default("none")
  incidentId      String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  receipt         GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@index([orderLineId])
  @@index([stockMovementId])
  @@index([incidentId])
}

/// Búsqueda del laboratorio de Sourcing, cacheada por queryHash.
model SourcingSearch {
  id                String    @id @default(cuid())
  queryText         String
  queryHash         String    @unique
  /// brave_search | catalog_page
  providerKey       String
  filters           Json?
  /// pending | done | failed
  status            String    @default("pending")
  resultCount       Int       @default(0)
  /// StorageObject.id con la respuesta cruda
  rawResultObjectId String?
  costUnits         Int       @default(0)
  error             String?
  createdByUserId   String
  executedAt        DateTime?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([createdByUserId, createdAt])
  @@index([providerKey, executedAt])
  @@index([expiresAt])
}

/// Proveedor potencial encontrado en Sourcing. dedupeKey = nombre normalizado|dominio|teléfono.
model SourcingCandidate {
  id              String    @id @default(cuid())
  searchId        String?
  dedupeKey       String    @unique
  name            String
  domain          String?
  url             String?
  phone           String?
  email           String?
  location        String?
  productsSummary String?
  /// [{text, price, currency, unit, url}]
  priceSnippets   Json      @default("[]")
  confidence      Decimal?  @db.Decimal(4, 3)
  /// [{url, fetchedAt, objectId, sha256}]
  evidence        Json      @default("[]")
  /// new | contacted | rfq_sent | quoted | approved | rejected | promoted
  status          String    @default("new")
  /// Supplier.id al promoverse o si ya existía
  supplierId      String?
  commContactId   String?
  lastFetchedAt   DateTime?
  version         Int       @default(1)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([searchId])
  @@index([status, updatedAt])
  @@index([domain])
  @@index([phone])
  @@index([supplierId])
  @@index([commContactId])
}

/// Evaluación de un proveedor tras una compra o recepción (1–5 por criterio).
model SupplierEvaluation {
  id                String   @id @default(cuid())
  supplierId        String
  orderId           String?
  receiptId         String?
  onTime            Int
  quality           Int
  price             Int
  communication     Int
  comment           String?
  evaluatedByUserId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  supplier          Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId, createdAt])
  @@index([orderId])
  @@index([receiptId])
  @@index([evaluatedByUserId])
}

// ===== Manufactura (plan UNIK Neural Operations) =====

/// Centro de trabajo (corte, acabado, ensamble) con capacidad por turno.
model WorkCenter {
  id               String   @id @default(cuid())
  key              String   @unique
  name             String
  warehouseId      String?
  capacityPerShift Decimal  @db.Decimal(18, 4)
  /// m2 | pieces | minutes
  capacityUnit     String
  /// [{name, start: "HH:mm", end: "HH:mm", days: [1..7]}]
  shifts           Json     @default("[]")
  costPerHour      Decimal? @db.Decimal(18, 4)
  currency         String   @default("MXN")
  /// active | inactive
  status           String   @default("active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
  @@index([warehouseId])
}

/// Lista de materiales versionada, sólo para productos repetibles.
model Bom {
  id                String         @id @default(cuid())
  outputZohoItemId  String
  /// Número de revisión de la BOM (no es control de concurrencia)
  version           Int            @default(1)
  /// transformation | assembly
  kind              String
  /// draft | active | retired
  status            String         @default("draft")
  outputQty         Decimal        @db.Decimal(18, 4)
  outputUnit        String
  /// Fracción esperada (0.9500 = 95 %)
  expectedYield     Decimal?       @db.Decimal(5, 4)
  /// Porcentaje de merma permitido (5.000 = 5 %)
  scrapAllowancePct Decimal?       @db.Decimal(6, 3)
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  lines             BomLine[]
  operations        BomOperation[]

  @@unique([outputZohoItemId, version])
  @@index([outputZohoItemId, status])
  @@index([status])
}

/// Insumo de una BOM con sus sustitutos permitidos.
model BomLine {
  id                    String   @id @default(cuid())
  bomId                 String
  inputZohoItemId       String
  /// Cantidad de insumo por unidad de salida
  qtyPerOutput          Decimal  @db.Decimal(18, 6)
  unit                  String
  substituteZohoItemIds String[] @default([])
  /// Porcentaje de merma esperado del insumo
  scrapPct              Decimal? @db.Decimal(6, 3)
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  bom                   Bom      @relation(fields: [bomId], references: [id], onDelete: Cascade)

  @@index([bomId])
  @@index([inputZohoItemId])
}

/// Operación de la ruta de una BOM.
model BomOperation {
  id           String   @id @default(cuid())
  bomId        String
  seq          Int
  /// WorkCenter.id
  workCenterId String
  name         String
  stdMinutes   Int
  setupMinutes Int      @default(0)
  qcRequired   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  bom          Bom      @relation(fields: [bomId], references: [id], onDelete: Cascade)

  @@index([bomId, seq])
  @@index([workCenterId])
}

/// Orden de producción (OP-): transformación por defecto o por BOM.
model ProductionOrder {
  id                 String                @id @default(cuid())
  /// Folio OP-
  number             String                @unique
  /// transformation | bom
  kind               String                @default("transformation")
  bomId              String?
  caseId             String?
  /// CaseDemand.id
  demandId           String?
  /// DemandAllocation.id (source manufacture)
  demandAllocationId String?
  outputZohoItemId   String
  outputName         String?
  plannedQty         Decimal               @db.Decimal(18, 4)
  plannedUnit        String
  producedQty        Decimal               @default(0) @db.Decimal(18, 4)
  scrapQty           Decimal               @default(0) @db.Decimal(18, 4)
  leftoverQty        Decimal               @default(0) @db.Decimal(18, 4)
  /// draft | reserved | prepared | in_progress | inspection | completed | released | cancelled | blocked
  status             String                @default("draft")
  /// normal | high | urgent
  priority           String                @default("normal")
  plannedStartAt     DateTime?
  plannedEndAt       DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  workCenterId       String?
  /// inventory | logistics
  releaseTarget      String                @default("inventory")
  /// Warehouse.id donde se libera la salida (obligatorio: produce/recordOutput necesita bodega)
  outputWarehouseId  String
  outputLocationId   String?
  blockedReason      String?
  /// Transformación: [{zohoItemId, qty, unit}]
  inputs             Json?
  createdByUserId    String
  version            Int                   @default(1)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  operations         ProductionOperation[]
  consumptions       MaterialConsumption[]
  outputs            ProductionOutput[]
  qualityChecks      QualityCheck[]

  @@index([status, plannedStartAt])
  @@index([status, createdAt])
  @@index([workCenterId, plannedStartAt])
  @@index([caseId])
  @@index([demandId])
  @@index([demandAllocationId])
  @@index([bomId])
  @@index([outputZohoItemId, status])
  @@index([createdByUserId, status])
}

/// Operación de una orden de producción (WIP y minutos reales).
model ProductionOperation {
  id                String          @id @default(cuid())
  productionOrderId String
  seq               Int
  /// WorkCenter.id
  workCenterId      String
  name              String
  /// pending | running | paused | done | skipped
  status            String          @default("pending")
  assignedUserId    String?
  plannedStartAt    DateTime?
  /// Minutos planeados (estándar + preparación) para capacity-rules
  plannedMinutes    Int?
  startedAt         DateTime?
  finishedAt        DateTime?
  actualMinutes     Int?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  @@index([productionOrderId, seq])
  @@index([workCenterId, status, plannedStartAt])
  @@index([assignedUserId, status])
}

/// Consumo de material de una orden de producción (planeado, real o sustitución).
model MaterialConsumption {
  id                       String          @id @default(cuid())
  productionOrderId        String
  operationId              String?
  inputZohoItemId          String
  stockItemId              String?
  /// StockReservation.id contra la que se consume
  reservationId            String?
  qtyPlanned               Decimal         @default(0) @db.Decimal(18, 4)
  qtyActual                Decimal         @default(0) @db.Decimal(18, 4)
  unit                     String
  /// planned | actual | substitution
  kind                     String
  substitutedForZohoItemId String?
  stockMovementId          String?
  /// ApprovalRequest.id (production_incident) para sustituciones fuera de BOM
  approvalRequestId        String?
  recordedByUserId         String
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  productionOrder          ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  @@index([productionOrderId, kind])
  @@index([operationId])
  @@index([inputZohoItemId, createdAt])
  @@index([reservationId])
  @@index([stockItemId])
  @@index([stockMovementId])
  @@index([approvalRequestId])
}

/// Salida de producción: terminado, merma o sobrante (con dimensiones si es vendible).
model ProductionOutput {
  id                String          @id @default(cuid())
  productionOrderId String
  /// finished | scrap | leftover
  kind              String
  zohoItemId        String
  qty               Decimal         @db.Decimal(18, 4)
  unit              String
  /// Sobrante vendible: {largo, ancho, espesor, unidad}
  dimensions        Json?
  stockMovementId   String?
  stockItemId       String?
  locationId        String?
  qualityCheckId    String?
  recordedByUserId  String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  @@index([productionOrderId, kind])
  @@index([zohoItemId, createdAt])
  @@index([stockMovementId])
  @@index([stockItemId])
  @@index([qualityCheckId])
}

/// Inspección de calidad de una orden u operación.
model QualityCheck {
  id                String          @id @default(cuid())
  productionOrderId String
  operationId       String?
  /// pass | fail | conditional
  result            String
  /// [{item, ok, note}]
  checklist         Json?
  notes             String?
  evidenceObjectIds String[]        @default([])
  inspectedByUserId String
  inspectedAt       DateTime        @default(now())
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  @@index([productionOrderId, inspectedAt])
  @@index([operationId])
  @@index([result, inspectedAt])
  @@index([inspectedByUserId, inspectedAt])
}

// ===== Contabilidad interna (plan UNIK Neural Operations) =====

/// Cuenta de caja/banco interna. currentBalance lo actualiza ledger-service al contabilizar.
model CashAccount {
  id             String   @id @default(cuid())
  key            String   @unique
  name           String
  /// cash | bank | card | petty_cash | digital
  kind           String
  currency       String   @default("MXN")
  openingBalance Decimal  @default(0) @db.Decimal(18, 4)
  currentBalance Decimal  @default(0) @db.Decimal(18, 4)
  /// active | closed
  status         String   @default("active")
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, kind])
}

/// Catálogo de categorías de ingreso/egreso (árbol por parentId).
model FinanceCategory {
  id                  String   @id @default(cuid())
  key                 String   @unique
  name                String
  /// income | expense | transfer | payroll | tax | debt
  kind                String
  /// Costo directo (atribuible a venta/proyecto)
  isDirect            Boolean  @default(false)
  /// FinanceCategory.id padre
  parentId            String?
  /// CostCenter.id sugerido
  defaultCostCenterId String?
  /// active | archived
  status              String   @default("active")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([kind, status])
  @@index([parentId])
  @@index([defaultCostCenterId])
}

/// Centro de costo (árbol por parentId, opcionalmente ligado a un área).
model CostCenter {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  /// Area.key
  areaKey   String?
  /// CostCenter.id padre
  parentId  String?
  /// active | archived
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([areaKey])
  @@index([parentId])
  @@index([status])
}

/// Asiento contable de partida doble. No se edita: la única corrección es un asiento reversal.
model LedgerEntry {
  id                String       @id @default(cuid())
  /// Folio AS-
  number            String       @unique
  /// income | expense | transfer | obligation | settlement | payroll | adjustment | reversal | close
  kind              String
  date              DateTime     @db.Date
  /// YYYY-MM
  periodKey         String
  description       String
  currency          String       @default("MXN")
  /// expense | obligation | payroll_run | procurement_order | period_close | ...
  sourceType        String?
  sourceId          String?
  /// LedgerEntry.id que este asiento revierte (sólo kind=reversal)
  reversesEntryId   String?      @unique
  /// LedgerEntry.id del asiento que revirtió a éste
  reversedByEntryId String?
  postedByUserId    String
  postedAt          DateTime     @default(now())
  evidenceObjectIds String[]     @default([])
  meta              Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  lines             LedgerLine[]

  @@index([periodKey])
  @@index([sourceType, sourceId])
  @@index([kind, date])
  @@index([date])
  @@index([postedByUserId, postedAt])
}

/// Renglón de un asiento. Sólo inserción (sin updatedAt). Σdebit = Σcredit por asiento.
model LedgerLine {
  id                 String      @id @default(cuid())
  entryId            String
  seq                Int
  /// cash | category | receivable | payable | equity | clearing
  accountType        String
  /// CashAccount.id, FinanceCategory.id, Obligation.id o clave de cuenta según accountType
  accountId          String
  debit              Decimal     @default(0) @db.Decimal(18, 4)
  credit             Decimal     @default(0) @db.Decimal(18, 4)
  costCenterId       String?
  /// OperationalCase.id
  caseId             String?
  procurementOrderId String?
  projectRef         String?
  memo               String?
  createdAt          DateTime    @default(now())
  entry              LedgerEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, seq])
  @@index([accountType, accountId])
  @@index([caseId])
  @@index([costCenterId])
  @@index([procurementOrderId])
}

/// Cuenta por pagar o por cobrar esperada (ingreso esperado vs cobro real).
model Obligation {
  id                 String                 @id @default(cuid())
  /// Folio OB-
  number             String                 @unique
  /// payable | receivable
  kind               String
  /// supplier | customer | employee | tax | lender | other
  counterpartyType   String
  counterpartyName   String?
  supplierId         String?
  zohoContactId      String?
  employeeId         String?
  /// OperationalCase.id
  caseId             String?
  procurementOrderId String?
  payrollRunId       String?
  expenseId          String?
  zohoSalesOrderId   String?
  zohoInvoiceId      String?
  description        String
  currency           String                 @default("MXN")
  expectedAmount     Decimal                @db.Decimal(18, 4)
  settledAmount      Decimal                @default(0) @db.Decimal(18, 4)
  dueAt              DateTime?
  expectedCashAt     DateTime?
  /// expected | partially_settled | settled | written_off | cancelled
  status             String                 @default("expected")
  /// FinanceCategory.id (obligatorio: presupuesto contra real y cierre por categoría)
  categoryId         String
  costCenterId       String?
  /// LedgerEntry.id del asiento kind=obligation
  ledgerEntryId      String?
  version            Int                    @default(1)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  settlements        ObligationSettlement[]

  @@index([kind, status, dueAt])
  @@index([zohoSalesOrderId])
  @@index([supplierId])
  @@index([zohoContactId, status])
  @@index([employeeId, status])
  @@index([status, expectedCashAt])
  @@index([caseId])
  @@index([procurementOrderId])
  @@index([payrollRunId])
  @@index([expenseId])
  @@index([zohoInvoiceId])
  @@index([ledgerEntryId])
}

/// Liquidación (parcial o total) de una obligación. Sólo inserción; mueve caja vía su asiento.
/// onDelete Restrict: una obligación con pagos registrados no se borra (se cancela por reverso).
model ObligationSettlement {
  id                String     @id @default(cuid())
  obligationId      String
  /// LedgerEntry.id del asiento kind=settlement
  ledgerEntryId     String
  /// En la moneda de la obligación
  amount            Decimal    @db.Decimal(18, 4)
  settledAt         DateTime   @default(now())
  cashAccountId     String?
  /// CustomerPayment.zohoPaymentId conciliado; un pago puede repartirse entre varias obligaciones (FIFO)
  zohoPaymentId     String?
  /// Llave de idempotencia: zoho_payment:{zohoPaymentId}:{obligationId} (finance.reconcile_collections)
  externalRef       String?    @unique
  evidenceObjectIds String[]   @default([])
  createdByUserId   String
  createdAt         DateTime   @default(now())
  obligation        Obligation @relation(fields: [obligationId], references: [id], onDelete: Restrict)

  @@index([obligationId, settledAt])
  @@index([ledgerEntryId])
  @@index([cashAccountId, settledAt])
  @@index([zohoPaymentId])
}

/// Gasto capturado (formulario, texto, voz, foto, plantilla o recurrente).
model Expense {
  id                String         @id @default(cuid())
  /// Folio GX-
  number            String         @unique
  /// draft | pending_approval | approved | posted | rejected
  status            String         @default("draft")
  /// form | text | voice | photo | template | recurring
  captureMode       String         @default("form")
  rawInput          String?
  /// Propuesta de finance.expense_propose (proveedor, categoría, importe, centro, split)
  aiProposal        Json?
  /// 0 mientras el borrador no tiene importe confirmado/propuesto
  amount            Decimal        @default(0) @db.Decimal(18, 4)
  currency          String         @default("MXN")
  date              DateTime       @db.Date
  supplierId        String?
  supplierNameFree  String?
  categoryId        String?
  costCenterId      String?
  cashAccountId     String?
  /// cash | transfer | card | other
  paymentMethod     String?
  /// false ⇒ al contabilizar se crea Obligation payable
  isPaid            Boolean        @default(true)
  description       String?
  receiptObjectIds  String[]       @default([])
  /// sha256 del comprobante
  receiptHash       String?
  /// importe|fecha|proveedor normalizados (duplicado exacto)
  duplicateKey      String?
  /// Expense.id del posible original
  duplicateOfId     String?
  /// none | suspect | confirmed_unique | confirmed_duplicate
  duplicateStatus   String         @default("none")
  approvalRequestId String?
  ledgerEntryId     String?
  obligationId      String?
  templateId        String?
  /// OperationalCase.id
  caseId            String?
  createdByUserId   String
  approvedByUserId  String?
  postedAt          DateTime?
  rejectedReason    String?
  version           Int            @default(1)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  splits            ExpenseSplit[]

  @@index([duplicateKey])
  @@index([status, date])
  @@index([createdByUserId, status])
  @@index([date])
  @@index([receiptHash])
  @@index([duplicateOfId])
  @@index([supplierId, date])
  @@index([categoryId, date])
  @@index([costCenterId, date])
  @@index([approvalRequestId])
  @@index([templateId])
  @@index([caseId])
}

/// Reparto de un gasto entre centros de costo, expedientes o proyectos.
model ExpenseSplit {
  id           String   @id @default(cuid())
  expenseId    String
  costCenterId String?
  /// OperationalCase.id
  caseId       String?
  projectRef   String?
  /// En la moneda del gasto
  amount       Decimal  @db.Decimal(18, 4)
  /// Porcentaje 0–100 (33.3333 = 33.3333 %)
  pct          Decimal? @db.Decimal(7, 4)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  expense      Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@index([costCenterId])
  @@index([caseId])
}

/// Plantilla de gasto frecuente o recurrente (job finance.recurring_expenses).
model ExpenseTemplate {
  id              String    @id @default(cuid())
  name            String
  categoryId      String
  costCenterId    String?
  supplierId      String?
  defaultAmount   Decimal?  @db.Decimal(18, 4)
  currency        String    @default("MXN")
  /// {freq: daily|weekly|monthly|yearly, interval, dayOfMonth?, weekday?} o null si no es recurrente
  recurrence      Json?
  nextRunAt       DateTime?
  active          Boolean   @default(true)
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([active, nextRunAt])
  @@index([createdByUserId])
  @@index([categoryId])
}

/// Presupuesto por periodo; "" en costCenterId/categoryId = todos.
model Budget {
  id           String   @id @default(cuid())
  /// YYYY-MM
  periodKey    String
  /// CostCenter.id o "" (sin centro)
  costCenterId String   @default("")
  /// FinanceCategory.id o "" (sin categoría)
  categoryId   String   @default("")
  amount       Decimal  @db.Decimal(18, 4)
  currency     String   @default("MXN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([periodKey, costCenterId, categoryId])
  @@index([costCenterId, periodKey])
  @@index([categoryId, periodKey])
}

/// Directorio de empleados para nómina y anticipos (no todo empleado tiene login).
model Employee {
  id           String   @id @default(cuid())
  /// Folio EMP-
  number       String   @unique
  name         String
  position     String?
  /// User.id si tiene acceso al sistema
  userId       String?  @unique
  /// Area.key
  areaKey      String?
  costCenterId String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active, name])
  @@index([areaKey])
  @@index([costCenterId])
}

/// Corrida de nómina: aprobación → una Obligation payable employee por línea → pagos.
model PayrollRun {
  id                String        @id @default(cuid())
  /// Folio NOM-
  number            String        @unique
  /// YYYY-MM
  periodKey         String
  periodStart       DateTime      @db.Date
  periodEnd         DateTime      @db.Date
  /// draft | pending_approval | approved | obligations_created | paid | closed | cancelled
  status            String        @default("draft")
  currency          String        @default("MXN")
  totalGross        Decimal       @default(0) @db.Decimal(18, 4)
  totalDeductions   Decimal       @default(0) @db.Decimal(18, 4)
  totalNet          Decimal       @default(0) @db.Decimal(18, 4)
  approvalRequestId String?
  createdByUserId   String
  version           Int           @default(1)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  lines             PayrollLine[]

  @@index([periodKey, status])
  @@index([status, createdAt])
  @@index([approvalRequestId])
  @@index([createdByUserId])
}

/// Línea de nómina por empleado (anticipos = Obligation receivable employee).
model PayrollLine {
  id              String     @id @default(cuid())
  payrollRunId    String
  employeeId      String
  gross           Decimal    @db.Decimal(18, 4)
  /// [{kind, label, amount}]
  deductions      Json       @default("[]")
  advancesApplied Decimal    @default(0) @db.Decimal(18, 4)
  net             Decimal    @db.Decimal(18, 4)
  costCenterId    String?
  /// Obligation.id (payable employee)
  obligationId    String?
  /// pending | paid
  status          String     @default("pending")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  payrollRun      PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
  @@index([obligationId])
}

/// Cierre diario o mensual; closed ⇒ ledger-service rechaza asientos del periodo.
model PeriodClose {
  id             String    @id @default(cuid())
  /// YYYY-MM (monthly) o YYYY-MM-DD (daily)
  periodKey      String
  /// daily | monthly
  kind           String
  /// open | closing | closed | reopened
  status         String    @default("open")
  closedByUserId String?
  closedAt       DateTime?
  /// Saldos, presupuesto vs real, antigüedad AR/AP, proyectado vs realizado
  snapshot       Json?
  /// Resultado de close-rules.ts [{key, ok, detail}]
  checks         Json?
  reopenReason   String?
  version        Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([periodKey, kind])
  @@index([kind, status])
}

// ===== Ventas / CRM (plan UNIK Neural Operations) =====

/// Etapa del embudo comercial (editable en admin).
model PipelineStage {
  id                 String   @id @default(cuid())
  key                String   @unique
  name               String
  order              Int
  /// Probabilidad por defecto 0–1
  probabilityDefault Decimal  @default(0) @db.Decimal(4, 3)
  /// open | won | lost
  kind               String   @default("open")
  /// Horas máximas en la etapa antes de alertar (null = sin SLA)
  slaHours           Int?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([active, order])
}

/// Oportunidad de venta ligada a conversaciones, llamadas, cotizaciones, órdenes y expedientes.
model Opportunity {
  id                String                @id @default(cuid())
  /// Folio OPP-
  number            String                @unique
  title             String
  /// Contact.id del módulo de comunicaciones
  commContactId     String?
  zohoContactId     String?
  contactName       String
  salespersonUserId String
  /// PipelineStage.id
  stageId           String
  stageEnteredAt    DateTime              @default(now())
  estimatedValue    Decimal?              @db.Decimal(18, 4)
  currency          String                @default("MXN")
  /// 0–1 (null = usar probabilityDefault de la etapa)
  probability       Decimal?              @db.Decimal(4, 3)
  expectedCloseAt   DateTime?
  nextActionAt      DateTime?
  nextActionText    String?
  /// inbox | call | manual | quote | web
  source            String                @default("manual")
  conversationIds   String[]              @default([])
  voiceCallIds      String[]              @default([])
  zohoEstimateIds   String[]              @default([])
  zohoSalesOrderIds String[]              @default([])
  /// OperationalCase.id
  caseIds           String[]              @default([])
  /// open | won | lost | dormant
  status            String                @default("open")
  lostReason        String?
  wonAt             DateTime?
  lostAt            DateTime?
  lastActivityAt    DateTime              @default(now())
  lastInboundAt     DateTime?
  lastOutboundAt    DateTime?
  tags              String[]              @default([])
  version           Int                   @default(1)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  activities        OpportunityActivity[]

  @@index([salespersonUserId, status])
  @@index([commContactId])
  @@index([zohoContactId])
  @@index([stageId])
  @@index([nextActionAt])
  @@index([status, lastActivityAt])
  @@index([status, expectedCloseAt])
  @@index([conversationIds], type: Gin)
  @@index([voiceCallIds], type: Gin)
  @@index([zohoEstimateIds], type: Gin)
  @@index([zohoSalesOrderIds], type: Gin)
  @@index([caseIds], type: Gin)
}

/// Línea de tiempo de una oportunidad. Sólo inserción (sin updatedAt).
model OpportunityActivity {
  id            String      @id @default(cuid())
  opportunityId String
  /// note | message_in | message_out | call | quote_sent | quote_viewed | quote_accepted | quote_declined | stage_change | order_created | task | objection | objection_resolved | ai_suggestion
  kind          String
  /// message | voice_call | quote | sales_order | case | work_item | ...
  refType       String?
  refId         String?
  summary       String
  payload       Json?
  /// null = sistema/IA
  userId        String?
  at            DateTime    @default(now())
  createdAt     DateTime    @default(now())
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId, at])
  @@index([refType, refId])
  @@index([kind, at])
  @@index([userId, at])
}

/// Ledger idempotente de escrituras de órdenes de venta a Zoho (espejo de QuoteWriteRequest).
model SalesOrderWriteRequest {
  id               String    @id @default(cuid())
  requestKey       String    @unique
  operation        String
  userId           String
  opportunityId    String?
  /// Quote.id local
  quoteId          String?
  zohoEstimateId   String?
  /// SalesOrder.id local
  salesOrderId     String?
  zohoSalesOrderId String?
  /// pending | completed | failed
  status           String    @default("pending")
  errorMessage     String?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([opportunityId])
  @@index([quoteId])
  @@index([zohoSalesOrderId])
}

/// Señal del radar comercial calculada por radar-rules.ts (una por kind+subjectKey).
model RadarSignal {
  id                 String    @id @default(cuid())
  /// no_first_reply | no_followup | quote_expiring | next_action_overdue | objection_open | high_intent | repurchase_overdue | delivery_incident
  kind               String
  /// Sujeto de la regla (p. ej. conversationId, quoteId, opportunityId, zohoContactId)
  subjectKey         String
  opportunityId      String?
  conversationId     String?
  quoteId            String?
  zohoContactId      String?
  commContactId      String?
  customerName       String?
  salespersonUserId  String?
  /// 0–100
  score              Int
  /// Explicación determinista en español con cifras
  reason             String
  data               Json?
  computedAt         DateTime  @default(now())
  expiresAt          DateTime
  /// active | snoozed | dismissed | resolved
  status             String    @default("active")
  snoozedUntil       DateTime?
  aiExplanation      String?
  aiSuggestedMessage String?
  aiGeneratedAt      DateTime?
  version            Int       @default(1)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([kind, subjectKey])
  @@index([salespersonUserId, status, score])
  @@index([status, expiresAt])
  @@index([status, snoozedUntil])
  @@index([opportunityId])
  @@index([conversationId])
  @@index([zohoContactId])
}

// ===== Dashboards y Control Tower (plan UNIK Neural Operations) =====

/// Caché del dashboard por alcance, refrescada por el job areas.dashboard_refresh (una fila por scopeType+scopeKey).
model DashboardSnapshot {
  id         String   @id @default(cuid())
  /// area | control_tower
  scopeType  String
  /// Area.key para scopeType=area; "" para control_tower
  scopeKey   String   @default("")
  /// Tiles, series y alertas ya calculados
  payload    Json
  computedAt DateTime @default(now())
  /// Duración del cálculo en milisegundos
  durationMs Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([scopeType, scopeKey])
}

/// Proyección: variante observada de un expediente (secuencia de pasos completados y conformidad con el blueprint).
model CtCaseVariant {
  id             String   @id @default(cuid())
  /// OperationalCase.id
  caseId         String   @unique
  processKey     String
  /// ProcessVersion.version con la que corrió el expediente
  processVersion Int
  /// Hash (calculado en TS) de la secuencia de stepKey
  variantHash    String
  /// stepKey en orden de step.completed (occurredAt, id)
  sequence       String[]
  stepCount      Int
  /// Duración de apertura a cierre en minutos (null = expediente abierto)
  durationMin    Int?
  conformant     Boolean
  /// Resultado de checkConformance: [{kind, stepKey, detail}]
  violations     Json?
  /// Pasos (caso, paso) activados más de una vez
  reworkCount    Int      @default(0)
  computedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([processKey, variantHash])
  @@index([processKey, processVersion])
}

/// Proyección diaria de métricas por paso de proceso (día de cierre del paso).
model CtStepMetricDaily {
  id           String   @id @default(cuid())
  day          DateTime @db.Date
  processKey   String
  stepKey      String
  areaKey      String
  started      Int      @default(0)
  completed    Int      @default(0)
  /// Minutos activos (percentile_cont) de los pasos cerrados ese día
  p50ActiveMin Float?
  p90ActiveMin Float?
  avgActiveMin Float?
  /// Minutos en espera (intervalos step.waiting → step.active)
  p50WaitMin   Float?
  p90WaitMin   Float?
  /// Pasos que rebasaron su SLA
  breached     Int      @default(0)
  /// Pasos reactivados (retrabajo)
  reworked     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([day, processKey, stepKey])
  @@index([processKey, day])
  @@index([areaKey, day])
}

/// Proyección diaria de traspasos entre áreas (solicitudes y reasignaciones de work items).
model CtHandoffDaily {
  id             String   @id @default(cuid())
  day            DateTime @db.Date
  fromAreaKey    String
  toAreaKey      String
  /// request | workitem
  kind           String
  count          Int      @default(0)
  /// Minutos hasta el primer acuse o respuesta
  p50ResponseMin Float?
  p90ResponseMin Float?
  expired        Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([day, fromAreaKey, toAreaKey, kind])
  @@index([fromAreaKey, day])
  @@index([toAreaKey, day])
}

/// Proyección diaria de causas de bloqueo (incidencias y waitReason unidos por ObjectRelation).
model CtBlockCauseDaily {
  id         String   @id @default(cuid())
  day        DateTime @db.Date
  /// vendor | product | route | customer | wait_reason
  causeType  String
  /// Id o clave del objeto causante (p. ej. Supplier.id, zohoItemId, waitReason)
  causeKey   String
  causeLabel String
  blocks     Int      @default(0)
  /// Minutos de espera acumulados
  waitMin    Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([day, causeType, causeKey])
  @@index([causeType, day])
}

/// Marca de agua del job ct.projections_refresh (último OperationalEvent.id procesado).
/// OperationalEvent.id se asigna al insertar, no al confirmar: una transacción lenta puede confirmar un id
/// menor que lastEventId. Cada corrida procesa id > lastEventId OR recordedAt >= lastRunAt - 10 min
/// (índice OperationalEvent.recordedAt) con recálculos idempotentes, y guarda en lastRunAt su hora de INICIO.
model CtProjectionWatermark {
  /// Nombre de la proyección (p. ej. variants, step_metrics, handoffs, block_causes)
  key            String   @id
  lastEventId    BigInt   @default(0)
  /// Hora de inicio de la última corrida (base de la ventana de relectura por recordedAt)
  lastRunAt      DateTime
  lastDurationMs Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// Escena guardada del GraphExplorer (raíces, filtros, layout y tiempo fijado).
model CtGraphScene {
  id             String    @id @default(cuid())
  /// User.id del dueño
  userId         String
  name           String
  /// Clave de perspectives.ts
  perspectiveKey String
  /// [{type, id}]
  roots          Json
  filters        Json?
  /// Posiciones de nodos y viewport
  layout         Json?
  /// Instante fijado por TimeSlider (null = ahora)
  at             DateTime?
  /// Visible para otros usuarios con acceso a la perspectiva
  shared         Boolean   @default(false)
  version        Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([shared, perspectiveKey])
}
