generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Technical integration state per external entity.
/// Tracks whether the locally stored version is up to date with the remote one.
model IntegrationEntityState {
  id                         String    @id @default(cuid())
  source                     String
  entityType                 String
  externalId                 String
  remoteModifiedAt           DateTime
  lastSyncedRemoteModifiedAt DateTime?
  needsSync                  Boolean   @default(true)
  lastSeenAt                 DateTime
  lastDetailFetchedAt        DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@unique([source, entityType, externalId])
  @@index([source, entityType, needsSync])
  @@index([source, entityType, needsSync, remoteModifiedAt])
}

/// Immutable RAW payload snapshot of an external entity version.
model IntegrationSnapshot {
  id                     String    @id @default(cuid())
  source                 String
  entityType             String
  externalId             String
  remoteModifiedAt       DateTime
  payload                Json
  fetchedAt              DateTime
  normalizedAt           DateTime?
  normalizationVersion   Int       @default(0)
  normalizationErrorCode String?
  createdAt              DateTime  @default(now())

  @@unique([source, entityType, externalId, remoteModifiedAt])
  @@index([source, entityType, externalId])
  @@index([source, entityType, normalizationVersion])
}

/// Technical metadata about a single synchronization execution.
/// Never stores payloads, tokens or personal information.
model IntegrationSyncRun {
  id             String    @id @default(cuid())
  source         String
  entityType     String
  mode           String
  status         String
  startedAt      DateTime
  completedAt    DateTime?
  pagesScanned   Int       @default(0)
  recordsSeen    Int       @default(0)
  recordsPending Int       @default(0)
  detailsFetched Int       @default(0)
  detailsFailed  Int       @default(0)
  apiCalls       Int       @default(0)
  errorCode      String?
  createdAt      DateTime  @default(now())

  @@index([source, entityType, startedAt])
}

/// Configurable runtime parameters for one integration source.
/// Stored as JSON so each integration can extend its own settings without
/// migrating the schema. Updated from the admin UI; read by the scheduler
/// and sync workers on every tick so changes apply immediately.
model IntegrationConfig {
  id          String   @id @default(cuid())
  source      String   @unique
  displayName String
  isEnabled   Boolean  @default(true)
  /// Free-form JSON bag: intervals, timeouts, maxDetailFetches, quotas, etc.
  settings    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// One row per outbound API call made to any integration.
/// Captures method, path, status, duration, error and a truncated preview
/// of the response payload for observability. Never stores auth tokens.
model IntegrationApiCall {
  id              String   @id @default(cuid())
  source          String
  method          String
  path            String
  httpStatus      Int?
  durationMs      Int
  success         Boolean
  errorCode       String?
  /// Truncated preview of the response body (max ~4KB) for debugging.
  responsePreview String?
  createdAt       DateTime @default(now())

  @@index([source, createdAt])
  @@index([source, success, createdAt])
}

/// Business-normalized view of a Zoho sales order.
model SalesOrder {
  id                     String           @id @default(cuid())
  zohoSalesOrderId       String           @unique
  salesOrderNumber       String?
  referenceNumber        String?
  orderDate              DateTime?        @db.Date
  createdTime            DateTime?
  status                 String?
  subStatus              String?
  paidStatus             String?
  invoicedStatus         String?
  shippedStatus          String?
  zohoCustomerId         String?
  customerName           String?
  customerEmail          String?
  customerPhone          String?
  zohoSalespersonId      String?
  salespersonName        String?
  paymentMethod          String?
  deliveryMethod         String?
  deliveryMethodId       String?
  locationId             String?
  locationName           String?
  branchId               String?
  branchName             String?
  shippingAttention      String?
  shippingAddressLine1   String?
  shippingAddressLine2   String?
  shippingCity           String?
  shippingState          String?
  shippingPostalCode     String?
  shippingCountry        String?
  shippingPhone          String?
  currencyCode           String?
  subtotal               Decimal?         @db.Decimal(18, 4)
  discountTotal          Decimal?         @db.Decimal(18, 4)
  taxTotal               Decimal?         @db.Decimal(18, 4)
  shippingCharge         Decimal?         @db.Decimal(18, 4)
  adjustment             Decimal?         @db.Decimal(18, 4)
  total                  Decimal?         @db.Decimal(18, 4)
  balance                Decimal?         @db.Decimal(18, 4)
  notes                  String?
  saleMadeInWarehouse    Boolean?
  sourceRemoteModifiedAt DateTime
  sourceSnapshotId       String
  normalizedAt           DateTime         @default(now())
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  items                  SalesOrderItem[]

  @@index([salesOrderNumber])
  @@index([status])
  @@index([customerName])
  @@index([paymentMethod])
  @@index([deliveryMethod])
  @@index([salespersonName])
  @@index([orderDate])
  @@index([locationName])
  @@index([sourceSnapshotId])
}

/// Application user account. Users are never hard-deleted from the UI;
/// they are activated/deactivated to preserve history and relations.
model User {
  id                   String                               @id @default(cuid())
  username             String                               @unique
  email                String?                              @unique
  name                 String
  passwordHash         String
  isActive             Boolean                              @default(true)
  mustChangePassword   Boolean                              @default(true)
  failedLoginAttempts  Int                                  @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  passwordChangedAt    DateTime?
  createdAt            DateTime                             @default(now())
  updatedAt            DateTime                             @updatedAt
  roles                UserRole[]
  sessions             AuthSession[]
  tablePreferences     UserTablePreference[]
  tableViews           TableView[]
  entityWatches        EntityWatch[]
  notifications        Notification[]
  pushSubscriptions    PushSubscription[]
  notificationSettings UserNotificationSettings?
  aiConversations      AiConversation[]
  chatMemberships      InternalChatMember[]
  chatMessages         InternalChatMessage[]
  chatReactions        InternalChatReaction[]
  chatReadReceipts     InternalChatReadReceipt[]
  chatPresence         InternalChatPresence?
  chatMentions         InternalChatMention[]
  chatPollVotes        InternalChatPollVote[]
  chatEventRsvps       InternalChatEventRsvp[]
  chatPins             InternalChatPinnedMessage[]
  chatBookmarks        InternalChatBookmark[]
  chatSnippets         InternalChatSnippet[]
  chatScheduledMsgs    InternalChatScheduledMessage[]
  chatNotifPrefs       InternalChatNotificationPreference[]
  chatCallParticipants InternalChatCallParticipant[]
  chatCallsInitiated   InternalChatCall[]

  @@index([isActive])
}

/// Authorization role. `key` is generated at creation time and is immutable.
model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(false)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]
}

/// Join table between User and Role.
model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

/// Permission assigned to a role. permissionKey references the code-first
/// permission registry (src/modules/auth/permissions.ts); it is validated
/// against that registry before being persisted.
model RolePermission {
  roleId        String
  permissionKey String
  createdAt     DateTime @default(now())
  role          Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
}

/// Server-side authentication session. Only the SHA-256 hash of the session
/// token is stored; the raw token lives exclusively in the HttpOnly cookie.
model AuthSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

/// Generic audit log for administrative and security events.
/// Never stores passwords, hashes, session tokens or cookies.
model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  targetType  String
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([createdAt])
  @@index([action])
}

/// Business-normalized line items of a Zoho sales order.
model SalesOrderItem {
  id             String     @id @default(cuid())
  salesOrderId   String
  zohoLineItemId String?
  zohoItemId     String?
  sku            String?
  name           String?
  description    String?
  quantity       Decimal?   @db.Decimal(18, 4)
  unit           String?
  rate           Decimal?   @db.Decimal(18, 4)
  discountAmount Decimal?   @db.Decimal(18, 4)
  taxName        String?
  taxPercentage  Decimal?   @db.Decimal(18, 4)
  taxAmount      Decimal?   @db.Decimal(18, 4)
  lineTotal      Decimal?   @db.Decimal(18, 4)
  locationId     String?
  locationName   String?
  sortOrder      Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  salesOrder     SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([salesOrderId])
}

/// Business-normalized view of a Zoho contact (customer or vendor).
/// A single Zoho /contacts resource with contact_type=customer|vendor.
/// One Prisma model, one sync pipeline, two UI modules that filter by contactType.
model Contact {
  id                        String   @id @default(cuid())
  zohoContactId             String   @unique
  contactType               String?
  contactName               String?
  companyName               String?
  currencyCode              String?
  paymentTerms              Int?
  paymentTermsLabel         String?
  status                    String?
  outstandingReceivable     Decimal? @db.Decimal(18, 4)
  outstandingPayable        Decimal? @db.Decimal(18, 4)
  unusedCreditsReceivable   Decimal? @db.Decimal(18, 4)
  unusedCreditsPayable      Decimal? @db.Decimal(18, 4)
  primaryEmail              String?
  primaryPhone              String?
  website                   String?
  languageCode              String?
  // Mexico fiscal fields (normalized when present in payload)
  taxRegNo                  String?
  taxTreatment              String?
  taxRegime                 String?
  legalName                 String?
  isTdsRegistered           Boolean?
  // Address fields (from Zoho LIST payload)
  billingAddress            String?
  billingCity               String?
  billingState              String?
  billingZip                String?
  billingCountry            String?
  billingFax                String?
  shippingAddress           String?
  shippingCity              String?
  shippingState             String?
  shippingZip               String?
  shippingCountry           String?
  shippingFax               String?
  // Contact person fields
  firstName                 String?
  lastName                  String?
  mobile                    String?
  designation               String?
  department                String?
  // Additional Zoho fields
  customerSubType           String?
  portalStatus              String?
  ownerName                 String?
  source                    String?
  photoUrl                  String?
  primaryContactId          String?
  creditLimitExceededAmount Decimal? @db.Decimal(18, 4)
  notes                     String?
  // Sync tracking
  sourceRemoteModifiedAt    DateTime
  sourceSnapshotId          String
  normalizedAt              DateTime @default(now())
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([contactType])
  @@index([contactName])
  @@index([companyName])
  @@index([status])
  @@index([sourceSnapshotId])
}

/// Business-normalized view of a Zoho Inventory item (product).
/// Hydrated via bulk /itemdetails for efficiency.
model Product {
  id                       String    @id @default(cuid())
  zohoItemId               String    @unique
  name                     String?
  sku                      String?
  status                   String?
  productType              String?
  description              String?
  rate                     Decimal?  @db.Decimal(18, 4)
  unit                     String?
  currencyCode             String?
  taxName                  String?
  taxPercentage            Decimal?  @db.Decimal(18, 4)
  isTaxable                Boolean?
  stockOnHand              Decimal?  @db.Decimal(18, 4)
  availableStock           Decimal?  @db.Decimal(18, 4)
  reorderLevel             Decimal?  @db.Decimal(18, 4)
  purchaseRate             Decimal?  @db.Decimal(18, 4)
  categoryName             String?
  categoryId               String?
  manufacturer             String?
  brand                    String?
  zohoVendorId             String?
  vendorName               String?
  // Mexico fiscal / SAT fields (normalized when present in payload)
  satProductCode           String?
  satUnitCode              String?
  // Additional Zoho fields (already in snapshot via passthrough)
  itemType                 String?
  source                   String?
  taxPreference            String?
  purchaseTaxName          String?
  purchaseAccountName      String?
  salesAccountName         String?
  inventoryAccountName     String?
  inventoryValuationMethod String?
  zohoCreatedTime          DateTime?
  zohoLastModifiedTime     DateTime?
  // Sync tracking
  sourceRemoteModifiedAt   DateTime
  sourceSnapshotId         String
  normalizedAt             DateTime  @default(now())
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([name])
  @@index([sku])
  @@index([status])
  @@index([categoryName])
  @@index([sourceSnapshotId])
}

/// Business-normalized view of a Zoho Inventory package (shipment).
/// Preserves source traceability through raw snapshots.
model Package {
  id                     String        @id @default(cuid())
  zohoPackageId          String        @unique
  packageNumber          String?
  status                 String?
  date                   DateTime?
  shipmentType           String?
  carrier                String?
  trackingNumber         String?
  deliveryMethod         String?
  shippingCharge         Decimal?      @db.Decimal(18, 4)
  zohoSalesOrderId       String?
  zohoCustomerId         String?
  customerName           String?
  // Shipping address (from DETAIL fetch - lazy)
  shippingAttention      String?
  shippingAddress        String?
  shippingCity           String?
  shippingState          String?
  shippingZip            String?
  shippingCountry        String?
  shippingPhone          String?
  // Additional fields
  shipmentDate           DateTime?
  shipmentStatus         String?
  isCarrierShipment      Boolean?
  isTrackingEnabled      Boolean?
  labelFormat            String?
  salesChannel           String?
  salesorderNumber       String?
  quantity               Decimal?      @db.Decimal(18, 4)
  // Shipment order (Zoho "orden de envío", e.g. NE-28815) — carrier lives here once shipped
  zohoShipmentId         String?
  shipmentNumber         String?
  deliveryDate           DateTime?
  trackingUrl            String?
  notes                  String?
  // Detail fetch tracking
  lastDetailFetchedAt    DateTime?
  // Sync tracking
  sourceRemoteModifiedAt DateTime
  sourceSnapshotId       String
  normalizedAt           DateTime      @default(now())
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  items                  PackageItem[]

  @@index([status])
  @@index([zohoSalesOrderId])
  @@index([zohoCustomerId])
  @@index([sourceSnapshotId])
}

/// Business-normalized line items of a Zoho package.
model PackageItem {
  id          String   @id @default(cuid())
  packageId   String
  zohoItemId  String?
  name        String?
  sku         String?
  description String?
  quantity    Decimal? @db.Decimal(18, 4)
  unit        String?
  sortOrder   Int      @default(0)
  package     Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@index([zohoItemId])
}

/// Business-normalized view of a Zoho Inventory invoice.
/// Includes Mexican CFDI fields. Does NOT use sort_column=last_modified_time.
/// Invoice payments are invoice-scoped and lazy (not stored in V1).
model Invoice {
  id                     String        @id @default(cuid())
  zohoInvoiceId          String        @unique
  invoiceNumber          String?
  status                 String?
  date                   DateTime?
  dueDate                DateTime?
  zohoCustomerId         String?
  customerName           String?
  currencyCode           String?
  subTotal               Decimal?      @db.Decimal(18, 4)
  taxTotal               Decimal?      @db.Decimal(18, 4)
  discountTotal          Decimal?      @db.Decimal(18, 4)
  shippingCharge         Decimal?      @db.Decimal(18, 4)
  total                  Decimal?      @db.Decimal(18, 4)
  balance                Decimal?      @db.Decimal(18, 4)
  salespersonName        String?
  // Mexico CFDI fields (normalized when present in payload)
  cfdiUuid               String?
  cfdiVersion            String?
  usoCfdi                String?
  metodoPago             String?
  formaPago              String?
  regimenFiscal          String?
  cfdiExportacion        String?
  // Address fields (from LIST payload)
  billingAddress         String?
  billingCity            String?
  billingState           String?
  billingZip             String?
  billingCountry         String?
  shippingAddress        String?
  shippingCity           String?
  shippingState          String?
  shippingZip            String?
  shippingCountry        String?
  // Additional fields
  notes                  String?
  terms                  String?
  referenceNumber        String?
  exchangeRate           Decimal?      @db.Decimal(18, 6)
  discount               Decimal?      @db.Decimal(18, 4)
  discountType           String?
  isDiscountBeforeTax    Boolean?
  zohoCreatedTime        DateTime?
  zohoLastModifiedTime   DateTime?
  // Sync tracking
  sourceRemoteModifiedAt DateTime
  sourceSnapshotId       String
  normalizedAt           DateTime      @default(now())
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  items                  InvoiceItem[]

  @@index([status])
  @@index([zohoCustomerId])
  @@index([date])
  @@index([sourceSnapshotId])
}

/// Business-normalized line items of a Zoho invoice.
/// Links to Sales Orders via salesorder_item_id / salesorder_id.
model InvoiceItem {
  id                   String   @id @default(cuid())
  invoiceId            String
  zohoItemId           String?
  name                 String?
  description          String?
  quantity             Decimal? @db.Decimal(18, 4)
  rate                 Decimal? @db.Decimal(18, 4)
  unit                 String?
  lineTotal            Decimal? @db.Decimal(18, 4)
  taxName              String?
  taxPercentage        Decimal? @db.Decimal(18, 4)
  taxAmount            Decimal? @db.Decimal(18, 4)
  discountAmount       Decimal? @db.Decimal(18, 4)
  zohoSalesOrderId     String?
  zohoSalesOrderItemId String?
  sortOrder            Int      @default(0)
  invoice              Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([zohoItemId])
  @@index([zohoSalesOrderId])
}

/// Daily work digest per user: what they did with UNIK (AI, inbox, chat, sales),
/// KPIs and a narrative the assistant can recall ("¿cómo voy hoy?").
model AiUserDigest {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  narrative String
  metrics   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([date])
}

/// Business-normalized view of a Zoho Books estimate (cotización).
/// Synced via /books/v3/estimates (LIST has no line items → HYDRATE per record).
/// Quotes can also be CREATED/EDITED from UNIK: the write service calls Zoho
/// first, stores the Zoho response as an IntegrationSnapshot and runs the same
/// normalizer, so Zoho is always the source of truth (folios, totals, taxes).
model Quote {
  id                     String      @id @default(cuid())
  zohoEstimateId         String      @unique
  estimateNumber         String?
  referenceNumber        String?
  status                 String?
  date                   DateTime?
  expiryDate             DateTime?
  zohoCustomerId         String?
  customerName           String?
  currencyId             String?
  currencyCode           String?
  exchangeRate           Decimal?    @db.Decimal(18, 6)
  subTotal               Decimal?    @db.Decimal(18, 4)
  taxTotal               Decimal?    @db.Decimal(18, 4)
  discountTotal          Decimal?    @db.Decimal(18, 4)
  discount               Decimal?    @db.Decimal(18, 4)
  discountType           String?
  isDiscountBeforeTax    Boolean?
  isInclusiveTax         Boolean?
  shippingCharge         Decimal?    @db.Decimal(18, 4)
  adjustment             Decimal?    @db.Decimal(18, 4)
  adjustmentDescription  String?
  total                  Decimal?    @db.Decimal(18, 4)
  salespersonId          String?
  salespersonName        String?
  templateId             String?
  templateName           String?
  // Address fields
  billingAddress         String?
  billingStreet2         String?
  billingCity            String?
  billingState           String?
  billingZip             String?
  billingCountry         String?
  shippingAddress        String?
  shippingStreet2        String?
  shippingCity           String?
  shippingState          String?
  shippingZip            String?
  shippingCountry        String?
  // Additional fields
  notes                  String?
  terms                  String?
  customFields           Json?
  isViewedByClient       Boolean?
  acceptedDate           DateTime?
  declinedDate           DateTime?
  zohoCreatedTime        DateTime?
  zohoLastModifiedTime   DateTime?
  // UNIK authorship (null when the quote was created directly in Zoho)
  createdInUnik          Boolean     @default(false)
  createdByUserId        String?
  lastEditedByUserId     String?
  lastEditedInUnikAt     DateTime?
  // Sync tracking
  sourceRemoteModifiedAt DateTime
  sourceSnapshotId       String
  normalizedAt           DateTime    @default(now())
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  items                  QuoteItem[]

  @@index([status])
  @@index([zohoCustomerId])
  @@index([date])
  @@index([expiryDate])
  @@index([estimateNumber])
  @@index([sourceSnapshotId])
}

/// Business-normalized line items of a Zoho Books estimate.
model QuoteItem {
  id             String   @id @default(cuid())
  quoteId        String
  zohoLineItemId String?
  zohoItemId     String?
  sku            String?
  name           String?
  description    String?
  quantity       Decimal? @db.Decimal(18, 4)
  rate           Decimal? @db.Decimal(18, 4)
  unit           String?
  discount       String?
  discountAmount Decimal? @db.Decimal(18, 4)
  taxId          String?
  taxName        String?
  taxPercentage  Decimal? @db.Decimal(18, 4)
  taxAmount      Decimal? @db.Decimal(18, 4)
  lineTotal      Decimal? @db.Decimal(18, 4)
  sortOrder      Int      @default(0)
  quote          Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@index([zohoItemId])
}

/// Idempotency ledger for quote writes that reach Zoho Books.
/// The client generates `requestKey` once per form submission. A retry (double
/// click, network timeout, page refresh) reuses the same key, so the write
/// service can return the already-created quote instead of creating a second
/// estimate in Zoho. Unique constraint = atomic guard against concurrent sends.
model QuoteWriteRequest {
  id             String    @id @default(cuid())
  requestKey     String    @unique
  operation      String
  userId         String
  quoteId        String?
  zohoEstimateId String?
  status         String    @default("pending")
  errorMessage   String?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// Business-normalized view of a Zoho customer payment.
/// Synced via /customerpayments with useListAsSnapshot.
model CustomerPayment {
  id                     String    @id @default(cuid())
  zohoPaymentId          String    @unique
  paymentNumber          String?
  paymentMode            String?
  status                 String?
  date                   DateTime?
  amount                 Decimal?  @db.Decimal(18, 4)
  balance                Decimal?  @db.Decimal(18, 4)
  zohoCustomerId         String?
  customerName           String?
  currencyCode           String?
  referenceNumber        String?
  description            String?
  exchangeRate           Decimal?  @db.Decimal(18, 6)
  bankCharges            Decimal?  @db.Decimal(18, 4)
  // Sync tracking
  sourceRemoteModifiedAt DateTime
  sourceSnapshotId       String
  normalizedAt           DateTime  @default(now())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([zohoCustomerId])
  @@index([date])
  @@index([status])
  @@index([sourceSnapshotId])
}

/// Business-normalized view of a Zoho purchase order.
model PurchaseOrder {
  id                     String              @id @default(cuid())
  zohoPurchaseOrderId    String              @unique
  purchaseOrderNumber    String?
  status                 String?
  date                   DateTime?
  dueDate                DateTime?
  deliveryDate           DateTime?
  zohoVendorId           String?
  vendorName             String?
  currencyCode           String?
  subTotal               Decimal?            @db.Decimal(18, 4)
  taxTotal               Decimal?            @db.Decimal(18, 4)
  discountTotal          Decimal?            @db.Decimal(18, 4)
  shippingCharge         Decimal?            @db.Decimal(18, 4)
  total                  Decimal?            @db.Decimal(18, 4)
  balance                Decimal?            @db.Decimal(18, 4)
  salespersonName        String?
  notes                  String?
  referenceNumber        String?
  // Sync tracking
  sourceRemoteModifiedAt DateTime
  sourceSnapshotId       String
  normalizedAt           DateTime            @default(now())
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  items                  PurchaseOrderItem[]

  @@index([status])
  @@index([zohoVendorId])
  @@index([date])
  @@index([sourceSnapshotId])
}

/// Business-normalized line items of a Zoho purchase order.
model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  zohoItemId      String?
  name            String?
  description     String?
  quantity        Decimal?      @db.Decimal(18, 4)
  rate            Decimal?      @db.Decimal(18, 4)
  unit            String?
  lineTotal       Decimal?      @db.Decimal(18, 4)
  taxName         String?
  taxPercentage   Decimal?      @db.Decimal(18, 4)
  taxAmount       Decimal?      @db.Decimal(18, 4)
  sortOrder       Int           @default(0)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@index([zohoItemId])
}

/// Business-normalized view of a Zoho bill (vendor invoice).
model Bill {
  id                     String    @id @default(cuid())
  zohoBillId             String    @unique
  billNumber             String?
  status                 String?
  date                   DateTime?
  dueDate                DateTime?
  zohoVendorId           String?
  vendorName             String?
  zohoPurchaseOrderId    String?
  currencyCode           String?
  subTotal               Decimal?  @db.Decimal(18, 4)
  taxTotal               Decimal?  @db.Decimal(18, 4)
  total                  Decimal?  @db.Decimal(18, 4)
  balance                Decimal?  @db.Decimal(18, 4)
  vendorCreditsApplied   Decimal?  @db.Decimal(18, 4)
  notes                  String?
  // Sync tracking
  sourceRemoteModifiedAt DateTime
  sourceSnapshotId       String
  normalizedAt           DateTime  @default(now())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([status])
  @@index([zohoVendorId])
  @@index([zohoPurchaseOrderId])
  @@index([date])
  @@index([sourceSnapshotId])
}

/// Business-normalized view of a Zoho vendor credit.
model VendorCredit {
  id                     String    @id @default(cuid())
  zohoVendorCreditId     String    @unique
  vendorCreditNumber     String?
  status                 String?
  date                   DateTime?
  zohoVendorId           String?
  vendorName             String?
  currencyCode           String?
  total                  Decimal?  @db.Decimal(18, 4)
  balance                Decimal?  @db.Decimal(18, 4)
  notes                  String?
  // Sync tracking
  sourceRemoteModifiedAt DateTime
  sourceSnapshotId       String
  normalizedAt           DateTime  @default(now())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([status])
  @@index([zohoVendorId])
  @@index([date])
  @@index([sourceSnapshotId])
}

/// Generic per-user table layout preferences (column order, visibility, widths,
/// pinning, density, page size). Reusable across modules via `tableKey`.
/// Source of persistence is PostgreSQL; localStorage may be used as UX cache.
model UserTablePreference {
  id        String   @id @default(cuid())
  userId    String
  tableKey  String
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tableKey])
  @@index([userId])
}

/// Generic saved table view. Combines query state (search, filters, sort) and
/// presentation state (columns, density, page size). `visibility` is either
/// "private" (owner only) or "shared" (any user with the module's view perm).
model TableView {
  id          String   @id @default(cuid())
  ownerUserId String
  tableKey    String
  name        String
  visibility  String   @default("private")
  config      Json
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId])
  @@index([tableKey, visibility])
}

/// Generic entity watch. Allows a user to follow an entity (e.g. a SalesOrder)
/// and receive notifications when it changes. `entityType` is a string key
/// (e.g. "sales_order"); `entityId` is the internal UNIK id.
model EntityWatch {
  id         String   @id @default(cuid())
  userId     String
  entityType String
  entityId   String
  config     Json?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([entityType, entityId, isActive])
}

/// Generic change event for a watched entity. Stores only the diff (before/after
/// per field). `sourceSnapshotId` is unique when present to guarantee
/// idempotency: one snapshot → at most one ChangeEvent.
model EntityChangeEvent {
  id                     String    @id @default(cuid())
  entityType             String
  entityId               String
  sourceSnapshotId       String?   @unique
  sourceRemoteModifiedAt DateTime?
  changes                Json
  createdAt              DateTime  @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([entityType, entityId])
}

/// Generic in-app notification. Created when an EntityChangeEvent matches an
/// active EntityWatch. `changeEventId` + `userId` form a logical uniqueness
/// constraint for idempotency (enforced in service layer).
model Notification {
  id            String    @id @default(cuid())
  userId        String
  type          String
  /// Preference bucket (see NOTIFICATION_CATEGORIES in src/modules/notifications/catalog.ts).
  category      String    @default("system")
  title         String
  body          String?
  /// In-app path opened when the notification (or its push) is tapped.
  url           String?
  entityType    String?
  entityId      String?
  changeEventId String?
  /// Optional idempotency key (e.g. "chat_message:{messageId}:{userId}").
  dedupeKey     String?   @unique
  metadata      Json?
  /// Push delivery state: pending | sent | skipped | failed. Rows created inside a
  /// transaction stay pending until the dispatcher picks them up after commit.
  pushStatus    String    @default("pending")
  pushedAt      DateTime?
  readAt        DateTime?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([userId, changeEventId])
  @@index([pushStatus, createdAt])
}

/// Web Push subscription of one browser/device (VAPID). A user has one row per
/// device; the endpoint is unique across users (a device re-login moves it).
model PushSubscription {
  id           String    @id @default(cuid())
  userId       String
  endpoint     String    @unique
  p256dh       String
  auth         String
  userAgent    String?
  /// ios | android | desktop | unknown (best effort, for the settings screen).
  platform     String    @default("unknown")
  failureCount Int       @default(0)
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Per-user notification configuration. `preferences` is a map
/// { [category]: { inApp: boolean, push: boolean } }; categories missing from the
/// map use the catalog defaults.
model UserNotificationSettings {
  userId          String    @id
  pushEnabled     Boolean   @default(true)
  /// Do-not-disturb window (local hour 0-23, in `timezone`). null = disabled.
  quietHoursStart Int?
  quietHoursEnd   Int?
  timezone        String    @default("America/Mexico_City")
  /// Temporary mute of every push (in-app rows are still created).
  mutedUntil      DateTime?
  preferences     Json      @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// =====================================================
// AI Assistant models (additive migration)
// =====================================================

/// Una conversación entre un usuario y el asistente IA.
model AiConversation {
  id                  String       @id @default(cuid())
  userId              String
  tenantId            String?
  agentId             String?
  title               String       @default("Nueva conversación")
  context             Json?
  isStarred           Boolean      @default(false)
  /// Rolling summary of the thread (shared context across assistant + copilots).
  summary             String?
  summaryUpdatedAt    DateTime?
  summaryMessageCount Int          @default(0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages            AiMessage[]
  artifacts           AiArtifact[]

  @@index([userId, updatedAt])
  @@index([isStarred])
}

/// Un mensaje dentro de una conversación (user, assistant, o tool).
model AiMessage {
  id              String             @id @default(cuid())
  conversationId  String
  role            String
  content         String?
  toolCalls       Json?
  toolCallId      String?
  tokensIn        Int                @default(0)
  tokensOut       Int                @default(0)
  latencyMs       Int                @default(0)
  createdAt       DateTime           @default(now())
  conversation    AiConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  toolCallRecords AiToolCall[]
  attachments     AiAttachment[]
  artifacts       AiArtifact[]
  feedback        AiMessageFeedback?
  /// Turn metadata: model routing decision, confidence label, judge score, cache hits.
  meta            Json?

  @@index([conversationId, createdAt])
}

/// Explicit quality feedback (👍/👎) left by the conversation owner on an assistant message.
model AiMessageFeedback {
  id        String    @id @default(cuid())
  messageId String    @unique
  userId    String
  /// 1 = útil, -1 = no útil
  rating    Int
  comment   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  message   AiMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

/// Registro detallado de cada tool call ejecutado (para auditoría del admin).
model AiToolCall {
  id         String    @id @default(cuid())
  messageId  String
  toolName   String
  args       Json
  result     Json?
  durationMs Int       @default(0)
  success    Boolean   @default(true)
  agentId    String?
  tenantId   String?
  errorCode  String?
  createdAt  DateTime  @default(now())
  message    AiMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([toolName])
  @@index([createdAt])
}

/// Llamada a Azure OpenAI registrada (para monitoreo de consumo del admin).
model AiApiCall {
  id               String   @id @default(cuid())
  userId           String?
  agentId          String?
  tenantId         String?
  conversationId   String?
  deployment       String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  durationMs       Int      @default(0)
  success          Boolean  @default(true)
  errorCode        String?
  finishReason     String?
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([deployment])
}

/// Archivo adjunto por el usuario (documento o imagen).
model AiAttachment {
  id              String         @id @default(cuid())
  messageId       String?
  conversationId  String
  fileName        String
  mimeType        String
  sizeBytes       Int
  /// Legacy disk path. Null for objects stored through StorageObject.
  storagePath     String?
  /// Reference to the central object registry (R2 or migrated legacy file).
  storageObjectId String?
  uploadedBy      String
  createdAt       DateTime       @default(now())
  message         AiMessage?     @relation(fields: [messageId], references: [id], onDelete: SetNull)
  storageObject   StorageObject? @relation(fields: [storageObjectId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([messageId])
  @@index([storageObjectId])
}

/// Artifact generado por la IA (PDF, CSV, XLSX, imagen, tabla, markdown).
model AiArtifact {
  id              String         @id @default(cuid())
  conversationId  String
  messageId       String?
  type            String
  /// Legacy disk path. Null for objects stored through StorageObject.
  storagePath     String?
  /// Reference to the central object registry (R2 or migrated legacy file).
  storageObjectId String?
  inlineData      Json?
  meta            Json?
  createdAt       DateTime       @default(now())
  conversation    AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message         AiMessage?     @relation(fields: [messageId], references: [id], onDelete: SetNull)
  storageObject   StorageObject? @relation(fields: [storageObjectId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([messageId])
  @@index([type])
  @@index([storageObjectId])
}

/// Configuración persistida del asistente (editable desde el panel de admin).
model AiConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  isEnabled Boolean  @default(true)
  settings  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================================================
// Internal Chat models (additive migration)
// =====================================================

/// Canal de chat: mensaje directo (type='dm') o grupo (type='group').
model InternalChatChannel {
  id            String                   @id @default(cuid())
  type          String
  name          String?
  avatarPath    String?
  createdBy     String
  lastMessageAt DateTime                 @default(now())
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  members       InternalChatMember[]
  messages      InternalChatMessage[]
  events        InternalChatEvent[]
  tags          InternalChatChannelTag[]
  calls         InternalChatCall[]
  threads       InternalChatThread[]

  @@index([type])
  @@index([lastMessageAt])
  @@map("internal_chat_channel")
}

/// Membresía de un usuario en un canal de chat.
model InternalChatMember {
  id         String              @id @default(cuid())
  channelId  String
  userId     String
  role       String              @default("member")
  joinedAt   DateTime            @default(now())
  lastReadAt DateTime            @default(now())
  mutedUntil DateTime?
  leftAt     DateTime?
  channel    InternalChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
  @@index([channelId, leftAt])
  @@map("internal_chat_member")
}

/// Mensaje dentro de un canal de chat.
model InternalChatMessage {
  id              String                      @id @default(cuid())
  channelId       String
  senderId        String
  content         String?
  replyToId       String?
  forwardedFromId String?
  forwardedBy     String?
  editedAt        DateTime?
  deletedAt       DateTime?
  priority        String                      @default("normal") // "normal" | "urgent"
  threadId        String?
  createdAt       DateTime                    @default(now())
  channel         InternalChatChannel         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender          User                        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo         InternalChatMessage?        @relation("InternalChatMessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  forwardedFrom   InternalChatMessage?        @relation("InternalChatMessageForward", fields: [forwardedFromId], references: [id], onDelete: SetNull)
  replies         InternalChatMessage[]       @relation("InternalChatMessageReply")
  forwards        InternalChatMessage[]       @relation("InternalChatMessageForward")
  thread          InternalChatThread?         @relation("InternalChatThreadMessages", fields: [threadId], references: [id], onDelete: SetNull)
  threadRoot      InternalChatThread?         @relation("InternalChatThreadRoot")
  attachments     InternalChatAttachment[]
  reactions       InternalChatReaction[]
  readReceipts    InternalChatReadReceipt[]
  mentions        InternalChatMention[]
  location        InternalChatLocation?
  poll            InternalChatPoll?
  event           InternalChatEvent?
  pins            InternalChatPinnedMessage[]
  bookmarks       InternalChatBookmark[]

  @@index([channelId, createdAt])
  @@index([senderId])
  @@index([replyToId])
  @@index([threadId])
  @@index([priority, createdAt])
  @@map("internal_chat_message")
}

/// Archivo adjunto a un mensaje (foto, video, audio, documento).
model InternalChatAttachment {
  id              String               @id @default(cuid())
  /// Null while the file is uploaded but not yet sent as part of a message.
  messageId       String?
  /// Channel the upload was authorized for. Set on new uploads; null on legacy rows.
  channelId       String?
  /// User who uploaded the file. Set on new uploads; null on legacy rows.
  uploadedBy      String?
  fileName        String
  mimeType        String
  sizeBytes       Int
  /// Legacy disk path. Null for objects stored through StorageObject.
  storagePath     String?
  /// Reference to the central object registry (R2 or migrated legacy file).
  storageObjectId String?
  width           Int?
  height          Int?
  durationMs      Int?
  thumbnailPath   String?
  createdAt       DateTime             @default(now())
  message         InternalChatMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  storageObject   StorageObject?       @relation(fields: [storageObjectId], references: [id], onDelete: SetNull)

  @@index([messageId])
  @@index([channelId, uploadedBy])
  @@index([storageObjectId])
  @@map("internal_chat_attachment")
}

/// Reacción emoji a un mensaje.
model InternalChatReaction {
  id        String              @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime            @default(now())
  message   InternalChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("internal_chat_reaction")
}

/// Confirmación de lectura de un mensaje por un usuario.
model InternalChatReadReceipt {
  id        String              @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime            @default(now())
  message   InternalChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@map("internal_chat_read_receipt")
}

/// Presencia de un usuario en el chat (1 fila por usuario).
model InternalChatPresence {
  userId     String   @id
  status     String   @default("offline")
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("internal_chat_presence")
}

/// Mención de un usuario en un mensaje de chat.
model InternalChatMention {
  id        String              @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime?
  message   InternalChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, readAt])
  @@map("internal_chat_mention")
}

/// Ubicación geográfica adjunta a un mensaje.
model InternalChatLocation {
  id        String              @id @default(cuid())
  messageId String              @unique
  latitude  Float
  longitude Float
  label     String?
  message   InternalChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("internal_chat_location")
}

/// Encuesta adjunta a un mensaje.
model InternalChatPoll {
  id          String                   @id @default(cuid())
  messageId   String                   @unique
  question    String
  isMulti     Boolean                  @default(false)
  isAnonymous Boolean                  @default(true)
  closesAt    DateTime?
  message     InternalChatMessage      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  options     InternalChatPollOption[]

  @@map("internal_chat_poll")
}

/// Opción de una encuesta de chat.
model InternalChatPollOption {
  id     String                 @id @default(cuid())
  pollId String
  text   String
  poll   InternalChatPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes  InternalChatPollVote[]

  @@index([pollId])
  @@map("internal_chat_poll_option")
}

/// Voto de un usuario en una opción de encuesta.
model InternalChatPollVote {
  id       String                 @id @default(cuid())
  optionId String
  userId   String
  option   InternalChatPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([optionId, userId])
  @@index([optionId])
  @@map("internal_chat_poll_vote")
}

/// Evento de calendario creado desde el chat.
model InternalChatEvent {
  id          String                  @id @default(cuid())
  messageId   String                  @unique
  channelId   String
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  location    String?
  createdBy   String
  createdAt   DateTime                @default(now())
  message     InternalChatMessage     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  channel     InternalChatChannel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  rsvps       InternalChatEventRsvp[]

  @@index([channelId, startsAt])
  @@index([startsAt])
  @@map("internal_chat_event")
}

/// Respuesta RSVP de un usuario a un evento de chat.
model InternalChatEventRsvp {
  id      String            @id @default(cuid())
  eventId String
  userId  String
  status  String // "yes" | "no" | "maybe"
  event   InternalChatEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@map("internal_chat_event_rsvp")
}

/// Alerta automática de seguridad/anti-fraude del chat.
model InternalChatAlert {
  id         String    @id @default(cuid())
  type       String // "bulk_download" | "off_hours" | "keyword" | "volume_spike" | "external_share"
  severity   String // "low" | "medium" | "high"
  userId     String?
  channelId  String?
  messageId  String?
  metadata   Json?
  resolvedAt DateTime?
  resolvedBy String?
  createdAt  DateTime  @default(now())

  @@index([type, severity, resolvedAt])
  @@index([createdAt])
  @@map("internal_chat_alert")
}

/// Configuración global del chat (key-value singleton).
model InternalChatConfig {
  id    String @id @default("singleton")
  key   String @unique
  value String

  @@map("internal_chat_config")
}

/// Mensaje fijado (pinned) en un canal.
model InternalChatPinnedMessage {
  id        String              @id @default(cuid())
  channelId String
  messageId String
  pinnedBy  String
  pinnedAt  DateTime            @default(now())
  message   InternalChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [pinnedBy], references: [id], onDelete: Cascade)

  @@unique([channelId, messageId])
  @@index([channelId])
  @@map("internal_chat_pinned_message")
}

/// Etiqueta/tag para categorizar canales de chat.
model InternalChatTag {
  id       String                   @id @default(cuid())
  name     String                   @unique
  color    String                   @default("#6b7280")
  channels InternalChatChannelTag[]

  @@map("internal_chat_tag")
}

/// Relación many-to-many entre canal y tag.
model InternalChatChannelTag {
  channelId String              @id @default(cuid())
  tagId     String
  channel   InternalChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  tag       InternalChatTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([channelId, tagId])
  @@index([tagId])
  @@map("internal_chat_channel_tag")
}

/// Preferencia de notificaciones de un usuario para un canal.
model InternalChatNotificationPreference {
  id        String @id @default(cuid())
  userId    String
  channelId String
  level     String // "all" | "mentions" | "none"
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@index([channelId])
  @@map("internal_chat_notification_preference")
}

/// Plantilla/snippet de mensaje guardado por un usuario.
model InternalChatSnippet {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("internal_chat_snippet")
}

/// Mensaje programado para enviarse después.
model InternalChatScheduledMessage {
  id        String    @id @default(cuid())
  channelId String
  senderId  String
  content   String?
  sendAt    DateTime
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  sender    User      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([sendAt, sentAt])
  @@index([channelId])
  @@map("internal_chat_scheduled_message")
}

/// Bookmark/marcador personal de un mensaje.
model InternalChatBookmark {
  id        String              @id @default(cuid())
  userId    String
  messageId String
  createdAt DateTime            @default(now())
  message   InternalChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@index([userId])
  @@map("internal_chat_bookmark")
}

/// Llamada de voz/video WebRTC dentro de un canal de chat.
model InternalChatCall {
  id           String                        @id @default(cuid())
  channelId    String
  callerId     String
  type         String // "audio" | "video"
  status       String                        @default("ringing") // "ringing" | "active" | "ended" | "missed" | "declined"
  startedAt    DateTime?
  endedAt      DateTime?
  createdAt    DateTime                      @default(now())
  channel      InternalChatChannel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  caller       User                          @relation(fields: [callerId], references: [id], onDelete: Cascade)
  participants InternalChatCallParticipant[]
  signals      InternalChatCallSignal[]

  @@index([channelId, status])
  @@index([createdAt])
  @@index([callerId])
  @@map("internal_chat_call")
}

/// Participante de una llamada de chat.
model InternalChatCallParticipant {
  id         String           @id @default(cuid())
  callId     String
  userId     String
  acceptedAt DateTime?
  declinedAt DateTime?
  call       InternalChatCall @relation(fields: [callId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([callId, userId])
  @@index([callId])
  @@map("internal_chat_call_participant")
}

/// Señal WebRTC efímera (offer/answer/ICE) para una llamada.
model InternalChatCallSignal {
  id          String           @id @default(cuid())
  callId      String
  fromUserId  String
  toUserId    String
  signalType  String // "offer" | "answer" | "ice"
  signal      String // JSON stringified SDP/ICE candidate
  createdAt   DateTime         @default(now())
  deliveredAt DateTime?
  call        InternalChatCall @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([toUserId, deliveredAt])
  @@index([callId])
  @@map("internal_chat_call_signal")
}

/// Hilo de conversación dentro de un canal de chat.
model InternalChatThread {
  id            String                @id @default(cuid())
  channelId     String
  rootMessageId String
  createdAt     DateTime              @default(now())
  channel       InternalChatChannel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  rootMessage   InternalChatMessage   @relation("InternalChatThreadRoot", fields: [rootMessageId], references: [id], onDelete: Cascade)
  messages      InternalChatMessage[] @relation("InternalChatThreadMessages")

  @@unique([rootMessageId])
  @@index([channelId])
  @@map("internal_chat_thread")
}

// =====================================================
// Object storage (Cloudflare R2 / legacy disk)
// =====================================================

/// Central registry of every binary UNIK stores. Authorization never derives
/// from this table: knowing an id grants nothing — the owning conversation,
/// channel, document or call is what gets checked.
model StorageObject {
  id               String    @id @default(cuid())
  /// 'r2' | 'disk'
  provider         String
  /// Logical bucket: files | recordings | quarantine (resolved per environment)
  bucketAlias      String
  /// Server-generated key. Never received from the client.
  objectKey        String
  /// Opaque version identifier that is part of the key (documents keep history).
  versionId        String
  /// Previous version of the same logical document, if any.
  parentObjectId   String?
  originalName     String
  declaredMimeType String
  detectedMimeType String?
  /// Real size. Serialized as string in APIs.
  sizeBytes        BigInt    @default(0)
  sha256           String?
  /// initiated | uploading | validating | ready | rejected | aborted | missing | deleted
  status           String    @default("initiated")
  rejectionReason  String?
  /// User id or service identity (e.g. "service:ai", "service:livekit").
  createdBy        String?
  /// chat | ai_attachment | ai_artifact | document | recording | transcript | plugin | knowledge | comm_media
  purpose          String
  /// default | protected (approved or shared documents are never removed by generic cleanup)
  retentionPolicy  String    @default("default")
  /// Optional technical metadata (width, height, durationMs, pageCount, thumbnails...)
  metadata         Json?
  /// Original disk path for files migrated from the legacy directories.
  legacyPath       String?
  expiresAt        DateTime?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  uploadSession   UploadSession?
  aiAttachments   AiAttachment[]
  aiArtifacts     AiArtifact[]
  chatAttachments InternalChatAttachment[]

  @@unique([bucketAlias, objectKey])
  @@index([status])
  @@index([purpose, status])
  @@index([createdBy, createdAt])
  @@index([expiresAt])
  @@index([sha256])
  @@index([parentObjectId])
}

/// Tracks an in-progress upload (single or multipart). Parts and the provider
/// upload id are server controlled; the browser only receives short-lived
/// per-part authorizations.
model UploadSession {
  id               String        @id @default(cuid())
  objectId         String        @unique
  userId           String
  /// ai_conversation | chat_channel | document | plugin | knowledge
  targetType       String
  targetId         String
  declaredSize     BigInt
  partSize         Int
  partCount        Int
  multipart        Boolean       @default(false)
  /// S3 multipart UploadId (R2). Null for single PUT or disk driver.
  providerUploadId String?
  /// Quarantine key the browser writes to. The final key is chosen on promotion.
  quarantineKey    String
  /// Uploaded parts: [{ partNumber, etag, sizeBytes }]
  parts            Json?
  /// initiated | uploading | completing | completed | aborted | expired
  status           String        @default("initiated")
  expiresAt        DateTime
  completedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  object           StorageObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, expiresAt])
}

/// Storage settings bag (quotas, retention, driver flags) — same pattern as AiConfig.
model StorageConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  settings  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Durable background job queue backed by PostgreSQL so work survives tab
/// closes and instance restarts. Processed by the in-process worker
/// (src/modules/jobs). A Redis/BullMQ driver can replace the executor
/// without touching producers.
model BackgroundJob {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  /// pending | running | completed | failed | cancelled
  status      String    @default("pending")
  /// Lower runs first. Human-facing work uses < 100, campaigns > 500.
  priority    Int       @default(100)
  runAt       DateTime  @default(now())
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lastError   String?
  lockedAt    DateTime?
  lockedBy    String?
  /// Optional idempotency key (unique while the job is not completed).
  dedupeKey   String?   @unique
  /// Optional group for bulk cancel (campaign id, plugin id...).
  groupKey    String?
  progress    Int       @default(0)
  result      Json?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([status, runAt, priority])
  @@index([type, status])
  @@index([groupKey])
  @@index([createdAt])
}

/// Persisted realtime events. Clients resume with a cursor (last event id),
/// so a reconnect never loses updates.
model RealtimeEvent {
  id        BigInt   @id @default(autoincrement())
  /// user:{id} | channel:{id} | upload:{objectId} | job:{id} | inbox:{teamId} | call:{id}
  channel   String
  type      String
  payload   Json
  createdAt DateTime @default(now())

  @@index([channel, id])
  @@index([createdAt])
}

// =====================================================
// Extensions: MCP servers, custom APIs, plugins, skills, connections
// =====================================================

/// An installed extension (MCP server, custom API, plugin package or skill
/// bundle). Its capabilities are exposed to the assistant only through an
/// APPROVED and ENABLED version, and only to the allowed roles.
model Extension {
  id               String                @id @default(cuid())
  /// Stable namespace, e.g. "mcp.books", "api.proveedor". Tool names are "<namespace>__<local>".
  namespace        String                @unique
  /// mcp | api | plugin | skill
  kind             String
  name             String
  description      String?
  createdBy        String
  /// draft | testing | pending_approval | approved | enabled | suspended | revoked
  status           String                @default("draft")
  currentVersionId String?
  /// Role keys allowed to use the extension. Empty = only super_admin / assistant.admin (testing).
  allowedRoleKeys  String[]              @default([])
  /// Approved egress: hosts (exact or *.suffix) and ports.
  allowedHosts     String[]              @default([])
  allowedPorts     Int[]                 @default([443])
  /// Non-secret configuration (base URL, MCP endpoint, auth type, OAuth endpoints...).
  config           Json?
  suspendedAt      DateTime?
  suspendedReason  String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  versions         ExtensionVersion[]
  capabilities     ExtensionCapability[]
  connections      ExtensionConnection[]
  executions       ExtensionExecution[]

  @@index([kind, status])
}

/// Immutable version identified by its content hash. Updates create a new
/// version; the one in use is never replaced until the new one is approved.
model ExtensionVersion {
  id             String                @id @default(cuid())
  extensionId    String
  version        String
  contentHash    String
  /// Declarative manifest: tools/operations, skills, templates, docs, fixtures. Never secrets.
  manifest       Json
  /// draft | testing | pending_approval | approved | enabled | suspended | superseded
  status         String                @default("draft")
  reviewNotes    String?
  publishedBy    String
  approvedBy     String?
  approvedAt     DateTime?
  lastTestedAt   DateTime?
  lastTestResult Json?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  extension      Extension             @relation(fields: [extensionId], references: [id], onDelete: Cascade)
  capabilities   ExtensionCapability[]

  @@unique([extensionId, version])
  @@index([extensionId, status])
}

/// One concrete capability (MCP tool, API operation, plugin tool) with UNIK's
/// OWN classification. Server annotations and model descriptions never grant trust.
model ExtensionCapability {
  id                 String           @id @default(cuid())
  extensionId        String
  versionId          String
  /// Name exposed to the model: "<namespace>__<localName>".
  name               String
  localName          String
  description        String
  inputSchema        Json
  outputSchema       Json?
  /// Fingerprint of name+description+schemas to detect remote changes.
  schemaHash         String
  /// read | draft | internal_task | external_send | business_write | destructive
  effect             String           @default("read")
  /// auto | require_approval
  approvalPolicy     String           @default("require_approval")
  /// Data categories the capability may receive (e.g. "customer_contact", "prices").
  dataScope          String[]         @default([])
  requiredPermission String?
  timeoutMs          Int              @default(15000)
  maxResultBytes     Int              @default(65536)
  /// none | team | personal — which connection identity executes it.
  connectionScope    String           @default("none")
  /// pending | approved | blocked
  reviewStatus       String           @default("pending")
  enabled            Boolean          @default(false)
  /// True when the remote catalog changed after approval; blocked until re-reviewed.
  remoteChanged      Boolean          @default(false)
  /// Operation definition for API extensions (method, path, params, response selection...).
  operation          Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  extension          Extension        @relation(fields: [extensionId], references: [id], onDelete: Cascade)
  version            ExtensionVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, localName])
  @@index([extensionId, enabled])
  @@index([name])
}

/// An authorized account for an extension. Secrets are AES-256-GCM encrypted
/// with a master key outside PostgreSQL; the browser never receives them back.
model ExtensionConnection {
  id                 String    @id @default(cuid())
  extensionId        String
  /// oauth2 | api_key | bearer | basic | service
  authType           String
  /// team | personal
  scopeType          String
  ownerUserId        String?
  name               String
  /// active | revoked | expired | error
  status             String    @default("active")
  keyId              String?
  /// Encrypted JSON { accessToken?, refreshToken?, apiKey?, username?, password? }
  secretCiphertext   String?
  expiresAt          DateTime?
  scopes             String[]  @default([])
  /// Non-secret metadata: account label, token endpoint, provider user id.
  metadata           Json?
  /// Per-connection lock to avoid concurrent token refreshes.
  refreshLockedUntil DateTime?
  lastUsedAt         DateTime?
  lastError          String?
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  extension          Extension @relation(fields: [extensionId], references: [id], onDelete: Cascade)

  @@index([extensionId, scopeType])
  @@index([ownerUserId])
}

/// OAuth authorization in flight (state + PKCE verifier), short lived.
model OAuthState {
  id           String   @id @default(cuid())
  state        String   @unique
  codeVerifier String
  userId       String
  extensionId  String
  scopeType    String
  redirectUri  String
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([expiresAt])
}

/// A pending approval for an action with side effects. Bound to the exact
/// tool, version, connection, arguments, recipient, files and context; any
/// material change invalidates it.
model AiProposal {
  id             String    @id @default(cuid())
  conversationId String?
  messageId      String?
  userId         String
  toolName       String
  toolVersion    String?
  capabilityId   String?
  connectionId   String?
  argsHash       String
  args           Json
  summary        String
  recipient      String?
  fileIds        String[]  @default([])
  contextHash    String?
  effect         String
  /// pending | approved | rejected | executed | failed | expired | invalidated | pending_review
  status         String    @default("pending")
  decisionBy     String?
  decidedAt      DateTime?
  executedAt     DateTime?
  result         Json?
  error          String?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, status])
  @@index([conversationId])
  @@index([status, expiresAt])
}

/// Audit of every external execution (the "Ejecuciones" tab). Never stores secrets.
model ExtensionExecution {
  id            String     @id @default(cuid())
  extensionId   String?
  capabilityId  String?
  connectionId  String?
  userId        String?
  toolName      String
  /// success | error | denied | timeout | pending_review | needs_approval
  status        String
  durationMs    Int        @default(0)
  requestBytes  Int        @default(0)
  responseBytes Int        @default(0)
  errorCode     String?
  errorMessage  String?
  proposalId    String?
  createdAt     DateTime   @default(now())
  extension     Extension? @relation(fields: [extensionId], references: [id], onDelete: SetNull)

  @@index([extensionId, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// A declarative skill (recipe): inputs, instructions, allowed tools, steps,
/// completion conditions, approval points and limits. No code, ever.
model Skill {
  id          String     @id @default(cuid())
  key         String     @unique
  name        String
  purpose     String
  ownerUserId String
  /// personal | team
  scope       String     @default("personal")
  /// draft | published | suspended
  status      String     @default("draft")
  version     Int        @default(1)
  definition  Json
  extensionId String?
  publishedBy String?
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  runs        SkillRun[]

  @@index([ownerUserId, scope])
  @@index([status, scope])
}

/// One execution of a skill; survives restarts and waits for approvals.
model SkillRun {
  id             String    @id @default(cuid())
  skillId        String
  skillVersion   Int
  userId         String
  conversationId String?
  /// running | waiting_approval | completed | failed | cancelled
  status         String    @default("running")
  inputs         Json
  state          Json
  currentStep    String?
  proposalId     String?
  error          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  completedAt    DateTime?
  skill          Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId, status])
  @@index([userId, createdAt])
  @@index([proposalId])
}

/// Consumption per dimension (extension, provider, user, team, storage, job).
model UsageMeter {
  id        String   @id @default(cuid())
  dimension String
  key       String
  /// YYYY-MM-DD
  period    String
  unit      String
  count     Int      @default(0)
  amount    Decimal  @default(0) @db.Decimal(18, 4)
  updatedAt DateTime @updatedAt

  @@unique([dimension, key, period, unit])
  @@index([dimension, period])
}

// =====================================================
// Copilot: personalization, personal memory, approved knowledge library
// =====================================================

/// Per-user assistant preferences (mode, tone, language, depth, format).
model AiUserPreference {
  userId             String   @id
  /// paused | on_request | autonomous_verified
  mode               String   @default("on_request")
  /// profesional | cercano | directo
  tone               String   @default("profesional")
  language           String   @default("es")
  /// breve | normal | detallado
  depth              String   @default("normal")
  /// markdown | texto | tablas
  format             String   @default("markdown")
  customInstructions String?
  memoryEnabled      Boolean  @default(true)
  /// Inbox copilot: active (proactive) | on_demand | paused
  inboxCopilotMode   String   @default("active")
  /// Internal chat copilot: active (proactive) | on_demand | paused
  chatCopilotMode    String   @default("active")
  /// Plan-then-execute: auto (only complex tasks) | always | never
  planMode           String   @default("auto")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// Personal memory: visible, editable and deletable by its owner. Corrections
/// proposed by the assistant stay `pending` until the user confirms them.
model AiMemory {
  id         String    @id @default(cuid())
  userId     String
  content    String
  /// user | assistant | correction
  source     String    @default("user")
  /// active | pending | archived
  status     String    @default("active")
  tags       String[]  @default([])
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, status, createdAt])
}

/// Approved knowledge library. Internal vs publishable information is
/// separated by `visibility`; a document received from a customer never
/// becomes shared knowledge automatically.
model KnowledgeSource {
  id               String                   @id @default(cuid())
  title            String
  description      String?
  /// document | url | website | text
  kind             String
  /// internal | publishable
  visibility       String                   @default("internal")
  /// draft | approved | archived
  status           String                   @default("draft")
  currentVersionId String?
  tags             String[]                 @default([])
  /// promociones | catalogos | precios | fichas_tecnicas | politicas | manuales | procesos | capacitacion | otro
  category         String?
  /// Hint the assistant uses to pick this document ("cuando un distribuidor pide precios").
  useWhen          String?
  /// After this moment the source is neither cited nor sent.
  expiresAt        DateTime?
  createdBy        String
  approvedBy       String?
  approvedAt       DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  tenantId         String?
  versions         KnowledgeSourceVersion[]

  @@index([status, visibility])
  @@index([category])
}

model KnowledgeSourceVersion {
  id              String           @id @default(cuid())
  sourceId        String
  version         Int
  storageObjectId String?
  sourceUrl       String?
  /// processing | ready | failed
  status          String           @default("processing")
  sha256          String?
  chunkCount      Int              @default(0)
  error           String?
  fileName        String?
  mimeType        String?
  sizeBytes       Int?
  /// Pages read for url/website versions.
  pageCount       Int              @default(0)
  /// Becomes the current approved version as soon as processing succeeds.
  autoApprove     Boolean          @default(false)
  createdBy       String
  createdAt       DateTime         @default(now())
  source          KnowledgeSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  chunks          KnowledgeChunk[]

  @@unique([sourceId, version])
}

model KnowledgeChunk {
  id             String                 @id @default(cuid())
  sourceId       String
  versionId      String
  ordinal        Int
  section        String?
  content        String
  tokens         Int                    @default(0)
  /// Semantic vector (text-embedding-3-small by default). Empty until embedded.
  embedding      Float[]                @default([])
  embeddingModel String?
  createdAt      DateTime               @default(now())
  version        KnowledgeSourceVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId, ordinal])
  @@index([sourceId])
}

// =====================================================
// Omnichannel communications, campaigns, commitments
// =====================================================

/// A messaging number/bot (Twilio WhatsApp/SMS, Telegram) assigned to teams.
model CommAccount {
  id            String             @id @default(cuid())
  /// twilio_whatsapp | twilio_sms | telegram
  provider      String
  label         String
  /// Phone number (E.164) or bot username.
  identifier    String
  /// Credentials live in an ExtensionConnection (encrypted). Null = env fallback.
  connectionId  String?
  teamKeys      String[]           @default([])
  /// active | paused
  status        String             @default("active")
  /// Hashed webhook secret (Telegram secret_token / Twilio auth for signature validation is env based).
  webhookSecret String?
  config        Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  conversations CommConversation[]
  messages      CommMessage[]

  @@unique([provider, identifier])
  @@index([status])
}

model CommContact {
  id                    String             @id @default(cuid())
  displayName           String
  phone                 String?
  telegramId            String?
  email                 String?
  zohoContactId         String?
  tags                  String[]           @default([])
  /// Reviewable duplicate detection: points to the surviving contact once merged.
  duplicateOfId         String?
  duplicateReviewStatus String? // pending | confirmed | dismissed
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  conversations         CommConversation[]
  consents              ConsentRecord[]

  @@index([phone])
  @@index([telegramId])
  @@index([zohoContactId])
  @@index([duplicateReviewStatus])
}

model CommConversation {
  id               String        @id @default(cuid())
  accountId        String
  contactId        String
  /// open | pending | snoozed | resolved
  status           String        @default("open")
  assignedToUserId String?
  subject          String?
  /// normal | high | urgent
  priority         String        @default("normal")
  tags             String[]      @default([])
  unreadCount      Int           @default(0)
  lastMessageAt    DateTime      @default(now())
  lastInboundAt    DateTime?
  snoozedUntil     DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  account          CommAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact          CommContact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages         CommMessage[]
  notes            CommNote[]

  @@index([accountId, status, lastMessageAt])
  @@index([assignedToUserId, status])
  @@index([contactId])
}

/// External messages are persisted ONCE: (accountId, externalId) is unique.
model CommMessage {
  id             String           @id @default(cuid())
  accountId      String
  conversationId String
  /// inbound | outbound
  direction      String
  externalId     String?
  body           String?
  mediaObjectIds String[]         @default([])
  /// received | queued | sent | delivered | read | failed | undelivered
  status         String           @default("received")
  error          String?
  sentByUserId   String?
  proposalId     String?
  campaignId     String?
  templateKey    String?
  providerMeta   Json?
  createdAt      DateTime         @default(now())
  sentAt         DateTime?
  deliveredAt    DateTime?
  readAt         DateTime?
  account        CommAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  conversation   CommConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([accountId, externalId])
  @@index([conversationId, createdAt])
  @@index([campaignId, status])
}

model CommNote {
  id             String           @id @default(cuid())
  conversationId String
  authorUserId   String
  body           String
  createdAt      DateTime         @default(now())
  conversation   CommConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// Directory of responsible people per area (who handles what).
model Responsible {
  id           String   @id @default(cuid())
  area         String   @unique
  label        String
  userId       String
  backupUserId String?
  description  String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Commitments made to contacts (follow-up tracking).
model Commitment {
  id          String    @id @default(cuid())
  description String
  ownerUserId String
  contactId   String?
  /// comm_message | ai_conversation | call | request | manual
  sourceType  String    @default("manual")
  sourceId    String?
  dueAt       DateTime?
  /// pending | done | overdue | cancelled
  status      String    @default("pending")
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([ownerUserId, status, dueAt])
  @@index([contactId])
}

model ConsentRecord {
  id         String      @id @default(cuid())
  contactId  String
  /// whatsapp | sms | telegram
  channel    String
  /// opted_in | opted_out
  status     String
  source     String
  note       String?
  recordedAt DateTime    @default(now())
  contact    CommContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, channel, recordedAt])
}

/// Campaign with FROZEN audience and content, consent checks and budget.
model Campaign {
  id               String              @id @default(cuid())
  name             String
  /// whatsapp | sms | telegram
  channel          String
  accountId        String
  /// draft | rehearsal | pending_approval | scheduled | running | paused | completed | cancelled
  status           String              @default("draft")
  /// Frozen audience: { filter, count, frozenAt }
  audienceSnapshot Json?
  /// Frozen content: { templateKey?, body, variables }
  contentSnapshot  Json?
  budgetLimit      Decimal?            @db.Decimal(18, 4)
  budgetSpent      Decimal             @default(0) @db.Decimal(18, 4)
  costPerMessage   Decimal             @default(0) @db.Decimal(18, 6)
  batchSize        Int                 @default(500)
  ratePerMinute    Int                 @default(60)
  scheduledAt      DateTime?
  startedAt        DateTime?
  pausedAt         DateTime?
  completedAt      DateTime?
  stats            Json?
  createdBy        String
  approvedBy       String?
  approvedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  recipients       CampaignRecipient[]

  @@index([status, scheduledAt])
}

model CampaignRecipient {
  id              String    @id @default(cuid())
  campaignId      String
  contactId       String
  identifier      String
  personalization Json?
  /// pending | queued | sent | delivered | failed | skipped | opted_out
  status          String    @default("pending")
  batchNo         Int       @default(0)
  messageId       String?
  error           String?
  sentAt          DateTime?
  createdAt       DateTime  @default(now())
  campaign        Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([campaignId, status, batchNo])
}

// =====================================================
// Voice: LiveKit rooms, Twilio PSTN, transcription, recording, supervision
// =====================================================

model VoiceCall {
  id                  String                   @id @default(cuid())
  /// internal | inbound | outbound
  type                String
  provider            String                   @default("livekit")
  roomName            String                   @unique
  /// ringing | active | ended | failed | missed
  status              String                   @default("ringing")
  fromIdentity        String?
  toIdentity          String?
  externalNumber      String?
  accountId           String?
  contactId           String?
  initiatedByUserId   String?
  /// active | paused | off — "Pausar IA" stops listening, transcription, analysis and voice.
  aiState             String                   @default("off")
  aiPausedAt          DateTime?
  /// Generation counter: results produced before a pause are discarded.
  aiGeneration        Int                      @default(0)
  /// off | recording | stopped
  recordingState      String                   @default("off")
  egressId            String?
  recordingObjectId   String?
  transcriptObjectId  String?
  summary             String?
  /// Mission for AI-driven outbound calls ("call and tell them X"); read by the voice agent brief.
  aiBrief             String?
  startedAt           DateTime?
  endedAt             DateTime?
  durationSec         Int?
  /// Retention: audio 30 days, transcripts/summaries 90 days.
  recordingExpiresAt  DateTime?
  transcriptExpiresAt DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  participants        VoiceParticipant[]
  segments            VoiceTranscriptSegment[]
  supervisions        VoiceSupervision[]

  @@index([status, createdAt])
  @@index([initiatedByUserId, createdAt])
  @@index([contactId])
}

model VoiceParticipant {
  id       String    @id @default(cuid())
  callId   String
  identity String
  userId   String?
  /// caller | callee | agent | ai | supervisor
  role     String
  joinedAt DateTime  @default(now())
  leftAt   DateTime?
  muted    Boolean   @default(false)
  call     VoiceCall @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@index([userId])
}

model VoiceTranscriptSegment {
  id              String    @id @default(cuid())
  callId          String
  speakerIdentity String
  text            String
  startMs         Int
  endMs           Int
  generation      Int       @default(0)
  createdAt       DateTime  @default(now())
  call            VoiceCall @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId, startMs])
}

model VoiceSupervision {
  id               String    @id @default(cuid())
  callId           String
  supervisorUserId String
  /// listen | whisper | barge
  mode             String
  startedAt        DateTime  @default(now())
  endedAt          DateTime?
  call             VoiceCall @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@index([supervisorUserId])
}

/// Política de UNIK para un toolkit de Composio (Gmail, Slack, GitHub…): qué
/// toolkits puede usar el asistente y qué roles los usan. Composio guarda las
/// cuentas conectadas y sus tokens; UNIK NO los almacena. Nace deshabilitada.
model ComposioToolkitPolicy {
  id              String   @id @default(cuid())
  /// Slug del toolkit en Composio, en minúsculas (p. ej. "gmail").
  toolkitSlug     String   @unique
  enabled         Boolean  @default(false)
  /// Roles que pueden usarlo. Vacío = solo super_admin.
  allowedRoleKeys String[] @default([])
  /// Clasificación de efecto decidida por un administrador: { "GMAIL_SEND_EMAIL": "external_send" }.
  effectOverrides Json     @default("{}")
  /// Herramientas concretas del toolkit que el asistente nunca debe ofrecer.
  disabledTools   String[] @default([])
  updatedBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([enabled])
}

// =====================================================
// AGENT VENUES — computadoras virtuales desechables (Daytona)
// =====================================================

/// Sesión de computadora virtual: un sandbox Daytona por usuario/misión.
/// El controllerToken del browser vive en metadata (interno, nunca al cliente).
model VenueSession {
  id            String    @id @default(cuid())
  userId        String
  tenantId      String?
  agentId       String?
  /// daytona (más providers después)
  kind          String    @default("daytona")
  /// sandbox id del provider
  externalId    String?
  /// active | idle | stopped | error
  status        String    @default("active")
  purpose       String?
  lastUsedAt    DateTime  @default(now())
  endedAt       DateTime?
  billedMinutes Int       @default(0)
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, status])
  @@index([status, lastUsedAt])
}

/// Estado de sesión de browser por host (cookies/localStorage) cifrado
/// AES-256-GCM con extensions/secrets.ts. Nunca se persiste en claro.
model BrowserProfile {
  id              String    @id @default(cuid())
  userId          String
  tenantId        String?
  agentId         String?
  /// etiqueta humana: "Plataforma GPS", "WhatsApp"
  name            String
  /// host al que aplica el perfil
  host            String
  stateCiphertext String
  createdAt       DateTime  @default(now())
  lastUsedAt      DateTime?

  @@unique([userId, host])
}

// =====================================================
// AGENT CORE — memoria real, objetivos y automatizaciones
// =====================================================

/// Memoria episódica: cada turno relevante destilado a un resumen buscable.
/// embedding Float[] + coseno en-app (mismo patrón que KnowledgeChunk).
model AgentEpisode {
  id             String   @id @default(cuid())
  userId         String
  tenantId       String?
  agentId        String?
  conversationId String?
  /// "Pidió ventas en efectivo de hoy → 9 EFECTIVO + 15 EFECTIVO EN BODEGA"
  summary        String
  embedding      Float[]  @default([])
  /// entidades mencionadas: clientes, folios, productos (para recall por keyword)
  entities       String[] @default([])
  toolNames      String[] @default([])
  /// 1-10: lo que vale recordar vs. ruido
  importance     Int      @default(5)
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, importance])
}

/// Memoria semántica: hechos del negocio/usuario. Los auto-extraídos llegan
/// `pending` y el usuario los confirma — nada se afirma sin confirmación.
model AgentFact {
  id              String    @id @default(cuid())
  userId          String
  tenantId        String?
  agentId         String?
  /// "efectivo", "Roberto", "corte de caja"
  entity          String
  /// "incluye", "es", "horario"
  attribute       String
  /// "EFECTIVO + EFECTIVO EN BODEGA", "contacto de logística", "8pm"
  value           String
  /// 0-1
  confidence      Float     @default(0.7)
  /// user | tool | observation | correction
  source          String    @default("observation")
  /// toolCallId / conversationId / fuente del hecho
  sourceRef       String?
  /// pending | active | archived
  status          String    @default("pending")
  lastConfirmedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, status, entity])
  @@index([userId, entity, attribute])
}

/// Memoria procedural: patrones de tool-args que funcionaron para este usuario.
/// "Para 'efectivo' este usuario espera EFECTIVO + EFECTIVO EN BODEGA".
model AgentPlaybook {
  id           String   @id @default(cuid())
  userId       String
  tenantId     String?
  agentId      String?
  /// intención disparadora: "ventas en efectivo", "pendientes de entrega"
  trigger      String
  toolName     String
  /// args que funcionaron (sin datos concretos: folios/fechas se omiten)
  argsTemplate Json
  note         String?
  successCount Int      @default(1)
  failCount    Int      @default(0)
  lastUsedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, successCount])
  @@index([userId, trigger])
}

/// Objetivo persistente: el agente lo persigue hasta completarlo, con
/// presupuesto, journal y reanudación entre turnos/sesiones.
model Mission {
  id              String         @id @default(cuid())
  userId          String
  tenantId        String?
  agentId         String?
  /// misión delegada por el agente principal a un especialista
  parentMissionId String?
  conversationId  String?
  goal            String
  /// planning | awaiting_approval | active | blocked | done | failed | cancelled
  status          String         @default("planning")
  /// pasos: [{title, status, toolHint?, result?}]
  plan            Json?
  /// tope de gasto vía UsageMeter
  budgetUsd       Decimal?       @db.Decimal(10, 2)
  spentUsd        Decimal        @default(0) @db.Decimal(10, 4)
  /// cron expression para rutinas (Vigía): "0 20 * * *" = corte a las 8pm
  schedule        String?
  /// próxima corrida programada
  nextRunAt       DateTime?
  venueSessionId  String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  completedAt     DateTime?
  events          MissionEvent[]

  @@index([userId, status])
  @@index([status, nextRunAt])
}

/// Journal append-only de la misión: cada paso, tool call y hallazgo.
/// Es también el feed de actividad que ve el usuario (SSE mission:{id}).
model MissionEvent {
  id        String   @id @default(cuid())
  missionId String
  /// step_started | step_done | tool_call | finding | approval | error | note
  type      String
  payload   Json?
  createdAt DateTime @default(now())
  mission   Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([missionId, createdAt])
}

/// Automatización de computadora virtual: flujo grabable que una rutina
/// ejecuta sin improvisar (login → navegar → extraer → reportar).
/// Sitios web que los agentes crean y publican (UNIVERSO). Se sirven en
/// /sites/{slug} con CSP sandbox (origen opaco: sin acceso a la sesión del ERP).
/// Los archivos viven aquí mismo (base64 en JSON, máx. ~8 MB por sitio).
model PublishedSite {
  id          String   @id @default(cuid())
  tenantId    String?
  ownerUserId String
  agentId     String?
  /// URL pública: /sites/{slug}
  slug        String   @unique
  name        String
  description String?
  /// { "index.html": { "type": "text/html", "b64": "..." }, "css/app.css": {...} }
  files       Json
  fileCount   Int      @default(0)
  sizeBytes   Int      @default(0)
  /// published | unpublished
  status      String   @default("published")
  visits      Int      @default(0)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerUserId, updatedAt])
}

model VenuePlaybook {
  id           String    @id @default(cuid())
  userId       String
  tenantId     String?
  agentId      String?
  /// "Revisión diaria GPS", "Descargar reporte Zoho"
  name         String
  /// [{action, args, expect?}] — browser.open/click/type/extract/exec…
  steps        Json
  /// parámetros declarados que la corrida llena (fechas, ids)
  params       Json?
  /// host/perfil requerido (BrowserProfile.host)
  requiresHost String?
  /// pending | active | archived — el usuario aprueba el playbook una vez
  status       String    @default("pending")
  runCount     Int       @default(0)
  lastRunAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, status])
}

// =====================================================
// UNIVERSO — runtime multiagente (aditivo; default = tenant 'unik')
// =====================================================

/// Empresa/organización. Todo lo del agente cuelga de aquí cuando UNIVERSO
/// es multiempresa; hoy todas las filas viven en el tenant semilla 'unik'.
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  status    String   @default("active")
  createdAt DateTime @default(now())

  @@index([status])
}

model TenantMembership {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  /// owner | admin | member
  role      String   @default("member")
  createdAt DateTime @default(now())

  @@unique([tenantId, userId])
  @@index([userId])
}

/// Agente persistente del usuario: principal (fijado arriba, uno por usuario)
/// o especialista (Cobranza, Investigador…). 'transient' = subagente de una
/// sola tarea; conserva el AgentRun pero no una identidad en el sidebar.
model Agent {
  id               String   @id @default(cuid())
  tenantId         String   @default("unik")
  /// dueño humano — el agente nunca supera los permisos de este usuario
  ownerUserId      String
  /// principal | specialist | transient
  kind             String   @default("specialist")
  name             String
  /// misión/rol en una línea (visible en el sidebar)
  purpose          String?
  /// system prompt propio del agente
  persona          String?
  /// avatar: icono lucide + color de la paleta de agentes
  icon             String?
  color            String?
  currentVersionId String?
  /// active | paused | archived
  status           String   @default("active")
  /// auto | notify | approval — autonomía por clase de efecto
  autonomy         String   @default("approval")
  /// shared | dedicated | ephemeral — computadora del agente
  venuePolicy      String   @default("shared")
  /// null = dejar al model-router decidir
  modelDefault     String?
  /// vacío = el mismo menú de tools que su dueño; solo puede reducir
  toolAllowlist    String[] @default([])
  budgetUsd        Decimal? @db.Decimal(10, 2)
  /// day | week | month
  budgetPeriod     String   @default("month")
  /// profundidad de delegación: 0 = no puede crear subagentes
  maxSpawnDepth    Int      @default(0)
  /// principal = 0 (fijado arriba en el sidebar)
  sortOrder        Int      @default(100)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tenantId, ownerUserId, status, sortOrder])
  @@index([ownerUserId, kind])
}

/// Versión inmutable de instrucciones + políticas. Cada corrida registra qué
/// versión usó — responde "¿por qué hizo eso ayer?".
model AgentVersion {
  id              String   @id @default(cuid())
  agentId         String
  instructions    String
  modelPolicy     Json?
  toolPolicy      Json?
  memoryPolicy    Json?
  workspacePolicy Json?
  approvalPolicy  Json?
  maxDelegations  Int      @default(4)
  createdAt       DateTime @default(now())

  @@index([agentId, createdAt])
}

/// Capacidad concedida a un agente: 'tool:<name>' | 'effect:<effect>' |
/// 'host:<dominio>'. Solo puede reducir lo que el dueño ya puede.
model AgentGrant {
  id         String   @id @default(cuid())
  agentId    String
  capability String
  /// allow | deny | require_approval
  decision   String   @default("allow")
  /// {"perDay": 20, "maxAmount": 500}
  limits     Json?
  createdAt  DateTime @default(now())

  @@unique([agentId, capability])
}

/// Una ejecución del runtime (turno de chat, paso de misión, task delegada,
/// corrida de trigger). Es la unidad de trazabilidad, costo y cancelación.
model AgentRun {
  id              String    @id @default(cuid())
  tenantId        String    @default("unik")
  agentId         String
  agentVersionId  String?
  /// usuario que inició (o dueño del agente en runs disparados por trigger)
  userId          String
  conversationId  String?
  /// jerarquía de delegación
  parentRunId     String?
  rootRunId       String
  taskId          String?
  missionId       String?
  /// running | awaiting_approval | done | failed | cancelled | blocked
  status          String    @default("running")
  /// fast | standard | deep
  route           String?
  modelId         String?
  reasoningEffort String?
  tokensIn        Int       @default(0)
  tokensOut       Int       @default(0)
  modelCostUsd    Decimal   @default(0) @db.Decimal(10, 4)
  toolsCostUsd    Decimal   @default(0) @db.Decimal(10, 4)
  venueCostUsd    Decimal   @default(0) @db.Decimal(10, 4)
  deadlineAt      DateTime?
  traceId         String
  /// LEGACY (orquestador actual) | V2 (agent-runtime)
  runtime         String    @default("LEGACY")
  error           String?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  @@index([tenantId, agentId, startedAt])
  @@index([rootRunId])
  @@index([status, startedAt])
  @@index([conversationId])
}

/// Unidad delegable de trabajo. El planner del agente principal crea tasks;
/// el graph-runner las ejecuta respetando dependsOn (DAG).
model AgentTask {
  id              String    @id @default(cuid())
  tenantId        String    @default("unik")
  rootRunId       String
  parentRunId     String
  /// null = subagente transitorio
  assignedAgentId String?
  objective       String
  /// cápsula de delegación (≤ ~6k tokens): objective, why, constraints,
  /// knownFacts, expectedOutput — nunca el historial completo
  capsule         Json
  expectedOutput  Json?
  allowedTools    String[]  @default([])
  forbiddenTools  String[]  @default([])
  /// taskIds de los que depende (DAG)
  dependsOn       String[]  @default([])
  budgetUsd       Decimal?  @db.Decimal(10, 2)
  deadlineAt      DateTime?
  /// pending | ready | running | done | failed | cancelled | awaiting_approval
  status          String    @default("pending")
  result          Json?
  /// evidencias: fuentes, artifacts, refs de tool calls
  evidence        Json?
  error           String?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  @@index([rootRunId, status])
  @@index([status])
  @@index([assignedAgentId])
}

/// Timeline append-only por run: run.created, model.started/completed,
/// tool.started/completed, task.*, approval.*, workspace.*, run.completed.
model AgentEvent {
  id        String   @id @default(cuid())
  runId     String
  type      String
  /// para anidar spans dentro del run
  spanId    String?
  payload   Json?
  createdAt DateTime @default(now())

  @@index([runId, createdAt])
  @@index([type, createdAt])
}

/// Bus inter-agente: reportes de subagentes al principal (y al usuario).
/// "Mensajes de Account Manager y Chief" en el chat del principal.
model AgentMessage {
  id             String    @id @default(cuid())
  tenantId       String    @default("unik")
  fromAgentId    String
  /// null → llega al usuario a través del principal
  toAgentId      String?
  /// report | request | finding | handoff
  kind           String    @default("report")
  /// 1-2 líneas para el feed
  summary        String
  payload        Json?
  /// conversación donde se muestra (la del principal por default)
  conversationId String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([tenantId, toAgentId, readAt])
  @@index([conversationId, createdAt])
}

/// Computadora lógica de un agente o workspace compartido. Debajo puede ser
/// Daytona dedicada, la venue central del usuario o una ephemeral por run.
model Workspace {
  id             String   @id @default(cuid())
  tenantId       String   @default("unik")
  /// null = compartido del usuario (venue central)
  agentId        String?
  userId         String
  /// shared | dedicated | ephemeral
  kind           String   @default("shared")
  venueSessionId String?
  /// active | idle | released
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId, agentId])
  @@index([userId, kind, status])
}

/// Liga una ejecución con su workspace — el sandbox pertenece al run,
/// no "al usuario" a secas.
model WorkspaceLease {
  id             String    @id @default(cuid())
  workspaceId    String
  agentRunId     String
  venueSessionId String?
  acquiredAt     DateTime  @default(now())
  releasedAt     DateTime?

  @@index([agentRunId])
  @@index([workspaceId, releasedAt])
}

/// Disparador always-on: arranca AgentRuns/misiones por tiempo, evento,
/// condición, webhook o mensaje — la IA entra solo cuando agrega valor.
model Trigger {
  id          String    @id @default(cuid())
  tenantId    String    @default("unik")
  agentId     String
  /// time | event | condition | webhook | message | entity_change | manual
  type        String
  /// time: {cron, tz} · event/entity_change: {entity, filter} ·
  /// condition: {source, query, threshold} · webhook: {secret}
  spec        Json
  /// {kind: 'run'|'mission', goal, capsule?}
  action      Json
  enabled     Boolean   @default(true)
  nextRunAt   DateTime?
  lastFiredAt DateTime?
  /// idempotencia entre ticks/redeploys
  dedupeKey   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([enabled, nextRunAt])
  @@index([tenantId, agentId])
}
