{
  "name": "unik-system",
  "version": "0.1.0",
  "private": true,
  "description": "UNIK System - Modular Monolith ERP Skeleton",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE prisma validate",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:components": "vitest",
    "test:a11y": "vitest --project a11y",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "playwright:install": "playwright install chromium",
    "ui:check": "npm run typecheck && npm run lint && npm run format:check && npm run build && npm run build-storybook"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^6.0.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.10",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.39.0",
    "motion": "^13.1.1",
    "next": "^15.0.0",
    "next-themes": "^0.4.6",
    "openai": "7.8.0",
    "pdfkit": "^0.20.2",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.87.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-mcp": "latest",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/nextjs-vite": "^10.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.0.0",
    "playwright": "latest",
    "prettier": "^3.3.0",
    "prisma": "^6.0.0",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "latest",
    "vitest": "latest"
  }
}
