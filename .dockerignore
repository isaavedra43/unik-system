# Build context hygiene — the Docker image builds from the git checkout on
# Railway, but a local build would otherwise upload all of this too.

# VCS / editor / agent metadata
.git
.github
.claude
.vscode
.idea
.editorconfig
.nvmrc

# Dependencies and build output (rebuilt inside the image)
node_modules
.next
tsconfig.tsbuildinfo

# Local data / env — Railway injects real env vars; disk storage is recreated
.env
.env.*
!.env.example
data
coverage
test-results
playwright-report
storybook-static

# Not needed to build or run the web app
services
docs
tests
.storybook
*.md
playwright.config.ts
vitest.config.ts
vitest.shims.d.ts
components.json

# Docker files themselves
Dockerfile
.dockerignore
docker-compose*.yml
