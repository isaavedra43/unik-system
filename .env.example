# Database
DATABASE_URL=

# Application
APP_URL=
NODE_ENV=

# Zoho (placeholders - integration not implemented yet)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=
ZOHO_API_BASE_URL=https://www.zohoapis.com
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com
ZOHO_WEBHOOK_SECRET=

# Internal API security
UNIK_INTERNAL_API_KEY=

# Zoho Sales Orders internal scheduler (opt-in; anything other than "true" is disabled)
ZOHO_SALES_ORDERS_SCHEDULER_ENABLED=false

# Demo-data seed endpoint (development only — server-side flag, keep false/absent in prod)
ALLOW_DEMO_SEED=false

# ============================================================
# AI Assistant — Provider configuration
# ============================================================
# Active provider. One of: openai | anthropic | gemini | local
# Default: openai
AI_PROVIDER=openai

# ------------------------------------------------------------
# OpenAI (ChatGPT API) — ACTIVE provider by default
# ------------------------------------------------------------
# Get your API key at: https://platform.openai.com/api-keys
# OpenAI does NOT train on API data by default since March 2023.
# See: https://openai.com/business-data/
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_FALLBACK_MODEL=gpt-4o-mini
# Optional: custom endpoint (e.g. proxy). Leave empty for https://api.openai.com
OPENAI_ENDPOINT=

# ------------------------------------------------------------
# Anthropic (Claude) — FUTURE (stub, not implemented yet)
# ------------------------------------------------------------
# Get your API key at: https://console.anthropic.com/
# Anthropic does NOT train on commercial API data by default.
# Zero Data Retention (ZDR) available on request.
# See: https://privacy.claude.com/en/articles/7996868
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_FALLBACK_MODEL=claude-haiku-4-5
ANTHROPIC_ENDPOINT=

# ------------------------------------------------------------
# Google Gemini — FUTURE (stub, not implemented yet)
# ------------------------------------------------------------
# Get your API key at: https://aistudio.google.com/apikey
# Google does NOT train on Gemini API data by default.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash-lite
GEMINI_ENDPOINT=

# ------------------------------------------------------------
# Local (Ollama / LM Studio) — FUTURE (stub, not implemented yet)
# ------------------------------------------------------------
# 100% local — no data leaves your machine.
# Install Ollama: https://ollama.com
# Start a model:  ollama run llama3.1
# Ollama exposes an OpenAI-compatible endpoint at http://localhost:11434/v1
OLLAMA_ENDPOINT=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1
OLLAMA_FALLBACK_MODEL=llama3.1
# Ollama doesn't require a real key, but the SDK needs a non-empty value
OLLAMA_API_KEY=ollama

# Canopy Wave (API compatible con OpenAI; https://canopywave.com/docs/get-started/openai-compatible)
# Sirve para On-Demand y para el plan Unlimited (Monthly Subscription). También se configura en Admin → Asistente IA.
CANOPYWAVE_API_KEY=
CANOPYWAVE_MODEL=moonshotai/kimi-k2.6
CANOPYWAVE_FALLBACK_MODEL=minimax/minimax-m3
# Vacío = https://inference.canopywave.io/v1
CANOPYWAVE_ENDPOINT=

# OpenRouter (https://openrouter.ai) — acceso a cientos de modelos con una key.
# Requerido para las decisiones Jev (typesafe/jev-1.13). También en Admin → Asistente IA.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODEL=
# Vacío = https://openrouter.ai/api/v1
OPENROUTER_ENDPOINT=

# ============================================================
# Agentes — internet y computadora virtual
# ============================================================
# Proveedor de búsqueda web (web_search). También en Admin → Asistente IA → Internet y Agentes.
TAVILY_API_KEY=
# Daytona — computadora virtual desechable para browser/exec de agentes.
# Funciona con la imagen default de Daytona: el sandbox se auto-aprovisiona
# (playwright-core + chromium) en el primer uso. Si compilas un snapshot
# propio con todo preinstalado, configúralo en Admin → venueImage.
DAYTONA_API_KEY=
DAYTONA_API_URL=
DAYTONA_TARGET=
# Kill-switch global de venues (además de venueEnabled en Admin).
UNIK_VENUE_ENABLED=true
# Modelo para computer use (turnos que operan la computadora virtual: navegar,
# clic, escribir, leer pantallas). Vacío = google/gemini-2.5-flash vía OpenRouter
# si OPENROUTER_API_KEY existe (rápido + barato + visión + tools); si no, el
# modelo de rutina. También editable en Admin → Asistente → Reparto de modelos.
UNIK_COMPUTER_MODEL=

# ============================================================
# Object storage — Cloudflare R2 (private buckets, S3 API)
# ============================================================
# Driver: r2 | disk. Empty = r2 when R2_* credentials exist, otherwise disk.
# The disk driver is for development and reading legacy files only: in
# production files must live in R2 (Railway disks are ephemeral).
STORAGE_DRIVER=
# Local directory for the disk driver (development).
STORAGE_DISK_ROOT=data/object-storage
# HMAC secret for local upload authorizations (falls back to UNIK_INTERNAL_API_KEY).
STORAGE_SIGNING_SECRET=
# R2 account + API token with Object Read & Write on the three buckets below.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_FORCE_PATH_STYLE=false
# Bucket names (all PRIVATE — no public domain, no r2.dev access).
R2_BUCKET_FILES=unik-files-prod
R2_BUCKET_RECORDINGS=unik-recordings-prod
R2_BUCKET_QUARANTINE=unik-quarantine-prod
# Backup: SEPARATE account/token. Production credentials must not be able to
# delete this bucket; give this token write access only.
R2_BACKUP_ACCOUNT_ID=
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=
R2_BACKUP_ENDPOINT=
R2_BACKUP_BUCKET=unik-backup-prod
# Background job worker (validation, cleanup, backups). "false" disables it in this process.
UNIK_JOB_WORKER_ENABLED=true

# ============================================================
# UNIVERSO — Agent Runtime V2 (multi-agente: principal + especialistas +
# subagentes delegados, routing envelope JEV, triggers always-on).
# "true" = los turnos del chat corren por executeAgentTurn (identidad de
# agente + routing). Sin él, el asistente actual corre byte a byte igual.
# ============================================================
UNIK_AGENT_RUNTIME_V2=false

# ============================================================
# Secrets for extension connections (AES-256-GCM master key, outside PostgreSQL)
# ============================================================
# openssl rand -base64 32
UNIK_SECRETS_MASTER_KEY=
UNIK_SECRETS_KEY_ID=k1
# Only during a rotation: previous key + id
UNIK_SECRETS_MASTER_KEY_PREVIOUS=
UNIK_SECRETS_KEY_ID_PREVIOUS=
# Public base URL (OAuth callbacks, webhooks, signed links)
APP_URL=

# ============================================================
# Communications — Twilio (WhatsApp/SMS/voice) and Telegram
# ============================================================
# Fallback credentials when a CommAccount has no encrypted connection. Prefer
# storing them as a team connection of the extension "comm.twilio".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Used to validate Twilio webhook signatures (X-Twilio-Signature)
TWILIO_WEBHOOK_BASE_URL=
# Telegram bot token fallback (prefer an encrypted connection)
TELEGRAM_BOT_TOKEN=
# Zoho Books (cotizaciones / estimates). Reuses the ZOHO_* OAuth client + refresh token.
# The refresh token MUST be minted with these scopes in addition to the Inventory ones:
#   ZohoBooks.estimates.ALL,ZohoBooks.contacts.READ,ZohoBooks.items.READ,ZohoBooks.settings.READ
# Leave ZOHO_BOOKS_ORGANIZATION_ID empty when Books and Inventory share the same organization.
ZOHO_BOOKS_ORGANIZATION_ID=
# true → quotes are created/edited locally without calling Zoho (UI testing before credentials).
# false → real Zoho Books writes (production).
ZOHO_BOOKS_MOCK=true

# ============================================================
# Voice — LiveKit (rooms, egress to R2, SIP bridge with Twilio)
# ============================================================
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# SIP trunk id configured in LiveKit for Twilio inbound/outbound
LIVEKIT_SIP_TRUNK_ID=
# Voice AI provider (STT/TTS) reuses the assistant provider configuration.
# LiveKit SIP domain (inbound TwiML <Dial><Sip>) and mock webhook secret for local tests
LIVEKIT_SIP_DOMAIN=
LIVEKIT_MOCK_WEBHOOK_SECRET=
# Agente de voz (services/voice-agent). Nombre con el que el worker se registra en LiveKit
# (despacho explícito), nombre de la persona con la que se presenta, modelo y voz de OpenAI Realtime.
VOICE_AGENT_NAME=unik-voice
VOICE_AGENT_PERSONA_NAME=Valeria
VOICE_AGENT_MODEL=gpt-realtime
VOICE_AGENT_VOICE=marin
# Optional write-only R2 token used ONLY by LiveKit egress (recordings bucket)
R2_EGRESS_ACCESS_KEY_ID=
R2_EGRESS_SECRET_ACCESS_KEY=

# --- MCP (Model Context Protocol) ---------------------------------------------
# UNIK como SERVIDOR MCP: expone todas las tools del asistente en POST /api/mcp.
# Genera una clave larga (openssl rand -hex 32). Sin clave el endpoint responde 503.
UNIK_MCP_API_KEY=
# Usuario de UNIK con cuyos permisos actúan los agentes externos (obligatorio).
UNIK_MCP_ACTOR_USERNAME=
# true → permite elegir el usuario con la cabecera X-UNIK-User (solo para integraciones de confianza).
UNIK_MCP_ALLOW_USER_HEADER=false
# UNIK como CLIENTE MCP (Admin → Extensiones → MCP): en desarrollo permite servidores http://localhost.
UNIK_MCP_ALLOW_INSECURE_LOCAL=false

# --- Composio (apps externas del asistente: Gmail, Calendar, Slack, GitHub, Notion…) ---
# API key del proyecto en Composio (dashboard.composio.dev → Settings → API keys). Solo en el servidor
# (Railway → Variables); nunca en el navegador ni en la base de datos. Sin ella el asistente no ofrece
# estas herramientas. Cada persona conecta su propia cuenta; los tokens los guarda Composio.
COMPOSIO_API_KEY=
# Opcional: solo si usas un despliegue propio de Composio.
COMPOSIO_BASE_URL=

# --- IA: enlaces compartibles y documentos ------------------------------------
# APP_URL (arriba) es OBLIGATORIO en producción: la IA construye con él los enlaces de reportes,
# cotizaciones y llamadas que envía a clientes y compañeros (nunca inventa dominios).
# Secreto HMAC para los enlaces públicos firmados de reportes (/api/files/shared/<token>).
# Si se omite se usa UNIK_SECRETS_MASTER_KEY. Cambiarlo invalida los enlaces ya compartidos.
UNIK_SHARE_LINK_SECRET=

# --- IA: capa de inteligencia --------------------------------------------------
# La búsqueda semántica de la biblioteca (embeddings), la transcripción de audios adjuntos (Whisper)
# y el OCR de PDF escaneados usan la clave de OpenAI (OPENAI_API_KEY o Admin → Asistente IA).
# Sin clave todo sigue funcionando en modo léxico / sin transcripción. Routing, caché, juez y
# tools por turno se configuran en Admin → Asistente IA → Configuración (no requieren variables).

# ============================================================
# Notificaciones push (Web Push / VAPID) — iPhone (app instalada) y Android
# ============================================================
# Genera el par una sola vez con: npx web-push generate-vapid-keys
# Sin estas llaves el push se desactiva (las notificaciones en la app siguen).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto para los servicios push (mailto: o https:). Si se omite usa APP_URL.
VAPID_SUBJECT=mailto:soporte@example.com
# Segundos mínimos que debe durar un turno del asistente para avisar "la IA terminó" (default 20).
AI_NOTIFY_MIN_SECONDS=20
